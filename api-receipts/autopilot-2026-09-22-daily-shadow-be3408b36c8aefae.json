28\u064a\u0629 \u0631\u063a\u0645 \u0645\u0648\u0633\u0645 \u0645\u0646 \u062f\u0648\u0646 \u0623\u0644\u0642\u0627\u0628 \u0645\u0639 \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a \u0648\u062e\u0631\u0648\u062c \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0645\u0646 \u0627\u0644\u062f\u0648\u0631 \u0646\u0635\u0641 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0627\u0644\u062e\u0645\u064a\u0633\u060c \u0639\u0644\u0649\n\u064a\u0643\u0648\u0646 \u0639\u0627\u0645\u0627\u064b \u062c\u064a\u062f\u0627\u064b \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u064a\u060c \u0648\u0623\u0646\u0627 \u0623\u0634\u0639\u0631 \u0628\u0630\u0644\u0643\u00bb. \u0648\u0623\u0646\u0647\u0649 \u0645\u0628\u0627\u0628\u064a \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0645\u0627\u0636\u064a \u0647\u062f\u0627\u0641\u0627\u064b \u0644\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a (25 \u0647\u062f\u0641\u0627\u064b)\u060c \u0648\u0644\u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0623\u0648\u0631\u0648\u0628\u0627 (15 \u0647\u062f\u0641\u0627\u064b)\u060c\n\u0648\u0623\u0635\u0628\u062d \u0647\u0630\u0627 \u0627\u0644\u0635\u064a\u0641\u060c \u0628\u0641\u0636\u0644 10 \u0623\u0647\u062f\u0627\u0641 \u0625\u0636\u0627\u0641\u064a\u0629\u060c \u0627\u0644\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a \u0644\u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 (22 \u0647\u062f\u0641\u0627\u064b \u0641\u064a 3 \u0646\u0633\u062e). \u0648\u0633\u064a\u062a\u0646\u0627\u0641\u0633 \u0645\u0628\u0627\u0628\u064a \u0639\u0644\u0649 \u0648\u062c\u0647 \u0627\u0644\u062e\u0635\u0648\u0635 \u0645\u0639\n\u0632\u0645\u064a\u0644\u0647 \u0641\u064a \u0645\u0646\u062a\u062e\u0628 \u00ab\u0627\u0644\u0632\u0631\u0642\u00bb \u0639\u062b\u0645\u0627\u0646 