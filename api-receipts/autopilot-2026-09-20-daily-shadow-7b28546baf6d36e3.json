r": "standard", "inference_geo": "global"}, "cost_micro_usd": 72170, "stop_reason": "end_turn", "content_types": ["thinking", "text"], "response_format": "plain"}], "candidate": {"id": "76825ce262b1c1ea", "title": "\"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\" \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u062a\u0641\u062a\u062a\u062d\u0627\u0646 \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\"", "url": "https://www.alyaum.com/articles/6683428/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%A8%D8%AD%D8%B1-%D8%A7%D9%84%D8%A3%D8%AD%D9%85%D8%B1-%D8%A7%D9%84%D8%AF%D9%88%D9%84%D9%8A%D8%A9-%D9%88%D9%85%D8%AC%D9%85%D9%88%D8%B9%D8%A9-%D8%A7%D9%84%D8%AF%D9%83%D8%AA%D9%88%D8%B1-%D8%B3%D9%84%D9%8A%D9%85%D8%A7%D9%86-%D8%A7%D9%84%D8%AD%D8%A8%D9%8A%D8%A8-%D9%84%D9%84%D8%AE%D8%AF%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%A9-%D8%AA%D9%81%D8%AA%D8%AA%D8%AD%D8%A7%D9%86-%D9%85%D8%B3%D8%AA%D8%B4%D9%81%D9%89-%D8%A7%D9%84%D8%A8%D8%AD%D8%B1-%D8%A7%D9%84%D8%A3%D8%AD%D9%85%D8%B1", "summary": "\u0627\u0641\u062a\u062a\u062d\u062a \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\"\u060c \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0637\u0648\u0651\u0631\u0629 \u0644\u0623\u0643\u062b\u0631 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629 \u0637\u0645\u0648\u062d\u0627\u064b \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629\u060c \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\" \u0641\u064a \u0648\u062c\u0647\u0629 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\" \u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633 17 \u0633\u0628\u062a\u0645\u0628\u0631 2026\u060c \u0628\u0631\u0639\u0627\u064a\u0629 \u0648\u062d\u0636\u0648\u0631 \u0648\u0632\u064a\u0631 \u0627\u0644\u0635\u062d\u0629 \u0641\u0647\u062f \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u062c\u0644\u0627\u062c\u0644\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0645\u0624\u0633\u0633 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0631\u0626\u064a\u0633 \u0645\u062c\u0644\u0633 \u0625\u062f\u0627\u0631\u062a\u0647\u0627 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0644\u062d\u0628\u064a\u0628\u060c \u0648\u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\" \u062c\u0648\u0646 \u0628\u0627\u063a\u0627\u0646\u0648\u060c \u0648\u0644\u0641\u064a\u0641 \u0645\u0646 \u0643\u0628\u0627\u0631 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0648\u0627\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0627\u0644\u0628\u0627\u0631\u0632\u0629. \u0648\u064a\u0645\u062b\u0644 \u0627\u0644\u0627\u0641\u062a\u062a\u0627\u062d \u0645\u062d\u0637\u0629 \u0628\u0627\u0631\u0632\u0629 \u0641\u064a \u0645\u0633\u064a\u0631\u0629 \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0648\u062c\u0647\u0629\u060c \u0648\u064a\u0639\u0632\u0632 \u0625\u062a\u0627\u062d\u0629 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0648\u0642\u0627\u0637\u0646\u064a \u0627\u0644\u0648\u062c\u0647\u0629 \u0648\u0636\u064a\u0648\u0641\u0647\u0627 \u0648\u0623\u0647\u0627\u0644\u064a \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631. \u0648\u064a\u0623\u062a\u064a \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u062b\u0645\u0631\u0629 \u0634\u0631\u0627\u0643\u0629 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0628\u064a\u0646 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0646\u060c \u062a\u062a\u0648\u0644\u0649 \u0628\u0645\u0648\u062c\u0628\u0647\u0627 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0648\u0647\u064a \u0645\u0646 \u0623\u0628\u0631\u0632 \u0645\u0642\u062f\u0645\u064a \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0641\u0649 \u0648\u062a\u0634\u063a\u064a\u0644\u0647 \u0628\u0643\u0648\u0627\u062f\u0631 \u0637\u0628\u064a\u0629 \u0645\u062a\u0645\u0631\u0633\u0629 \u0648\u062a\u0642\u0646\u064a\u0627\u062a \u062d\u062f\u064a\u062b\u0629\u060c \u0641\u064a \u062e\u0637\u0648\u0629 \u062a\u0624\u0643\u062f \u0627\u0644\u062a\u0632\u0627\u0645 \u0627\u0644\u0634\u0631\u064a\u0643\u064a\u0646 \u0628\u062a\u0637\u0648\u064a\u0631 \u0648\u062c\u0647\u0627\u062a \u0622\u0645\u0646\u0629 \u0648\u0645\u0631\u0646\u0629 \u0648\u0645\u062a\u0643\u0627\u0645\u0644\u0629. \u0648\u062a\u062c\u0645\u0639 \u0627\u0644\u0634\u0631\u0627\u0643\u0629 \u0628\u064a\u0646 \u062e\u0628\u0631\u0629 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\" \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0648\u062e\u0628\u0631\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0641\u064a \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u0648\u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629. \u0648\u0642\u0627\u0644 \u062c\u0648\u0646 \u0628\u0627\u063a\u0627\u0646\u0648\u060c \u0627\u0644\u0631\u0626", "published_at": "2026-09-20T10:42:00+03:00", "editorial": {"id": "76825ce262b1c1ea", "source_title": "\"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\" \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u062a\u0641\u062a\u062a\u062d\u0627\u0646 \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\"", "subject_evidence": [{"subject": "Red Sea Global", "mention": "\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629", "quote": "\u0627\u0641\u062a\u062a\u062d\u062a \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\"\u060c \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0637\u0648\u0651\u0631\u0629 \u0644\u0623\u0643\u062b\u0631 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629 \u0637\u0645\u0648\u062d\u0627\u064b \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629\u060c \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\""}, {"subject": "Sulaiman Al Habib Medical Group", "mention": "\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629", "quote": "\u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629\u060c \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\" \u0641\u064a \u0648\u062c\u0647\u0629 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\""}], "why_saudi": "\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0645\u0646 \u0623\u0647\u0645 \u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0627\u0641\u062a\u062a\u0627\u062d \u0645\u0633\u062a\u0634\u0641\u0649 \u0641\u064a\u0647 \u064a\u0647\u0645 \u0643\u0644 \u0645\u0646 \u064a\u062e\u0637\u0637 \u064a\u0632\u0648\u0631 \u0627\u0644\u0648\u062c\u0647\u0629 \u0623\u0648 \u064a\u0634\u062a\u063a\u0644 \u0641\u064a\u0647\u0627.", "why_now": "\u0627\u0641\u062a\u062a\u0627\u062d \u0645\u0633\u062a\u0634\u0641\u0649 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0628\u0634\u0631\u0627\u0643\u0629 \u0628\u064a\u0646 \u0634\u0631\u0643\u0629 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628\u060c \u0628\u062d\u0636\u0648\u0631 \u0648\u0632\u064a\u0631 \u0627\u0644\u0635\u062d\u0629.", "angle": "\u0646\u0634\u0631\u062d \u0645\u064a\u0646 \u0647\u064a \u0634\u0631\u0643\u0629 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628\u060c \u0648\u0644\u064a\u0634 \u0648\u062c\u0648\u062f \u0645\u0633\u062a\u0634\u0641\u0649 \u0645\u062a\u0637\u0648\u0631 \u0641\u064a \u0648\u062c\u0647\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0643\u0628\u064a\u0631\u0629 \u0646\u0642\u0637\u0629 \u0645\u0647\u0645\u0629 \u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0645\u0634\u0631\u0648\u0639.", "share_reason": "\u062e\u0628\u0631 \u064a\u0647\u0645 \u0643\u0644 \u0645\u0646 \u064a\u062a\u0627\u0628\u0639 \u062a\u0637\u0648\u0631 \u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0648\u064a\u062a\u0633\u0627\u0621\u0644 \u0634\u0643\u0644 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u064a\u0647.", "research_query": "Red Sea Global", "subjects": ["Red Sea Global", "Sulaiman Al Habib Medical Group"]}}, "reason": "editor_subject_mention_not_grounded", "candidate_id": "76825ce262b1c1ea", "source_title": "\"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u062f\u0648\u0644\u064a\u0629\" \u0648\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u062d\u0628\u064a\u0628 \u0644\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 \u062a\u0641\u062a\u062a\u062d\u0627\u0646 \u0645\u0633\u062a\u0634\u0641\u0649 \"\u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631\""}