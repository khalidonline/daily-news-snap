 Yunzhi"}, "draft": {"title": "\u0645\u0643\u0639\u0628 \u0631\u0648\u0628\u064a\u0643: \u0644\u063a\u0632 \u0635\u0627\u0631 \u0631\u064a\u0627\u0636\u0629 \u0639\u0627\u0644\u0645\u064a\u0629\u060c \u0648\u0637\u0641\u0644\u0629 \u0639\u0645\u0631\u0647\u0627 \u0666 \u0633\u0646\u0648\u0627\u062a \u062a\u0643\u0633\u0631 \u0631\u0642\u0645\u0647", "cards": [{"kind": "info", "title": "\u0645\u0643\u0639\u0628 \u0631\u0648\u0628\u064a\u0643 \u0645\u0627 \u0627\u0646\u0635\u0646\u0639 \u0644\u0639\u0628\u0629\u2026 \u0627\u0646\u0635\u0646\u0639 \u0644\u062d\u0644 \u0645\u0634\u0643\u0644\u0629 \u0647\u0646\u062f\u0633\u064a\u0629", "body": "\u0627\u0644\u0645\u0643\u0639\u0628 \u0627\u062e\u062a\u0631\u0639\u0647 \u0633\u0646\u0629 1974 \u0627\u0644\u0646\u062d\u0627\u062a \u0648\u0623\u0633\u062a\u0627\u0630 \u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u062c\u0631\u064a \u0625\u0631\u0646\u0648 \u0631\u0648\u0628\u064a\u0643. \u0643\u0627\u0646 \u064a\u0628\u063a\u0649 \u064a\u062c\u0627\u0648\u0628 \u0639\u0644\u0649 \u0633\u0624\u0627\u0644 \u0647\u0646\u062f\u0633\u064a: \u0643\u064a\u0641 \u062a\u062a\u062d\u0631\u0643 \u0623\u062c\u0632\u0627\u0621 \u0635\u063a\u064a\u0631\u0629 \u0643\u062b\u064a\u0631\u0629 \u0643\u0644 \u0648\u062d\u062f\u0629 \u0628\u0627\u0633\u062a\u0642\u0644\u0627\u0644\u060c \u0648\u064a\u0638\u0644 \u0627\u0644\u062c\u0633\u0645 \u0643\u0644\u0647 \u0645\u062a\u0631\u0627\u0628\u0637 \u0648\u0645\u0627 \u064a\u062a\u0641\u0643\u0643\u061f \u0648\u0645\u0627 \u0627\u0646\u062a\u0628\u0647 \u0625\u0646\u0647 \u0633\u0648\u0651\u0649 \u0644\u063a\u0632\u064b\u0627 \u0625\u0644\u0627 \u0628\u0639\u062f \u0645\u0627 \u062e\u0631\u0628\u0637 \u0645\u0643\u0639\u0628\u0647 \u0648\u062d\u0627\u0648\u0644 \u064a\u0631\u062c\u0639\u0647 \u0644\u0648\u0636\u0639\u0647 \u0627\u0644\u0623\u0648\u0644.", "punch": "\u0648\u0628\u062d\u0633\u0628 \u0631\u0648\u0627\u064a\u0627\u