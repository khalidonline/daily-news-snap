4a\u0631\u0627\u064b \u0628\u0645\u0631\u0648\u0631 100 \u0639\u0627\u0645 \u0639\u0644\u0649 \u062f\u062e\u0648\u0644\u0647\u0627 \u0639\u0627\u0644\u0645 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0628\u0623\u0648\u0644 \u0639\u0631\u0636 \u0623\u0632\u064a\u0627\u0621 \u0644\u0647\u0627 \u0641\u064a \u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0648\u0636\u0629 \u0628\u0644\u0646\u062f\u0646.", "claim_ids": ["c4", "c6"], "image_query": "Marks Spencer cafe"}]}, "feedback": "editorial_review_rejected: \u0631\u0641\u0636 \u0644\u0633\u0628\u0628\u064a\u0646.\n\n1) \u062e\u0637\u0623 \u0648\u0627\u0642\u0639\u064a \u0641\u064a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0663 \u0645\u0646 \u0663: \u062a\u0642\u0648\u0644 \u0625\u0646 \u0627\u0644\u0639\u0631\u0636 \u062c\u0627\u0621 \u00ab\u0627\u062d\u062a\u0641\u0627\u0644\u0627\u064b \u0628\u0645\u0631\u0648\u0631 100 \u0639\u0627\u0645 \u0639\u0644\u0649 \u062a\u0623\u0633\u064a\u0633\u0647\u0627\u00bb. \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0635\u0644\u064a \u0648\u0627\u0644\u0645\u0644\u062e\u0635 \u064a\u0642\u0648\u0644\u0627\u0646 \u0625\u0646 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0644 \u0628\u0645\u0631\u0648\u0631 100 \u0639\u0627\u0645 \u0639\u0644\u0649 \u0625\u0646\u062a\u0627\u062c \u0627\u0644\u0645\u0644\u0627\u0628\u0633 (celebrating 100 years of producing clothing)\u060c \u0648\u0627\u0644\u0634\u0631\u0643\u0629 \u0646\u0641\u0633\u0647\u0627 \u062a\u0623\u0633\u0633\u062a 1884 \u062d\u0633\u0628 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0645\u0648\u0633\u0648\u0639\u064a\u060c \u0623\u064a \u0623\u0643\u062b\u0631 \u0645\u0646 140 \u0633\u0646\u0629. \u0644\u0627\u0632\u0645 \u062a\u064f\u0635\u062d\u062d \u0625\u0644\u0649 \u00ab100 \u0639\u0627\u0645 \u0639\u0644\u0649 \u062f\u062e\u0648\u0644\u0647\u0627 \u0645\u062c\u0627\u0644 \u0627\u0644\u0645\u0644\u0627\u0628\u0633\u00bb \u0623\u0648 \u062a\u064f\u062d\u0630\u0641. \u0628\u0627\u0642\u064a \u0627\u0644\u0648\u0642\u0627\u0626\u0639 \u0645\u0637\u0627\u0628\u0642\u0629 \u0644\u0644\u0645\u0635\u062f\u0631: \u0633\u0645\u0639\u0629 \u00abfusty\u00bb \u0639\u0646\u062f \u0627\u0644\u0634\u0628\u0627\u0628\u060c \u0627\u0644\u0634\u0647\u0631\u0629 \u0628\u0627\u0644\u0623\u0643\u0644 \u0648\u0627\u0644\u062d\u0644\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0645\u0644\u0627\u0628\u0633\u060c \u0627\u0644\u062a\u0639\u062b\u0631 \u0632\u0645\u0646 \u0643\u0648\u0631\u0648\u0646\u0627 \u062b\u0645 \u0646\u0645\u0648 \u0627\u0644\u062d\u0635\u0629 \u0627\u0644\u0633\u0648\u0642\u064a\u0629 2022\u20132025\u060c \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0641\u064a \u0627\u0644\u0645\u062a\u0627\u062c\u0631 \u0628\u0645\u0641\u0647\u0648\u0645 accessible luxury\u060c \u0639\u0631\u0636 \u0627\u0644\u0623\u0632\u064a\u0627\u0621 \u0641\u064a pit-lane \u0628\u062c\u0627\u0626\u0632\u0629 \u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0627 \u0627\u0644\u0643\u0628\u0631\u0649 \u0644\u0644\u0641\u0648\u0631\u0645\u0648\u0644\u0627 1\u060c \u0648\u062a\u0639\u0627\u0648\u0646 Aries. \u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0633\u0644\u064a\u0645: \u0645\u0642\u0627\u0644 BBC \u0628\u062a\u0627\u0631\u064a\u062e 19 \u0633\u0628\u062a\u0645\u0628\u0631 2026 \u064a\u063a\u0637\u064a \u0623\u0648\u0644 \u0639\u0631\u0636 \u0644\u0644\u0645\u0627\u0631\u0643\u0629 \u0641\u064a \u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0648\u0636\u0629 \u0628\u0644\u0646\u062f\u0646\u060c \u0648\u0647\u0648 \u062a\u0637\u0648\u0631 \u062d\u0627\u0644\u064a \u0641\u0639\u0644\u064a \u0644\u0627 \u0645\u0642\u0627\u0644 \u062f\u0627\u0626\u0645 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629.\n\n2) \u062a\u0646\u0648\u0651\u0639 \u0628\u0635\u0631\u064a \u0636\u0639\u064a\u0641. \u0645\u0627 \u0623\u0631\u0627\u0647 \u0641\u0639\u0644\u064a\u0627\u064b \u0641\u064a \u0627\u0644\u0635\u0648\u0631: (\u0661) \u0634\u0627\u0631\u0639 \u062a\u0633\u0648\u0642 \u0645\u0634\u0645\u0633 \u0628\u0623\u0631\u0635\u0641\u0629 \u0642\u0631\u0645\u064a\u062f\u064a\u0629 \u0648\u0623\u0639\u0644\u0627\u0645 \u0645\u062b\u0644\u062b\u0629 \u0648\u0648\u0627\u062c\u0647\u0629 \u0645\u0643\u062a\u0648\u0628 \u0639\u0644\u064a\u0647\u0627 MARKS & SPENCER\u061b (\u0662) \u0644\u0642\u0637\u0629 \u0645\u0642\u0631\u0651\u0628\u0629 \u0644\u0644\u0648\u062d\u0629 \u062d\u062c\u0631\u064a\u0629 \u0628\u064a\u0636\u0627\u0621 \u0639\u0644\u064a\u0647\u0627 \u0634\u0639\u0627\u0631 M&S \u0627\u0644\u062f\u0627\u0626\u0631\u064a\u061b (\u0663) \u062f\u0627\u062e\u0644 \u0645\u0642\u0647\u0649 M&S: \u0643\u0627\u0648\u0646\u062a\u0631 \u0648\u0642\u0648\u0627\u0626\u0645 \u0623\u0633\u0639\u0627\u0631 \u0645\u0639\u0644\u0651\u0642\u0629 \u0648\u0645\u0648\u0638\u0641\u0627\u0646 \u064a\u0639\u0645\u0644\u0627\u0646\u061b (\u0664) \u0648\u0627\u062c\u0647\u0629 \u0645\u0628\u0646\u0649 \u0645\u062a\u062c\u0631 Marks & Spencer \u0641\u064a \u062c\u0648 \u0631\u0645\u0627\u062f\u064a \u0645\u0639 \u0633\u064a\u0627\u0631\u0629 \u0641\u0627\u0646 \u0648\u0628\u0639\u0636 \u0627\u0644\u0645\u0627\u0631\u0629\u061b (\u0665) \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0628\u0628\u0627\u0646\u0631 \u0645\u0642\u0635\u0648\u0635 \u0645\u0646 \u0646\u0641\u0633 \u0635\u0648\u0631\u0629 \u0627\u0644\u0634\u0627\u0631\u0639\u060c \u0648\u0646\u0635\u0647\u0627 \u0648\u0627\u0636\u062d \u0648\u0645\u0637\u0627\u0628\u0642 (\u062a\u0631\u062e\u064a\u0635 CC BY 4.0 \u0644\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0641\u0642\u0637\u060c \u0648\u0627\u0644\u0628\u0642\u064a\u0629 CC0). \u062b\u0644\u0627\u062b \u0645\u0646 \u0623\u0631\u0628\u0639 \u0635\u0648\u0631 \u0647\u064a \u0648\u0627\u062c\u0647\u0627\u062a/\u0644\u0627\u0641\u062a\u0627\u062a \u0645\u062a\u062c\u0631 \u0645\u062a\u0634\u0627\u0628\u0647\u0629 \u0627\u0644\u0623\u062b\u0631\u060c \u0648\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0627\u0628\u0639\u0629 \u0639\u0646 \u0639\u0631\u0636 \u0627\u0644\u0623\u0632\u064a\u0627\u0621 \u0648\u0627\u0644\u062a\u0639\u0627\u0648\u0646\u0627\u062a \u0644\u0627 \u062a\u064f\u0638\u0647\u0631 \u0623\u064a \u0634\u064a\u0621 \u0645\u0646 \u0627\u0644\u0645\u0648\u0636\u0629 \u0623\u0648 \u0627\u0644\u0639\u0631\u0636\u060c \u0641\u0635\u0644\u062a\u0647\u0627 \u0628\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0636\u0639\u064a\u0641\u0629. \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0635\u0648\u0631\u0629 \u0630\u0627\u062a \u0635\u0644\u0629 \u0628\u0627\u0644\u0623\u0632\u064a\u0627\u0621/\u0627\u0644\u0639\u0631\u0636 \u0644\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\u060c \u0623\u0648 \u062a\u0642\u0644\u064a\u0644 \u0639\u062f\u062f \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0628\u062f\u0644 \u062a\u0643\u0631\u0627\u0631 \u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0648\u0627\u062c\u0647\u0629.\n\n\u0627\u0644\u0644\u063a\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 \u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0627\u0644\u062a\u0633\u0644\u0633\u0644 \u0645\u062a\u0631\u0627\u0628\u0637 (\u0633\u0645\u0639\u0629 \u0642\u062f\u064a\u0645\u0629 \u2190 \u062a\u0639\u062b\u0631 \u0643\u0648\u0631\u0648\u0646\u0627 \u2190 \u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u062c\u0631 \u2190 \u062e\u0637\u0648\u0627\u062a \u062c\u0631\u064a\u0626\u0629)\u060c \u0648\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u062a\u0634\u0631\u062d \u0627\u0644\u0645\u0627\u0631\u0643\u0629 \u0646\u0641\u0633\u0647\u0627 \u0644\u0627 \u0627\u0644\u062e\u0628\u0631. \u0639\u062f\u0651\u0627\u062f\u0627\u062a \u0627\u0644\u0642\u0635\u0629 \u00ab1 \u0645\u0646 3 / 2 \u0645\u0646 3 / 3 \u0645\u0646 3\u00bb \u0628\u062a\u0631\u062a\u064a\u0628 \u0642\u0631\u0627\u0621\u0629 \u0635\u062d\u064a\u062d."}