627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0645\u0627 \u0642\u0628\u0644 \u062a\u0623\u0633\u064a\u0633\u0647\u0627\u060c \u062c\u0645\u0639\u0647\u0627 \u0639\u0644\u0649 \u0645\u062f\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 45 \u0639\u0627\u0645\u064b\u0627. \u0648\u0648\u0635\u0641 \u0627\u0644\u0639\u0628\u0627\u062f\u064a \u0647\u0630\u0647 \u0627\u0644\u0647\u0648\u0627\u064a\u0629 \u0628\u0640 \"\u0647\u0648\u0627\u064a\u0629 \u0627\u0644\u0645\u0644\u0648\u0643\"\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0625\u0644\u0649 \u0623\u0646 \u0623\u0648\u0644 \u0645\u0646 \u0628\u062f\u0623\u0647\u0627 \u0648\u0627\u0647\u062a\u0645 \u0628\u0647\u0627 \u0628\u0634\u0643\u0644 \u0648\u0627\u0633\u0639 \u0647\u0648 \u0627\u0644\u0645\u0644\u0643 \u0641\u0627\u0631\u0648\u0642\u060c \u0645\u0644\u0643 \u0645\u0635\u0631 \u0627\u0644\u0623\u0633\u0628\u0642. \u0648\u0623\u0643\u062f \u0627\u0644\u0639\u0628\u0627\u062f\u064a \u0623\u0646 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u062a\u062d\u0645\u0644 \u0642\u064a\u0645\u0629 \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0648\u062b\u0642\u0627\u0641\u064a\u0629 \u0639\u0627\u0644\u064a\u0629\u060c \u0643\u0648\u0646\u0647\u0627 \u062a\u0639\u0643\u0633 \u0627\u0646\u0637\u0628\u0627\u0639\u064b\u0627 \u0639\u0645\u064a\u0642\u064b\u0627 \u0639\u0646 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062f\u0648\u0644 \u0648\u0627\u0644\u0623\u0642\u0627\u0644\u064a\u0645 \u0648\u062d\u062a\u0649 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u062a\u064a \u0635\u062f\u0631\u062a \u0641\u064a\u0647\u0627. \u0648\u0623\u0636\u0627\u0641 \u0627\u0644\u0639\u0628\u0627\u062f\u064a \u0623\u0646 \u0645\u062c\u0645\u0648\u0639\u062a\u0647 \u062a\u062a\u0636\u0645\u0646 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0627\u0644\u0648\u0631\u0642\u064a\u0629 \u0648\u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u0639\u0647\u0648\u062f \u0645\u0644\u0648\u0643 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0643\u0627\u0641\u0629\u060c \u0628\u062f\u0621\u064b\u0627 \u0645\u0646 \u0639\u0647\u062f \u0627\u0644\u0645\u0644\u0643 \u0633\u0639\u0648\u062f\u060c \u062b\u0645 \u0627\u0644\u0645\u0644\u0643 \u0641\u064a\u0635\u0644\u060c \u0641\u0627\u0644\u0645\u0644\u0643 \u062e\u0627\u0644\u062f\u060c \u0648\u0627\u0644\u0645\u0644\u0643 \u0641\u0647\u062f\u060c \u0648\u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f \u0627\u0644\u0644\u0647\u060c \u0648\u0635\u0648\u0644\u064b\u0627 \u0625\u0644\u0649 \u0639\u0647\u062f \u062e\u0627\u062f\u0645 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646 \u0627\u0644\u0645\u0644\u0643 \u0633\u0644\u0645\u0627\u0646 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0639\u0632\u064a\u0632 - \u062d\u0641\u0638\u0647 \u0627\u0644\u0644\u0647 -. \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0648\u0639\u0646 \u0623\u0628\u0631\u0632 \u0645\u0627 \u062a\u0636\u0645 \u0645\u062c\u0645\u0648\u0639\u062a\u0647\u060c \u0623\u0634\u0627\u0631 \u0625\u0644\u0649 \u0623\u0646\u0647 \u064a\u062d\u062a\u0641\u0638 \u0628\u0639\u0645\u0644\u0627\u062a \u062a\u0639\u0648\u062f \u0644\u0639\u0647\u062f \u0627\u0644\u0645\u0624\u0633\u0633 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f \u0627\u0644\u0639\u0632\u064a\u0632 - \u0637\u064a\u0628 \u0627\u0644\u0644\u0647 \u062b\u0631\u0627\u0647 - \u0648\u0623\u062e\u0631\u0649 \u062a\u0639\u0648\u062f \u0644\u0645\u0627 \u0642\u0628\u0644 \u062a\u0623\u0633\u064a\u0633 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0644\u0627\u0641\u062a\u064b\u0627 \u0625\u0644\u0649 \u0627\u0642\u062a\u0646\u0627\u0626\u0647 \u0623\u0648\u0644 \u0625\u0635\u062f\u0627\u0631 \u0648\u0631\u0642\u064a \u0637\u064f\u0628\u0639 \u0641\u06