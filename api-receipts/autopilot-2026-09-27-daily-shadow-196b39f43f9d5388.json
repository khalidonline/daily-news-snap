A-%D9%85%D8%B4%D9%87%D8%AF-%D9%81%D9%84%D9%83%D9%8A-%D9%84%D8%A7%D9%81%D8%AA-%D8%A8%D8%AF%D8%B1-%D8%B1%D8%A8%D9%8A%D8%B9-%D8%A7%D9%84%D8%A2%D8%AE%D8%B1-%D9%8A%D8%B2%D9%8A%D9%86-%D8%B3%D9%85%D8%A7%D8%A1-%D8%A7%D9%84%D8%AD%D8%AF%D9%88%D8%AF-%D8%A7%D9%84%D8%B4%D9%85%D8%A7%D9%84%D9%8A%D8%A9", "summary": "\u064a\u0632\u064a\u0651\u0646 \u0628\u062f\u0631 \u0634\u0647\u0631 \u0631\u0628\u064a\u0639 \u0627\u0644\u0622\u062e\u0631 \u0633\u0645\u0627\u0621 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0645\u0633\u0627\u0621 \u0627\u0644\u064a\u0648\u0645\u060c \u0641\u064a \u0645\u0634\u0647\u062f \u0641\u0644\u0643\u064a \u0644\u0627\u0641\u062a\u060c \u0628\u0648\u0635\u0641\u0647 \u0623\u0648\u0644 \u0628\u062f\u0631 \u064a\u0634\u0647\u062f\u0647 \u0641\u0635\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u0641\u0644\u0643\u064a\u064b\u0627 \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0643\u0631\u0629 \u0627\u0644\u0623\u0631\u0636\u064a\u0629\u060c \u0648\u064a\u064f\u0639\u0631\u0641 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062b\u0642\u0627\u0641\u0627\u062a \u0628\u0627\u0633\u0645 \" \u0642\u0645\u0631 \u0627\u0644\u062d\u0635\u0627\u062f \" (Harvest Moon). \u0648\u0623\u0648\u0636\u062d \u0639\u0636\u0648 \u0646\u0627\u062f\u064a \u0627\u0644\u0641\u0644\u0643 \u0648\u0627\u0644\u0641\u0636\u0627\u0621 \u0639\u062f\u0646\u0627\u0646 \u062e\u0644\u064a\u0641\u0629\u060c \u0623\u0646 \u0627\u0644\u0642\u0645\u0631 \u064a\u0635\u0644 \u0625\u0644\u0649 \u0637\u0648\u0631 \u0627\u0644\u0628\u062f\u0631 \u0639\u0646\u062f\u0645\u0627 \u064a\u0642\u0639 \u0641\u064a \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0634\u0645\u0633 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0625\u0644\u0649 \u0627\u0644\u0623\u0631\u0636\u060c \u0641\u064a\u0628\u062f\u0648 \u0642\u0631\u0635\u0647 \u0645\u0636\u0627\u0621\u064b \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0643\u0645\u0627 \u064a\u064f\u0631\u0649 \u0645\u0646 \u0633\u0637\u062d \u0627\u0644\u0623\u0631\u0636\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0625\u0644\u0649 \u0623\u0646 \u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0628\u062f\u0631 \u062e\u0644\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629 \u064a\u0645\u0646\u062d \u0647\u0648\u0627\u0629 \u0627\u0644\u0631\u0635\u062f \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0641\u0631\u0635\u0629 \u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0634\u0631\u0648\u0642\u0647 \u0645\u0646 \u0627\u0644\u0623\u0641\u0642 \u0627\u0644\u0634\u0631\u0642\u064a \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0645\u0639 \u063a\u0631\u0648\u0628 \u0627\u0644\u0634\u0645\u0633. \u0648\u0628\u064a\u0651\u0646 \u0623\u0646 \u062a\u0633\u0645\u064a\u0629 \"\u0642\u0645\u0631 \u0627\u0644\u062d\u0635\u0627\u062f\" \u062a\u0633\u0645\u064a\u0629 \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0627\u0631\u062a\u0628\u0637\u062a \u0628\u0627\u0644\u0628\u062f\u0631 \u0627\u0644\u0623\u0642\u0631\u0628 \u0625\u0644\u0649 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u0645\u0646 \u0627\u0644\u0643\u0631\u0629 \u0627\u0644\u0623\u0631\u0636\u064a\u0629\u060c \u0648\u0644\u0627 \u062a\u0639\u0646\u064a \u062d\u062f\u0648\u062b \u062a\u063a\u064a\u0631 \u0641\u064a \u0627\u0644\u062e\u0635\u0627\u0626\u0635 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0626\u064a\u0629 \u0644\u0644\u0642\u0645\u0631 \u0623\u0648 \u0644\u0648\u0646\u0647\u060c \u0648\u0625\u0646\u0645\u0627 \u062a\u0639\u0648\u062f \u0625\u0644\u0649 \u0627\u0631\u062a\u0628\u0627\u0637 \u0636\u0648\u0621 \u0627\u0644