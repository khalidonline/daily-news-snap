29 \u0627\u0644\u0635\u062d \u062a\u0642\u062f\u0631 \u062a\u0639\u064a\u0634 \u0623\u0643\u062b\u0631 \u0645\u0646 100 \u0633\u0646\u0629", "punch": "\u0635\u0628\u0631\u0647\u0627 \u0641\u064a \u0627\u0644\u0646\u0645\u0648 \u064a\u0639\u0648\u0636\u0647 \u0637\u0648\u0644 \u0639\u0645\u0631\u0647\u0627", "claim_ids": ["c3"], "image_query": "old palm tree", "image": {"provider": "commons", "asset_id": "24901206", "title": "File:Old grey palm tree roots closeup.jpg", "description": "Image title: Old grey palm tree roots closeup Image from Public domain images website, http://www.public-domain-image.com/full-image/flora-plants-public-domain-images-pictures/trees-public-domain-images-pictures/palm-tree-pictures/old-grey-palm-tree-roots-closeup.jpg.html", "download_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Old_grey_palm_tree_roots_closeup.jpg/1920px-Old_grey_palm_tree_roots_closeup.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "original_url": "https://upload.wikimedia.org/wikipedia/commons/7/75/Old_grey_palm_tree_roots_closeup.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Old_grey_palm_tree_roots_closeup.jpg", "credit": "Titus Tscharntke", "credit_line": "http://www.public-domain-image.com/public-domain-images-pictures-free-stock-photos/flora-plants-public-domain-images-pictures/trees-public-domain-images-pictures/palm-tree-pictures/old-grey-palm-tree-roots-closeup.jpg", "license": "Public domain", "license_url": "", "attribution_required": "false", "restrictions": "", "date_created": "Not given Transferred by F\u00e6 on 2013-02-27", "licensing_verified": false}}, {"kind": "story", "title": "\u0634\u0643\u0644 \u0627\u0644\u062b\u0645\u0631\u0629 \u062b\u0627\u0628\u062a \u062a\u0642\u0631\u064a\u0628\u064b\u0627", "body": "\u062d\u0628\u0629 \u0627\u0644\u062a\u0645\u0631 \u0634\u0643\u0644\u0647\u0627 \u0628\u064a\u0636\u0627\u0648\u064a \u0623\u0633\u0637\u0648\u0627\u0646\u064a\u060c \u0637\u0648\u0644\u0647\u0627 \u0628\u064a\u0646 3 \u06487 \u0633\u0645 \u0648\u0642\u0637\u0631\u0647\u0627 \u062d\u0648\u0627\u0644\u064a 2.5 \u0633\u0645", "punch": "", "claim_ids": ["c4"], "image_query": "date fruit shape"}, {"kind": "story", "title": "\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u062a\u062e\u062a\u0644\u0641 \u0645\u0646 \u0646\u0648\u0639 \u0644\u0646\u0648\u0639", "body": "\u0644\u0648\u0646 \u0627\u0644\u062a\u0645\u0631 \u064a\u062a\u0641\u0627\u0648\u062a \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639\u060c \u0645\u0646 \u0627\u0644\u0628\u0646\u064a \u0627\u0644\u063a\u0627\u0645\u0642 \u0625\u0644\u0649 \u0627\u0644\u0623\u062d\u0645\u0631 \u0627\u0644\u0641\u0627\u062a\u062d \u0623\u0648 \u0627\u0644\u0623\u0635\u0641\u0631", "punch": "\u0643\u0644 \u0646\u0648\u0639 \u0644\u0647 \u0628\u0635\u0645\u062a\u0647 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0644\u0648\u0646", "claim_ids": ["c5"], "image_query": "date fruit colors"}, {"kind": "story", "title": "\u062d\u0644\u0627\u0648\u0629 \u0627\u0644\u062a\u0645\u0631 \u0645\u0628 \u0645\u0635\u0627\u062f\u0641\u0629", "body": "\u0644\u0645\u0627 \u064a\u064a\u0628\u0633 \u0627\u0644\u062a\u0645\u0631\u060c \u0646\u0633\u0628\u0629 \u0627\u0644\u0633\u0643\u0631 \u0641\u064a\u0647 \u062a\u0648\u0635\u0644 \u0628\u064a\u0646 63 \u064864% \u0645\u0646 \u0648\u0632\u0646\u0647\u060c \u0648\u0647\u0630\u0627 \u0633\u0628\u0628 \u062d\u0644\u0627\u0648\u062a\u0647 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629", "punch": "", "claim_ids": ["c6"], "image_query": "dried dates"}]}, "feedback": "unknown_visual_selection: date fruit shape: \u0627\u0644\u0628\u0637\u0627\u0642\u06291: \u0635\u0648\u0631\u0629 \u0646\u062e\u0644\u0629 \u062a\u0645\u0631 \u0639\u0627\u0645\u0629 \u0628\u0645\u0646\u0638\u0631 \u0637\u0628\u064a\u0639\u064a\u060c \u062a\u0645\u062b\u064a\u0644 \u0645\u0646\u0627\u0633\u0628 \u0644\u062c\u0646\u0633 \u0627\u0644\u0646\u062e\u064a\u0644. \u0627\u0644\u0628\u0637\u0627\u0642\u06292: \u0644\u0627 \u062a\u0648\u062c\u062f \u0635\u0648\u0631\u0629 \u062a\u0648\u062b\u0642 \u0632\u0631\u0627\u0639\u0629 \u0627\u0644\u0646\u062e\u064a\u0644 \u0642\u062f\u064a\u0645\u064b\u0627 \u062a\u062d\u062f\u064a\u062f\u064b\u0627\u060c \u0641\u0627\u062e\u062a\u0631\u062a \u0644\u0648\u062d \u0645\u0633\u0645\u0627\u0631\u064a \u0639\u0627\u0645 \u0643\u0631\u0645\u0632 \u0628\u0635\u0631\u064a \u0644\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u060c \u0648\u0647\u0648 \u0623\u0642\u0631\u0628 \u062e\u064a\u0627\u0631 \u0645\u062a\u0627\u062d \u0631\u063a\u0645 \u0623\u0646\u0647 \u063a\u064a\u0631 \u0645\u0631\u062a\u0628\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0627\u0644\u0646\u062e\u064a\u0644. \u0627\u0644\u0628\u0637\u0627\u0642\u06293: \u0635\u0648\u0631\u0629 \u0646\u062e\u064a\u0644 \u0637\u0648\u064a\u0644 \u0641\u064a \u062d\u062f\u064a\u0642\u0629 \u0646\u0628\u0627\u062a\u064a\u0629 \u062a\u064f\u0638\u0647\u0631 \u0639\u062f\u0629 \u062c\u0630\u0648\u0639\u060c \u062a\u0646\u0627\u0633\u0628 \u0641\u0643\u0631\u0629 \u0627\u0644\u0646\u0645\u0648 \u0627\u0644\u062c\u0645\u0627\u0639\u064a \u0623\u0648 \u0627\u0644\u0641\u0631\u062f\u064a. \u0627\u0644\u0628\u0637\u0627\u0642\u06294: \u0635\u0648\u0631\u0629 \u062c\u0630\u0648\u0639 \u0646\u062e\u0644\u0629 \u0642\u062f\u064a\u0645\u0629 \u0631\u0645\u0627\u062f\u064a\u0629 \u062a\u0639\u0643\u0633 \u0641\u0643\u0631\u0629 \u0627\u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0645\u0639\u0645\u0631\u0629 \u0628\u0648\u0636\u0648\u062d. \u0627\u0644\u0628\u0637\u0627\u0642\u06295: \u0643\u0644 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629 (\u062a\u0645\u064a\u0645\u0629 \u0645\u0635\u0631\u064a\u0629\u060c \u0645\u0627\u0646\u062c\u0648\u060c \u0646\u0628\u0627\u062a \u0643\u0644\u0648\u0631\u0648\u0641\u064a\u062a\u0648\u0645) \u0644\u0627 \u0639\u0644\u0627\u0642\u0629 \u0644\u0647\u0627 \u0628\u0634\u0643\u0644 \u062b\u0645\u0631\u0629 \u0627\u0644\u062a\u0645\u0631\u060c \u0641\u062a\u0645 \u0631\u0641\u0636\u0647\u0627 \u062c\u0645\u064a\u0639\u064b\u0627. \u0627\u0644\u0628\u0637\u0627\u0642\u06296: \u0643\u0644 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0635\u0648\u0631 \u0645\u0646 \u0643\u062a\u0627\u0644\u0648\u062c \u0623\u0632\u0647\u0627\u0631 \u0642\u062f\u064a\u0645 (Chase Brothers) \u0648\u0644\u0627 \u062a\u0645\u062a \u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062a\u0645\u0631 \u0628\u0635\u0644\u0629\u060c \u0641\u062a\u0645 \u0631\u0641\u0636\u0647\u0627. \u0627\u0644\u0628\u0637\u0627\u0642\u06297: \u0635\u0648\u0631\u0629 \u0639\u0646\u0627\u0642\u064a\u062f \u062a\u0645\u0631 \u0646\u0627\u0636\u062c\u0629 \u0648\u062c\u0627\u0641\u0629 \u0645\u0646 \u0645\u0632\u0631\u0639\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0645\u0637\u0627\u0628\u0642\u0629 \u062a\u0645\u0627\u0645\u064b\u0627 \u0644\u0645\u0648\u0636\u0648\u0639 \u062d\u0644\u0627\u0648\u0629 \u0627\u0644\u062a\u0645\u0631 \u0628\u0639\u062f \u0627\u0644\u062c\u0641\u0627\u0641."}