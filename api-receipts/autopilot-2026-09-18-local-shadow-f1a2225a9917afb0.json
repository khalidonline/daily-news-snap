639\u0648\u062f\u064a", "cards": [{"kind": "info", "title": "\u0627\u0644\u0646\u062e\u0644\u0629 \u0645\u0648 \u0628\u0633 \u0634\u062c\u0631\u0629 \u062a\u0645\u0631", "body": "\u062c\u0646\u0633 \u0627\u0644\u0646\u062e\u064a\u0644 \u064a\u0634\u0645\u0644 \u0645\u0646 12 \u0625\u0644\u0649 19 \u0646\u0648\u0639 \u0645\u0646 \u0646\u062e\u064a\u0644 \u0627\u0644\u062a\u0645\u0631 \u0627\u0644\u0628\u0631\u064a\u060c \u0648\u0623\u0635\u0644 \u0627\u0644\u0646\u062e\u0644\u0629 \u064a\u0645\u062a\u062f \u0645\u0646 \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u0644\u064a\u0646 \u0628\u0627\u0643\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u0647\u0646\u062f", "punch": "\u064a\u0639\u0646\u064a \u0627\u0644\u0646\u062e\u0644\u0629 \u0627\u0644\u0644\u064a \u0646\u0639\u0631\u0641\u0647\u0627 \u062c\u0632\u0621 \u0645\u0646 \u0639\u0627\u0626\u0644\u0629 \u0643\u0628\u064a\u0631\u0629 \u0648\u0645\u0646\u062a\u0634\u0631\u0629", "claim_ids": ["c7", "c8"], "image_query": "date palm tree", "image": {"provider": "commons", "asset_id": "51286104", "title": "File:Date palm tree landscape.jpg", "description": "date palm tree landscape", "download_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/Date_palm_tree_landscape.jpg/1920px-Date_palm_tree_landscape.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "original_url": "https://upload.wikimedia.org/wikipedia/commons/e/e4/Date_palm_tree_landscape.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Date_palm_tree_landscape.jpg", "credit": "Srianix", "credit_line": "Own work", "license": "CC0", "license_url": "http://creativecommons.org/publicdomain/zero/1.0/deed.en", "attribution_required": "false", "restrictions": "", "date_created": "2012-01-01", "licensing_verified": false}}, {"kind": "story", "title": "\u062a\u0627\u0631\u064a\u062e \u