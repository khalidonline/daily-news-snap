u0639\u064a\u0629 \u0627\u0644\u0641\u0644\u0643\u064a\u0629 \u0628\u062c\u062f\u0629 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0645\u0627\u062c\u062f \u0623\u0628\u0648\u0632\u0627\u0647\u0631\u0629 \u064a\u0648\u0636\u062d \u0625\u0646 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u064a\u0648\u062f\u0651\u0639 \u0627\u0644\u0635\u064a\u0641 \u0641\u0644\u0643\u064a\u0627\u064b \u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 22 \u0633\u0628\u062a\u0645\u0628\u0631 \u0648\u064a\u062f\u062e\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 23 \u0633\u0628\u062a\u0645\u0628\u0631.", "source_id": "article", "quote": "\u0633\u0628\u062a\u0645\u0628\u0631 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0645\u0646 \u0641\u0635\u0644 \u0627\u0644\u0635\u064a\u0641 \u0641\u0644\u0643\u064a\u064b\u0627\u060c \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u064b\u0627 \u0644\u062f\u062e\u0648\u0644 \u0641\u0635\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u063a\u062f\u064b\u0627 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 23 \u0633\u0628\u062a\u0645\u0628\u0631\u060c \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u062d\u062f\u0648\u062b \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a. \u0648\u0628\u064a\u0651\u0646 \u0623\u0646", "passage_id": "article:p11"}, {"id": "c3", "fact": "\u062f\u062e\u0648\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u0641\u0644\u0643\u064a\u0627\u064b \u0645\u0627 \u064a\u0639\u0646\u064a \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0639\u0644\u0649 \u0637\u0648\u0644\u060c \u0644\u0623\u0646 \u062a\u0623\u062b\u064a\u0631 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0635\u064a\u0641 \u064a\u0633\u062a\u0645\u0631 \u0641\u062a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0632\u0645\u0646.", "source_id": "article", "quote": "\u062f\u062e\u0648\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u0641\u0644\u0643\u064a\u064b\u0627 \u0644\u0627 \u064a\u0639\u0646\u064a \u0627\u0646\u062e\u0641\u0627\u0636 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0628\u0635\u0648\u0631\u0629 \u0645\u0628\u0627\u0634\u0631\u0629\u060c \u0625\u0630 \u064a\u0633\u062a\u0645\u0631 \u062a\u0623\u062b\u064a\u0631 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0635\u064a\u0641 \u0644\u0641\u062a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0632\u0645\u0646\u060c \u0642\u0628\u0644 \u0623\u0646 \u062a\u0628\u062f\u0623 \u062f\u0631\u062c\u0627\u062a", "passage_id": "article:p14"}, {"id": "c4", "fact": "\u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u062a\u062a\u063a\u064a\u0631 \u062a\u062f\u0631\u064a\u062c\u064a\u0627\u064b \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u0648\u062a\u0635\u064a\u0631 \u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u0623\u0648\u0636\u062d \u0645\u0639 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0628 \u0645\u0646 \u0646\u0648\u0641\u0645\u0628\u0631\u060c \u0648\u064a\u062e\u062a\u0644\u0641 \u0630\u0644\u0643 \u0645\u0646 \u0645\u0646\u0637\u0642\u0629 \u0644\u0623\u062e\u0631\u0649 \u062d\u0633\u0628 \u0627\u0644\u0638\u0631\u0648\u0641 \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629.", "source_id": "article", "quote": "\u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0641\u064a \u0627\u0644\u062a\u063a\u064a\u0631 \u062a\u062f\u0631\u064a\u062c\u064a\u064b\u0627 \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u0648\u062a\u0635\u0628\u062d \u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u0623\u0643\u062b\u0631 \u0648\u0636\u0648\u062d\u064b\u0627 \u0645\u0639 \u0627\u0644\u062a\u0642\u062f\u0645 \u0646\u062d\u0648 \u0634\u0647\u0631 \u0646\u0648\u0641\u0645\u0628\u0631\u060c \u0645\u0639 \u0627\u062e\u062a\u0644\u0627\u0641 \u0630\u0644\u0643 \u0645\u0646 \u0645\u0646\u0637\u0642\u0629", "passage_id": "article:p15"}, {"id": "c5", "fact": "\u0627\u0644\u062e\u0631\u064a\u0641 \u0645\u0631\u062d\u0644\u0629 \u0627\u0646\u062a\u0642\u0627\u0644\u064a\u0629 \u062a\u0643\u062b\u0631 \u0641\u064a\u0647\u0627 \u0627\u0644\u062a\u0642\u0644\u0628\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u0646\u0634\u0627\u0637 \u0627\u0644\u0631\u064a\u0627\u062d\u060c \u0648\u062a\u0631\u062a\u0641\u0639 \u0641\u0631\u0635 \u0639\u062f\u0645 \u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0648\u0647\u0637\u0648\u0644 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0641\u064a \u062f\u0648\u0644 \u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0645\u0646\u0647\u0627 \u0623\u062c\u0632\u0627\u0621 \u0645\u0646 \u0634\u0628\u0647 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.", "source_id": "article", "quote": "\u062c\u0627\u0646\u0628 \u0627\u0631\u062a\u0641\u0627\u0639 \u0641\u0631\u0635 \u062d\u0627\u0644\u0627\u062a \u0639\u062f\u0645 \u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0627\u0644\u062c\u0648\u064a \u0648\u0647\u0637\u0648\u0644 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0641\u064a \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0623\u062c\u0632\u0627\u0621 \u0645\u0646 \u0634\u0628\u0647 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c", "passage_id": "article:p19"}, {"id": "c6", "fact": "\u0628\u0633\u0628\u0628 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u062a\u0642\u0648\u064a\u0645\u064a\u0629 \u0648\u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u062f\u0627\u0631\u064a\u0629\u060c \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u0633\u0628\u062a\u0645\u0628\u0631\u064a \u0645\u0645\u0643\u0646 \u064a\u0642\u0639 \u0641\u064a \u0623\u064a \u064a\u0648\u0645 \u0628\u064a\u0646 21 \u064824 \u0633\u0628\u062a\u0645\u0628\u0631.", "source_id": "wiki-1730534", "quote": "differences between the calendar year and the tropical year, the September equinox may occur from September 21 to 24.\n\nAt the equinox,", "passage_id": "wiki-1730534:p1"}, {"id": "c7", "fact": "\u0646\u0642\u0637\u0629 \u0639\u0628\u0648\u0631 \u0627\u0644\u0634\u0645\u0633 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u062a\u0633\u0645\u0649 \u00ab\u0623\u0648\u0644 \u0646\u0642\u0637\u0629 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u00bb\u060c \u0644\u0643\u0646\u0647\u0627 \u0628\u0633\u0628\u0628 \u062a\u0642\u062f\u0645 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644\u064a\u0646 \u0627\u0646\u062a\u0642\u0644\u062a \u0645\u0646 \u0627\u0644\u0645\u064a\u0632\u0627\u0646 \u0625\u0644\u0649 \u0627\u0644\u0639\u0630\u0631\u0627\u0621 \u0633\u0646\u0629 730 \u0642\u0628\u0644 \u0627\u0644\u0645\u064a\u0644\u0627\u062f\u060c \u0648\u064a\u062a\u0648\u0642\u0639 \u062f\u062e\u0648\u0644\u0647\u0627 \u0627\u0644\u0623\u0633\u062f \u0639\u0627\u0645 2439.", "source_id": "wiki-1730534", "quote": "constellation Libra, but rather in Virgo.\nThe solar point of the September equinox passed from Libra and into Virgo in \u2212729 (730", "passage_id": "wiki-1730534:p8"}, {"id": "c8", "fact": "\u062d\u0648\u0644 \u0627\u0644\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0642\u0637\u0628\u064a\u0629 \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629 \u064a\u0646\u062a\u0647\u064a \u0645\u0639 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0645\u0648\u0633\u0645 \u0627\u0644\u0646\u0647\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0648\u062a\u0628\u062f\u0623 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0638\u0644\u0627\u0645 \u062a\u0632\u064a\u062f\u060c \u0648\u0647\u0630\u0627 \u064a\u0647\u064a\u0626 \u0638\u0631\u0648\u0641 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0645\u0634\u0627\u0647\u062f\u0629 \u0627\u0644\u0634\u0641\u0642 \u0627\u0644\u0642\u0637\u0628\u064a.", "source_id": "article", "quote": "\u0627\u0644\u0625\u0636\u0627\u0621\u0629\u060c \u0625\u0630 \u062a\u0628\u062f\u0623 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0621 \u0641\u062a\u0631\u0629 \u0627\u0644\u0646\u0647\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u062e\u0644\u0627\u0644 \u0627\u0644\u0635\u064a\u0641 \u0641\u064a \u0627\u0644\u062f\u062e\u0648\u0644 \u062a\u062f\u0631\u064a\u062c\u064a\u064b\u0627 \u0625\u0644\u0649 \u0645\u0648\u0633\u0645 \u062a\u0632\u062f\u0627\u062f \u062e\u0644\u0627\u0644\u0647 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0638\u0644\u0627\u0645\u060c \u0645\u0627 \u064a\u0647\u064a\u0626", "passage_id": "article:p21"}], "event_source_id": "article", "event_quote": "\u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a \u0633\u064a\u062d\u062f\u062b \u0639\u0646\u062f \u0627\u0644\u0633\u0627\u0639\u0629 03:05 \u0641\u062c\u0631\u064b\u0627 \u0628\u062a\u0648\u0642\u064a\u062a \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629\u060c \u0627\u0644\u0645\u0648\u0627\u0641\u0642 00:05 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0639\u0628\u0631 \u0627\u0644\u0634\u0645\u0633 \u0638\u0627\u0647\u0631\u064a\u064b\u0627 \u062e\u0637 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0621"}, "draft": {"title": "\u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a: \u0627\u0644\u062e\u0631\u064a\u0641 \u064a\u0628\u062f\u0623 \u0641\u0644\u0643\u064a\u0627\u064b \u0648\u0628\u0633 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0645\u0627 \u062a\u0646\u0632\u0644 \u0639\u0644\u0649 \u0637\u0648\u0644", "cards": [{"kind": "info", "title": "\u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a \u0644\u062d\u0638\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0648 \u064a\u0648\u0645 \u0643\u0627\u0645\u0644", "body": "\u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0644 \u0627\u0644\u062e\u0631\u064a\u0641\u064a \u0644\u062d\u0638\u0629 \u0645\u062d\u062f\u062f\u0629 \u062a\u0639\u0628\u0631 \u0641\u064a\u0647\u0627 \u0627\u0644\u0634\u0645\u0633 \u0638\u0627\u0647\u0631\u064a\u0627\u064b \u062e\u0637 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0621 \u0627\u0644\u0633\u0645\u0627\u0648\u064a \u0645\u0646 \u0627\u0644\u0634\u0645\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u062c\u0646\u0648\u0628\u060c \u0648\u062a\u0635\u064a\u0631 \u0647\u0630\u064a \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0633\u0627\u0639\u0629 03:05 \u0641\u062c\u0631\u0627\u064b \u0628\u062a\u0648\u0642\u064a\u062a \u0645\u0643\u0629\u060c \u0627\u0644\u0644\u064a \u062a\u0642\u0627\u0628\u0644 00:05 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634. \u0648\u0645\u0627 \u0644\u0647 \u062a\u0627\u0631\u064a\u062e \u062b\u0627\u0628\u062a: \u0628\u0633\u0628\u0628 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u062a\u0642\u0648\u064a\u0645\u064a\u0629 \u0648\u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u062f\u0627\u0631\u064a\u0629 \u064a\u0645\u0643\u0646 \u064a\u0642\u0639 \u0641\u064a \u0623\u064a \u064a\u0648\u0645 \u0628\u064a\u0646 21 \u064824 \u0633\u0628\u062a\u0645\u0628\u0631.", "punch": "\u064a\u0639\u0646\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u064a\u062a\u0632\u062d\u0632\u062d \u0643\u0644 \u0633\u0646\u0629\u060c \u0648\u0647\u0630\u064a \u0627\u0644\u0645\u0631\u0629 \u062c\u0627\u0621 23 \u0633\u0628\u062a\u0645\u0628\u0631.", "claim_ids": ["c1", "c6"], "image_query": "September equinox diagram"}, {"kind": "story", "title": "\u0627\u0644\u062e\u0631\u064a\u0641 \u0628\u062f\u0623 \u0641\u0644\u0643\u064a\u0627\u064b.. \u0648\u0627\u0644\u062c\u0648 \u0645\u0627 \u0634\u0639\u0631 \u0628\u0627\u0644\u062e\u0628\u0631", "body": "\u0631\u0626\u064a\u0633 \u0627\u0644\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u0641\u0644\u0643\u064a\u0629 \u0628\u062c\u062f\u0629 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0645\u0627\u062c\u062f \u0623\u0628\u0648\u0632\u0627\u0647\u0631\u0629 \u064a\u0648\u0636\u062d \u0625\u0646 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u0648\u062f\u0651\u0639 \u0627\u0644\u0635\u064a\u0641 \u0641\u0644\u0643\u064a\u0627\u064b \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 22 \u0633\u0628\u062a\u0645\u0628\u0631 \u0648\u062f\u062e\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 23. \u0644\u0643\u0646 \u062f\u062e\u0648\u0644 \u0627\u0644\u062e\u0631\u064a\u0641 \u0641\u0644\u0643\u064a\u0627\u064b \u0645\u0627 \u064a\u0639\u0646\u064a \u0625\u0646 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u062a\u0646\u0632\u0644 \u0639\u0644\u0649 \u0637\u0648\u0644\u060c \u0644\u0623\u0646 \u062a\u0623\u062b\u064a\u0631 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0635\u064a\u0641 \u064a\u0633\u062a\u0645\u0631 \u0641\u062a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0632\u0645\u0646.", "punch": "", "claim_ids": ["c2", "c3"], "image_query": "Earth from space"}, {"kind": "story", "title": "\u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u064a\u062c\u064a \u0628\u0627\u0644\u062a\u062f\u0631\u064a\u062c \u0648\u0623\u0648\u0636\u062d \u0645\u0639 \u0646\u0648\u0641\u0645\u0628\u0631", "body": "\u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u062a\u0628\u062f\u0623 \u062a\u062a\u063a\u064a\u0631 \u062a\u062f\u0631\u064a\u062c\u064a\u0627\u064b \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u062a\u0