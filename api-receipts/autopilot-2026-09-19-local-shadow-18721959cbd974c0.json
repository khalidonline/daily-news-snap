 millennium BCE. Dates are...", "passage_id": "wiki-87598:p8"}]}, "draft": {"title": "\u0627\u0644\u0646\u062e\u0644\u0629.. \u0634\u062c\u0631\u0629 \u0627\u0644\u0639\u0645\u0631 \u0627\u0644\u0637\u0648\u064a\u0644 \u0648\u0627\u0644\u062a\u0645\u0631 \u0627\u0644\u062d\u0644\u0648", "cards": [{"kind": "info", "title": "\u0646\u062e\u0644\u0629 \u0627\u0644\u062a\u0645\u0631", "body": "\u0623\u0635\u0644 \u0627\u0644\u0646\u062e\u0644\u0629 \u0645\u0646 \u0627\u0644\u062e\u0644\u064a\u062c \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u0648\u064a\u0645\u062a\u062f \u0644\u0628\u0627\u0643\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u0647\u0646\u062f\u060c \u0648\u062a\u064f\u0632\u0631\u0639 \u0645\u0646 \u0623\u062c\u0644 \u062b\u0645\u0631\u0647\u0627 \u0627\u0644\u062d\u0644\u0648 \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0627\u0644\u062a\u0645\u0631", "punch": "\u062c\u0632\u0621 \u0645\u0646 \u064a\u0648\u0645\u064a\u0627\u062a\u0646\u0627 \u0645\u0648 \u0628\u0633 \u0628\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0627\u062a", "claim_ids": ["c1"], "image_query": "date palm tree"}, {"kind": "story", "title": "\u0634\u062c\u0631\u0629 \u062a\u0639\u064a\u0634 \u0623\u0643\u062b\u0631 \u0645\u0646 100 \u0633\u0646\u0629", "body": "\u0627\u0644\u0646\u062e\u0644\u0629 \u062a\u0642\u062f\u0631 \u062a\u0648\u0635\u0644 30 \u0645\u062a\u0631 \u0637\u0648\u0644\u060c \u0648\u062a\u0646\u0645\u0648 \u0644\u062d\u0627\u0644\u0647\u0627 \u0623\u0648 \u0628\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0645\u0646 \u0639\u062f\u0629 \u062c\u0630\u0648\u0639 \u0628\u062c\u0630\u0631 \u0648\u0627\u062d\u062f\u060c \u0648\u0628\u0637\u064a\u0626\u0629 \u0627\u0644\u0646\u0645\u0648 \u0644\u0643\u0646\u0647\u0627 \u062a\u0639\u064a\u0634 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0642\u0631\u0646 \u0644\u0648 \u0627\u0639\u062a\u0646\u0649 \u0641\u064a\u0647\u0627 \u0635\u062d", "punch": "\u0639\u0645\u0631\u0647\u0627 \u064a\u0637\u0648\u0644 \u0644\u0648 \u062a\u0639\u0627\u0645\u0644\u062a \u0648\u064a\u0627\u0647\u0627 \u0635\u062d", "claim_ids": ["c2", "c3"], "image_query": "date palm trunk"}, {"kind": "story", "title": "\u0644\u064a\u0634 \u0627\u0644\u062a\u0645\u0631 \u062d\u0644\u0648 \u0643\u0630\u0627\u061f", "body": "\u062b\u0645\u0631\u0629 \u0627\u0644\u062a\u0645\u0631 \u0628\u064a\u0636\u0627\u0648\u064a\u0629 \u0637\u0648\u0644\u0647\u0627 \u0628\u064a\u0646 3 \u06487 \u0633\u0645\u060c \u0648\u0644\u0648\u0646\u0647\u0627 \u064a\u062a\u0631\u0627\u0648\u062d \u0645\u0646 \u0628\u0646\u064a \u063a\u0627\u0645\u0642 \u0644\u0623\u062d\u0645\u0631 \u0623\u0648 \u0623\u0635\u0641\u0631 \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639\u060c \u0648\u0644\u0645\u0627 \u064a\u064a\u0628\u0633 \u062a\u0643\u0648\u0646 \u0641\u064a\u0647 \u0646\u0633\u0628\u0629 \u0633\u0643\u0631 \u062a\u0648\u0635\u0644 63 \u0625\u0644\u0649 64% \u0645\u0646 \u0648\u0632\u0646\u0647", "punch": "\u0639\u0634\u0627\u0646 \u0643\u0630\u0627 \u0646\u0623\u0643\u0644\u0647 \u0644\u062d\u0627\u0644\u0647 \u0623\u0648 \u0645\u0639 \u0627\u0644\u062d\u0644\u0648\u064a\u0627\u062a", "claim_ids": ["c4", "c5"], "image_query": "dark dates fruit"}, {"kind": "story", "title": "\u062c\u0630\u0648\u0631 \u062a\u0645\u062a\u062f \u0644\u0622\u0644\u0627\u0641 \u0627\u0644\u0633\u0646\u064a\u0646", "body": "\u0641\u064a\u0647 \u0623\u062f\u0644\u0629 \u0623\u062b\u0631\u064a\u0629 \u062a\u062b\u0628\u062a \u0625\u0646 \u0632\u0631\u0627\u0639\u0629 \u0627\u0644\u0646\u062e\u064a\u0644 \u0641\u064a \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0645\u0646 \u0627\u0644\u0623\u0644\u0641\u064a\u0629 \u0627\u0644\u0633\u0627\u062f\u0633\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u064a\u0644\u0627\u062f", "punch": "\u062a\u0631\u0627\u062b \u0632\u0631\u0627\u0639\u064a \u0639\u0645\u0631\u0647 \u0622\u0644\u0627\u0641 \u0627\u0644\u0633\u0646\u064a\u0646", "claim_ids": ["c6"], "image_query": "date palm orchard"}]}, "feedback": "visual_review_rejected: \u0627\u0644\u0646\u0635\u0648\u0635 \u0643\u0644\u0647\u0627 \u0645\u0637\u0627\u0628\u0642\u0629 \u0644\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0623\u0635\u0644\u064a (\u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 - Phoenix dactylifera): \u0627\u0644\u0623\u0635\u0644 \u0645\u0646 \u0627\u0644\u062e\u0644\u064a\u062c \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u062d\u062a\u0649 \u0628\u0627\u0643\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u0647\u0646\u062f\u060c \u0627\u0631\u062a\u0641\u0627\u0639 30 \u0645\u062a\u0631 \u0648\u0646\u0645\u0648 \u0628\u0639\u062f\u0629 \u062c\u0630\u0648\u0639 \u0645\u0646 \u062c\u0630\u0631 \u0648\u0627\u062d\u062f\u060c \u0628\u0637\u0621 \u0627\u0644\u0646\u0645\u0648 \u0648\u0639\u0645\u0631 \u064a\u062a\u062c\u0627\u0648\u0632 100 \u0633\u0646\u0629\u060c \u062b\u0645\u0631\u0629 3-7 \u0633\u0645 \u0628\u0623\u0644\u0648\u0627\u0646 \u0645\u0646 \u0627\u0644\u0628\u0646\u064a \u0627\u0644\u063a\u0627\u0645\u0642 \u0644\u0644\u0623\u062d\u0645\u0631 \u0623\u0648 \u0627\u0644\u0623\u0635\u0641\u0631\u060c 63-64% \u0633\u0643\u0631 \u0639\u0646\u062f \u0627\u0644\u062a\u062c\u0641\u064a\u0641\u060c \u0648\u0623\u062f\u0644\u0629 \u0623\u062b\u0631\u064a\u0629 \u0644\u0644\u0632\u0631\u0627\u0639\u0629 \u0641\u064a \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0644\u0641\u064a\u0629 \u0627\u0644\u0633\u0627\u062f\u0633\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u064a\u0644\u0627\u062f. \u0627\u0644\u0644\u063a\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 \u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0627\u0644\u062a\u0633\u0644\u0633\u0644 \u0645\u062a\u0631\u0627\u0628\u0637 (\u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0646\u062e\u0644\u0629 \u2190 \u0639\u0645\u0631\u0647\u0627 \u0648\u062b\u0645\u0631\u062a\u0647\u0627 \u2190 \u062d\u0644\u0627\u0648\u0629 \u0627\u0644\u062a\u0645\u0631 \u2190 \u062c\u0630\u0648\u0631\u0647\u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629) \u0648\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u062a\u0636\u064a\u0641 \u062a\u0639\u0631\u064a\u0641\u0627\u064b \u0645\u0633\u062a\u0642\u0644\u0627\u064b \u0644\u0627 \u062a\u0643\u0631\u0627\u0631\u0627\u064b. \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0628\u0635\u0631\u064a\u0629 \u0641\u0627\u062a\u062d\u0629 \u0628\u062e\u0637 \u0627\u0644\u0645\u0631\u0627\u0639\u064a \u0628\u0644\u0627 \u062a\u062f\u0627\u062e\u0644 \u0623\u0648 \u0642\u0635 \u0641\u064a \u0627\u0644\u0628\u0643\u0633\u0644\u0627\u062a \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0633\u0637\u0631 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0641\u064a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0648\u0627\u0636\u062d.\n\u0627\u0644\u0635\u0648\u0631 \u0628\u0627\u0644\u0628\u0643\u0633\u0644: (1) \u0646\u062e\u0644\u0629 \u062a\u0645\u0631 \u0643\u0628\u064a\u0631\u0629 \u0628\u0639\u062f\u0629 \u062c\u0630\u0648\u0639 \u0648\u0633\u0639\u0641 \u0623\u062e\u0636\u0631 \u0623\u0645\u0627\u0645 \u062c\u062f\u0631\u0627\u0646 - \u0645\u0637\u0627\u0628\u0642\u0629. (2) \u0639\u0630\u0648\u0642 \u0628\u0644\u062d \u0623\u0635\u0641\u0631 (\u062e\u0644\u0627\u0644) \u0645\u0639\u0644\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0639\u0641 \u062a\u062d\u062a \u0633\u0645\u0627\u0621 \u0632\u0631\u0642\u0627\u0621 - \u0645\u0637\u0627\u0628\u0642\u0629 \u0648\u0648\u0627\u0636\u062d\u0629. (3) \u0643\u0648\u0645\u0629 \u0645\u0646 \u062d\u0628\u0627\u062a \u0628\u064a\u0636\u0627\u0648\u064a\u0629 \u0634\u0627\u062d\u0628\u0629 \u0628\u0644\u0648\u0646 \u0643\u0631\u064a\u0645\u064a \u0645\u0639 \u0628\u0642\u0639 \u0628\u0646\u064a\u0629 \u0645\u062d\u0645\u0631\u0629\u060c \u0644\u0627 \u062a\u064f\u0642\u0631\u0623 \u0628\u062b\u0642\u0629 \u0643\u062a\u0645\u0631 \u0633\u0639\u0648\u062f\u064a\u061b \u062a\u0634\u0628\u0647 \u0627\u0644\u0645\u0643\u0633\u0631\u0627\u062a/\u0627\u0644\u0639\u0646\u0627\u0628 \u0627\u0644\u0645\u0642\u0634\u0648\u0631 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u062a\u0645\u0631 \u0627\u0644\u0645\u062c\u0641\u0641 \u0627\u0644\u062f\u0627\u0643\u0646 \u0627\u0644\u0645\u062a\u063a\u0636\u0646 - \u0635\u0648\u0631\u0629 \u0645\u0644\u062a\u0628\u0633\u0629 \u064a\u062c\u0628 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0635\u0648\u0631\u0629 \u0648\u0627\u0636\u062d\u0629 \u0644\u062a\u0645\u0631 (\u0645\u062b\u0644\u0627\u064b \u0637\u0628\u0642 \u062a\u0645\u0631 \u062f\u0627\u0643\u0646 \u0623\u0648 \u0639\u0630\u0648\u0642 \u0627\u0644\u062a\u0645\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0641\u064a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629). (4) \u0628\u0633\u062a\u0627\u0646 \u0646\u062e\u064a\u0644 \u062a\u0645\u0631 \u0648\u0633\u0645\u0627\u0621 \u0632\u0631\u0642\u0627\u0621 - \u0645\u0637\u0627\u0628\u0642 \u0648\u0644\u064a\u0633 \u0627\u062f\u0639\u0627\u0621 \u0645\u0634\u0647\u062f \u062a\u0627\u0631\u064a\u062e\u064a.\n\u0627\u0644\u0631\u0641\u0636 \u0628\u0633\u0628\u0628 \u0635\u0648\u0631\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u0641\u0642\u0637."}