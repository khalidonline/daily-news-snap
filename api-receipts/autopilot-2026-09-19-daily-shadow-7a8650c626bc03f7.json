3\u0629 \u0639\u0628\u0631 \u062c\u0647\u0648\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0637\u064a\u0646\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u062d\u0645\u064a\u0627\u062a \u060c \u0641\u064a \u062e\u0637\u0648\u0629 \u062a\u0633\u062a\u0647\u062f\u0641 \u062f\u0639\u0645 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0623\u0646\u0648\u0627\u0639\n\u0627\u0644\u0641\u0637\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629. \u0648\u062a\u064f\u0639\u062f\u0651 \u0627\u0644\u0646\u0639\u0627\u0645\u0629 \u0623\u0643\u0628\u0631 \u0627\u0644\u0637\u064a\u0648\u0631 \u0627\u0644\u062d\u064a\u0629 \u062d\u062c\u0645\u064b\u0627 \u0648\u0648\u0632\u0646\u064b\u0627\u060c \u0648\u0623\u0633\u0631\u0639\u0647\u0627 \u0631\u0643\u0636\u064b\u0627\u060c \u0625\u0630 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0635\u0644 \u0633\u0631\u0639\u062a\u0647\u0627 \u0625\u0644\u0649 \u0646\u062d\u0648 70 \u0643\u064a\u0644\u0648\u0645\u062a\u0631\u064b\u0627 \u0641\u064a\n\u0627\u0644\u0633\u0627\u0639\u0629\u060c \u0641\u064a\u0645\u0627 \u064a\u0628\u0644\u063a \u0627\u0631\u062a\u0641\u0627\u0639\u0647\u0627 \u0646\u062d\u0648 2.7 \u0645\u062a\u0631\u060c \u0648\u064a\u0635\u0644 \u0648\u0632\u0646\u0647\u0627 \u0625\u0644\u0649 \u0642\u0631\u0627\u0628\u0629 150 \u0643\u064a\u0644\u0648\u062c\u0631\u0627\u0645\u064b\u0627\u060c \u0641\u064a \u062e\u0635\u0627\u0626\u0635 \u062c\u0633\u062f\u064a\u0629 \u062c\u0639\u0644\u062a\u0647\u0627 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0623\u0643\u062b\u0631 \u0627\u0644\u0637\u064a\u0648\u0631 \u062a\u0645\u064a\u0632\u064b\u0627\n\u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629. \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0637\u064a\u0646 \u0627\u0644\u0646\u0639\u0627\u0645 \u0641\u064a \u0645\u062d\u0645\u064a\u0627\u062a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 - \u0648\u0627\u0633 \u0648\u0644\u0627 \u062a\u0642\u062a\u0635\u0631 \u0641\u0631\u0627\u062f\u0629 \u0627\u0644\u0646\u0639\u0627\u0645\u0629 \u0639\u0644\u0649 \u062d\u062c\u0645\u0647\u0627 \u0648\u0633\u0631\u0639\u062a\u0647\u0627\u061b \u0641\u0647\u064a \u062a\u0646\u062a\u062c \u0643\u0630\u0644\u0643 \u0623\u0643\u0628\u0631 \u0628\u064a\u0636\u0629\n\u0648\u0647\u0648 \u0645\u0627 \u064a\u062c\u0639\u0644 \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0637\u064a\u0646\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u062d\u0645\u064a\u0627\u062a \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062e\u0637\u0648\u0629 \u0645\u0647\u0645\u0629 \u0636\u0645\u0646 \u062c\u0647\u0648\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u0623\u0647\u064a\u0644 \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0628\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0645\u0647\u062f\u062f\u0629 \u0628\u0627\u0644\u0627\u0646\u0642\u0631\u0627\u0636 \u0641\u064a", "retrieved_text_sha256": "9ed8fd83fec61df7c599a2e5e21dd296f95be160f30ea1088302ceffa2532f6e"}, {"id": "wiki-5720637", "url": "https://en.wikipedia.org/?curid=5720637", "text": "The Arabian ostrich (Struthio camelus syriacus), Syrian ostrich, or Middle Eastern ostrich is an extinct subspecies of the common ostrich that lived\nhave been continuous in prehistoric times, but with the drying-up of the Arabian Peninsula, it disappeared from the inhospitable areas of the\nSaudi Arabia, Jordan, Iraq and Syria meet. Once common in the Negev, ostriches became extinct in the region in the 1920s as", "retrieved_text_sha256": "df426a8430369f862add17da07179f43f474a5c28631dbb4272d9294e0e49a48"}, {"id": "verified-feed-time", "url": "https://www.alyaum.com/articles/6683301/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D9%85%D9%86%D9%88%D8%B9%D8%A7%D8%AA/%D8%A8%D8%B9%D8%AF-%D8%BA%D9%8A%D8%A7%D8%A8-%D8%B9%D9%86-%D8%A7%D9%84%D8%AC%D8%B2%D9%8A%D8%B1%D8%A9-%D8%A7%D9%84%D8%B9%D8%B1%D8%A8%D9%8A%D8%A9-%D8%A5%D8%B9%D8%A7%D8%A