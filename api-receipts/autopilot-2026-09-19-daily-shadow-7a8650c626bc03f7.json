u0645\u0627\u064b \u0648\u0648\u0632\u0646\u0627\u064b \u0648\u0623\u0633\u0631\u0639\u0647\u0627 \u0631\u0643\u0636\u0627\u064b\u060c \u0625\u0630 \u062a\u0635\u0644 \u0633\u0631\u0639\u062a\u0647\u0627 \u0625\u0644\u0649 \u0646\u062d\u0648 70 \u0643\u0645 \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629", "source_id": "article", "quote": "\u0627\u0644\u0641\u0637\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629. \u0648\u062a\u064f\u0639\u062f\u0651 \u0627\u0644\u0646\u0639\u0627\u0645\u0629 \u0623\u0643\u0628\u0631 \u0627\u0644\u0637\u064a\u0648\u0631 \u0627\u0644\u062d\u064a\u0629 \u062d\u062c\u0645\u064b\u0627 \u0648\u0648\u0632\u0646\u064b\u0627\u060c \u0648\u0623\u0633\u0631\u0639\u0647\u0627 \u0631\u0643\u0636\u064b\u0627\u060c \u0625\u0630 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0635\u0644 \u0633\u0631\u0639\u062a\u0647\u0627 \u0625\u0644\u0649 \u0646\u062d\u0648 70 \u0643\u064a\u0644\u0648\u0645\u062a\u0631\u064b\u0627 \u0641\u064a", "passage_id": "article:p12"}, {"id": "c6", "fact": "\u064a\u0628\u0644\u063a \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0646\u0639\u0627\u0645\u0629 \u0646\u062d\u0648 2.7 \u0645\u062a\u0631 \u0648\u0648\u0632\u0646\u0647\u0627 \u0642\u0631\u0627\u0628\u0629 150 \u0643\u064a\u0644\u0648\u062c\u0631\u0627\u0645\u0627\u064b \u0631\u063a\u0645 \u0623\u0646\u0647\u0627 \u0641\u0642\u062f\u062a \u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0637\u064a\u0631\u0627\u0646", "source_id": "article", "quote": "\u0627\u0644\u0633\u0627\u0639\u0629\u060c \u0641\u064a\u0645\u0627 \u064a\u0628\u0644\u063a \u0627\u0631\u062a\u0641\u0627\u0639\u0647\u0627 \u0646\u062d\u0648 2.7 \u0645\u062a\u0631\u060c \u0648\u064a\u0635\u0644 \u0648\u0632\u0646\u0647\u0627 \u0625\u0644\u0649 \u0642\u0631\u0627\u0628\u0629 150 \u0643\u064a\u0644\u0648\u062c\u0631\u0627\u0645\u064b\u0627\u060c \u0641\u064a \u062e\u0635\u0627\u0626\u0635 \u062c\u0633\u062f\u064a\u0629 \u062c\u0639\u0644\u062a\u0647\u0