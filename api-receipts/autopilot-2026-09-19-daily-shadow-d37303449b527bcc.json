%A7%D8%B6-%D9%88%D8%A7%D9%84%D8%AE%D8%B1%D8%AC", "summary": "\u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/Go3VPCZs0l \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026", "published_at": "2026-09-19T03:19:00+03:00", "editorial": {"id": "145adf38d8958e47", "why_saudi": "\u0625\u0646\u0630\u0627\u0631\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0648\u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u062a\u062e\u0635 \u062d\u064a\u0627\u0629 \u0627\u0644\u0646\u0627\u0633 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u0645\u0628\u0627\u0634\u0631\u0629", "why_now": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0623\u0637\u0644\u0642 \u0625\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631 \u062b\u0645 \u0623\u0639\u0644\u0646 \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u0628\u0639\u062f \u062d\u0627\u0644\u0629 \u0645\u0637\u0631\u064a\u0629 \u0645\u0641\u0627\u062c\u0626\u0629", "angle": "\u0643\u064a\u0641 \u062a\u0634\u062a\u063a\u0644 \u0645\u0646\u0635\u0629 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0627\u0644\u0644\u064a \u062a\u0646\u0628\u0647 \u0627\u0644\u0646\u0627\u0633 \u0642\u0628\u0644 \u0627\u0644\u0633\u064a\u0648\u0644 \u0628\u062f\u0642\u0627\u0626\u0642", "share_reason": "\u0645\u0648\u0636\u0648\u0639 \u064a\u0647\u0645 \u0643\u0644 \u0634\u062e\u0635 \u064a\u0639\u064a\u0634 \u0628\u0627\u0644\u0631\u064a\u0627\u0636 \u0623\u0648 \u064a\u062a\u0646\u0642\u0644 \u0641\u064a\u0647\u0627\u060c \u0648\u064a\u0648\u0636\u062d \u0641\u0627\u064a\u062f\u0629 \u0646\u0638\u0627\u0645 \u064a\u062d\u0645\u064a \u0627\u0644\u0646\u0627\u0633 \u0641\u0639\u0644\u064a\u0627\u064b", "research_query": "Saudi National Center for Meteorology early warning"}}, "reason": "BudgetBlocked", "sources": [{"id": "article", "url": "https://www.alyaum.com/articles/6683306/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%AF%D9%81%D8%A7%D8%B9-%D8%A7%D9%84%D9%85%D8%AF%D9%86%D9%8A-%D8%B2%D9%88%D8%A7%D9%84-%D8%A7%D9%84%D8%AE%D8%B7%D8%B1-%D8%B9%D9%86-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D9%88%D8%A7%D9%84%D8%AE%D8%B1%D8%AC", "text": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639\n\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629\n\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a\n\u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/Go3VPCZs0l \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026\n\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0623\u062e\u0628\u0627\u0631 \u0645\u062a\u0639\u0644\u0642\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a\n\u064a\u0637\u0644\u0642 \u062a\u0646\u0628\u064a\u0647\u064b\u0627 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u064a\u062d\u0630\u0631.. \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062a\u0633\u062a\u0645\u0631 6 \u0623\u064a\u0627\u0645 \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629\n\u0627\u0644\u0623\u0645\u0646\u064a\u0629 \u064a\u0648\u062c\u0628 \u0627\u0644\u0639\u0642\u0648\u0628\u0629.. \u0644\u0627 \u062a\u0635\u0648\u0651\u0631 \u0648\u0644\u0627 \u062a\u0646\u0634\u0631 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0632\u064a\u062f \u0627\u0643\u062b\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u064a\u0648\u0645 \u0639\u0627\u062c\u0644: \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631", "retrieved_text_sha256": "948aa33aabf1a84adc76bf7eac4755756ff37c636f3690d7a5c2098861dcf1f6"}], "research": {"event_date": "2026-09-19", "sensitive": false, "claims": [{"id": "c1", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0623\u0639\u0644\u0646 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u0628\u0639\u062f \u062d\u0627\u0644\u0629 \u062a\u0646\u0628\u064a\u0647 \u0633\u0627\u0628\u0642\u0629.", "source_id": "article", "quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639", "passage_id": "article:p9"}, {"id": "c2", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0646\u0634\u0631 \u062a\u0646\u0628\u064a\u0647 \u0631\u0633\u0645\u064a \u064a\u0641\u064a\u062f \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0648\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0646\u0627\u0633 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a\u0647 \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631.", "source_id": "article", "quote": "\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629", "passage_id": "article:p12"}, {"id": "c3", "fact": "\u0641\u064a \u062d\u0627\u0644 \u0648\u062c\u0648\u062f \u0623\u064a \u0637\u0627\u0631\u0626 \u0628\u0639\u062f \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631\u060c \u062d\u062f\u062f \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0631\u0642\u0645 911 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0633\u0631\u064a\u0639.", "source_id": "article", "quote": "\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a", "passage_id": "article:p13"}, {"id": "c4", "fact": "\u0646\u0641\u0633 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0635\u062f\u0631 \u0623\u064a\u0636\u0627\u064b \u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c \u0645\u0639 \u062a\u0643\u0631\u0627\u0631 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0640911 \u0641\u064a \u0627\u0644\u0637\u0648\u0627\u0631\u0626.", "source_id": "article", "quote": "\u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/Go3VPCZs0l \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026", "passage_id": "article:p14"}, {"id": "c5", "fact": "\u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0641\u062a\u0631\u0629\u060c \u0623\u0635\u062f\u0631 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0634\u0627\u0628\u0647\u0629 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u0646 \u0623\u062e\u0631\u0649 \u0645\u062b\u0644 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627.", "source_id": "article", "quote": "\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0623\u062e\u0628\u0627\u0631 \u0645\u062a\u0639\u0644\u0642\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a", "passage_id": "article:p10"}, {"id": "c6", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0643\u0627\u0646 \u0642\u062f \u062d\u0630\u0631 \u0633\u0627\u0628\u0642\u0627\u064b \u0645\u0646 \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0645\u062a\u0648\u0642\u0639\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0644\u0645\u062f\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 6 \u0623\u064a\u0627\u0645.", "source_id": "article", "quote": "\u064a\u0637\u0644\u0642 \u062a\u0646\u0628\u064a\u0647\u064b\u0627 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u064a\u062d\u0630\u0631.. \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062a\u0633\u062a\u0645\u0631 6 \u0623\u064a\u0627\u0645 \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629", "passage_id": "article:p11"}, {"id": "c7", "fact": "\u0642\u0628\u0644 \u062a\u0646\u0628\u064a\u0647 \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631\u060c \u0623\u0635\u062f\u0631 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0625\u0646\u0630\u0627\u0631\u0627\u064b \u0645\u0628\u0643\u0631\u0627\u064b \u0639\u0627\u062c\u0644\u0627\u064b \u0643\u062c\u0632\u0621 \u0645\u0646 \u0646\u0638\u0627\u0645\u0647 \u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0646\u0627\u0633 \u0642\u0628\u0644 \u0648\u0642\u0648\u0639 \u0627\u0644\u062e\u0637\u0631.", "source_id": "article", "quote": "\u0627\u0644\u0623\u0645\u0646\u064a\u0629 \u064a\u0648\u062c\u0628 \u0627\u0644\u0639\u0642\u0648\u0628\u0629.. \u0644\u0627 \u062a\u0635\u0648\u0651\u0631 \u0648\u0644\u0627 \u062a\u0646\u0634\u0631 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0632\u064a\u062f \u0627\u0643\u062b\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u064a\u0648\u0645 \u0639\u0627\u062c\u0644: \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631", "passage_id": "article:p19"}], "event_source_id": "article", "event_quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639"}, "draft": {"title": "\u0646\u0638\u0627\u0645 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0644\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0645\u0646 \u0627\u0644\u0623\u0645\u0637\u0627\u0631", "cards": [{"kind": "info", "title": "\u0625\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631 \u0642\u0628\u0644 \u0627\u0644\u062e\u0637\u0631 \u0628\u062f\u0642\u0627\u0626\u0642", "body": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0639\u0646\u062f\u0647 \u0646\u0638\u0627\u0645 \u064a\u0635\u062f\u0631 \u0625\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631 \u0639\u0627\u062c\u0644 \u064a\u0648\u0635\u0644 \u0644\u0644\u0646\u0627\u0633 \u0639\u0628\u0631 \u062a\u0648\u064a\u062a\u0631 \u0648\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0642\u0628\u0644 \u0645\u0627 \u064a\u0635\u064a\u0631 \u0627\u0644\u062e\u0637\u0631 \u0641\u0639\u0644\u064a\u0627\u064b\u060c \u0641\u064a\u0647 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0631\u0642\u0645 \u0644\u0644\u0637\u0648\u0627\u0631\u0626.", "punch": "", "claim_ids": ["c7"], "image_query": "clouds sky storm", "image": {"provider": "commons", "asset_id": "179942626", "title": "File:Storm clouds and clear sky.jpg", "description": "In the picture you can see the sky which is half clear (left side of the picture) and half with stormy clouds (right side of the picture). This image is special because it shows a beautiful transition from clear sky to completely cloudy sky.", "download_url": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Storm_clouds_and_clear_sky.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled", "original_url": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Storm_clouds_and_clear_sky.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Storm_clouds_and_clear_sky.jpg", "credit": "Cristian Butacu", "credit_line": "Own work", "license": "CC0", "license_url": "http://creativecommons.org/publicdomain/zero/1.0/deed.en", "attribution_required": "false", "restrictions": "", "date_created": "2023-03-29", "width": 1200, "height": 1600, "licensing_verified": false, "sha256": "6f1d8f524646697285bf4d130132766437871362914fc2b7fb1c1a3d3b751ac7"}}, {"kind": "story", "title": "\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c", "body": "\u0628\u0639\u062f \u0625\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631 \u0639\u0646 \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0645\u062a\u0648\u0642\u0639\u0629 \u062a\u0633\u062a\u0645\u0631 \u0623\u064a\u0627\u0645\u060c \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0628\u062a \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c.", "punch": "", "claim_ids": ["c1", "c6"], "image_query": "rain clouds desert", "image": {"provider": "commons", "asset_id": "105649817", "title": "File:Sky Clouds Sea.jpg", "description": "Sky Clouds Atmosphere Sun Sunset Landscape Cloud Sunrise Weather Horizon Cloudscape Sunlight Summer Light Heaven Tranquil Environment Day Water Travel Dusk Scene Silhouette Orange Outdoors Scenic Clear Bright Sea Color Season Evening Outdoor High Storm Scenery Climate Sunshine Air Peace Dawn Natural Peaceful Dark Morning Fluffy Cloudy Sunny Lake Space Ocean Star Reflection Nature Azure Sky Cumulus Vehicle Transportation Airplane Aircraft Land Red Sky Shoreline Coast", "download_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Sky_Clouds_Sea.jpg/1920px-Sky_Clouds_Sea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "original_url": "https://upload.wikimedia.org/wikipedia/commons/a/ae/Sky_Clouds_Sea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Sky_Clouds_Sea.jpg", "credit": "Unknown author Unknown author", "credit_line": "https://pikwizard.com/photo/sky-clouds-atmosphere/9a4bdc717bb3439e60e34fad639893dd", "license": "CC0", "license_url": "http://creativecommons.org/publicdomain/zero/1.0/deed.en", "attribution_required": "false", "restrictions": "", "date_created": "2016-05-29 06:16:03", "width": 1600, "height": 1067, "licensing_verified": false, "sha256": "a508df4f52d6c1d20c216b135f7ea76a293c99611cb9e1985c663a715194e133"}}, {"kind": "story", "title": "\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u062a\u0633\u062a\u0645\u0631 \u062d\u062a\u0649 \u0628\u0639\u062f \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631", "body": "\u0645\u0639 \u062a\u0646\u0628\u064a\u0647 \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631\u060c \u0634\u062f\u062f \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0639\u0644\u0649 \u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631\u060c \u0648\u062e\u0635\u0635 \u0631\u0642\u0645 911 \u0644\u0623\u064a \u0637\u0627\u0631\u0626 \u064a\u0637\u0631\u0623 \u0628\u0639\u062f\u0647\u0627.", "punch": "", "claim_ids": ["c2", "c3", "c4"], "image_query": "dust storm Arabia", "image": {"provider": "commons", "asset_id": "145317551", "title": "File:Dust storm in Saudi Arabia (MODIS 2015-04-13).jpg", "description": "The Moderate Resolution Imaging Spectroradiometer (MODIS) that flies aboard NASA's Terra satellite captured a true-color image of a massive wall of dust pushing southeast across the Arabian Peninsula on April 2, 2015. The wall of tan dust snakes for hundreds of kilometers across the region near the Saudi Arabia \ufffd Yemen border. Ahead of the moving wall, the air is clear and the land can be seen in detail. Behind that line, however, the ground is completely obscured by a thick blanket of choking sand and dust. The sandstorm disrupted flights across the region, including Dubai\ufffds two international airports. Many schools across the region, including all private and independent school and several universities in Qatar were closed due to the \ufffdextreme weather conditions\ufffd according to Emirates 24/7 News. The storm was blamed on a high pressure system over Saudi Arabia.", "download_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Dust_storm_in_Saudi_Arabia_%28MODIS_2015-04-13%29.jpg/1920px-Dust_storm_in_Saudi_Arabia_%28MODIS_2015-04-13%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "original_url": "https://upload.wikimedia.org/wikipedia/commons/3/32/Dust_storm_in_Saudi_Arabia_%28MODIS_2015-04-13%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Dust_storm_in_Saudi_Arabia_(MODIS_2015-04-13).jpg", "credit": "Jeff Schmaltz, MODIS Land Rapid Response Team, NASA GSFC", "credit_line": "This image or video was catalogued by Goddard Space Flight Center of the United States National Aeronautics and Space Administration (NASA) under Photo ID: 2015-04-13 .", "license": "Public domain", "license_url": "", "attribution_required": "false", "restrictions": "", "date_created": "Taken on 2 April 2015", "width": 1600, "height": 1771, "licensing_verified": false, "sha256": "01071770f349d3fd132a58af92ff8cea68f76713e945be11979e4901092abfc9"}}, {"kind": "story", "title": "\u0646\u0641\u0633 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0641\u064a \u0645\u062f\u0646 \u0623\u062e\u0631\u0649", "body": "\u0645\u0648 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u0641\u0642\u0637\u060c \u0646\u0641\u0633 \u0646\u0648\u0639 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0635\u062f\u0631\u062a \u0644\u0645\u062f\u0646 \u0632\u064a \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u062e\u0644\u0627\u0644 \u0646\u0641\u0633 \u0627\u0644\u0641\u062a\u0631\u0629.", "punch": "", "claim_ids": ["c5"], "image_query": "clouds sky storm", "image": {"provider": "commons", "asset_id": "145434883", "title": "File:Dust storm in Saudi Arabia (MODIS 2018-02-22).jpg", "description": "Strong sandstorms rolled across parts of Saudi Arabia in mid-February 2018, closing schools and universities and creating a nightmare for drivers. According to WeatherBug, the storm brought visibility in Riyadh to \u201cjust a few meters\u201d on February 14, while two days earlier Arab News reported a \u201cnear-total lack of horizontal visibility all over Jeddah\u201d. By February 15, government authorities had advised the population in affected areas to stay home whenever possible, and to exercise \u201cextreme caution\u201d when driving or walking. The storms, which started on February 12, enveloped much of the western section of Saudi Arabia and have continued through February 21, although intensity has decreased. The Moderate Resolution Imaging Spectroradiometer (MODIS) aboard NASA\u2019s Aqua satellite acquired a true-color image of a portion of Saudi Arabia on February 14. The rolling dust storm stretched from the Persian Gulf (east) to the Red Sea (west). Dust storms are common in this region and are recognized as one of the major natural hazards affecting Saudi Arabia.", "download_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/Dust_storm_in_Saudi_Arabia_%28MODIS_2018-02-22%29.jpg/1920px-Dust_storm_in_Saudi_Arabia_%28MODIS_2018-02-22%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "original_url": "https://upload.wikimedia.org/wikipedia/commons/d/d3/Dust_storm_in_Saudi_Arabia_%28MODIS_2018-02-22%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "source_url": "https://commons.wikimedia.org/wiki/File:Dust_storm_in_Saudi_Arabia_(MODIS_2018-02-22).jpg", "credit": "Jeff Schmaltz, MODIS Land Rapid Response Team, NASA GSFC", "credit_line": "This image or video was catalogued by Goddard Space Flight Center of the United States National Aeronautics and Space Administration (NASA) under Photo ID: 2018-02-22 .", "license": "Public domain", "license_url": "", "attribution_required": "false", "restrictions": "", "date_created": "Taken on 14 February 2018", "width": 1600, "height": 1231, "licensing_verified": false, "sha256": "48de9295a47655d64664b70f29aa12efc45aa05df2e34b368148c4152195f38f"}}]}}