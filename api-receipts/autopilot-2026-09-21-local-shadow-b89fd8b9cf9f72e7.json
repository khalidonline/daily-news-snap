u0634\u064f\u063a\u0651\u0644\u062a 90 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636\u060c \u0648\u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0645\u0648\u0632\u0639\u0629 \u0628\u064a\u0646 \u0628\u0631\u0627\u0645\u062c \u062a\u0631\u0641\u064a\u0647\u064a\u0629 \u0648\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u062a\u0631\u0627\u062b\u064a\u0629.", "source_id": "article", "quote": "\u0627\u0644\u0625\u0646\u0627\u0631\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u062a\u0634\u063a\u064a\u0644 90 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636\u060c \u0648\u062a\u062a\u0648\u0632\u0639 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062a\u0631\u0641\u064a\u0647\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629 \u0644\u062a\u0647\u064a\u0626\u0629 \u0628\u064a\u0626\u0629 \u0627\u062d\u062a\u0641\u0627\u0644\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629. \u0648\u0623\u0648\u0636\u062d \u0645\u062f\u064a\u0631 \u0639\u0627\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629", "passage_id": "article:p17"}, {"id": "c6", "fact": "\u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0644\u0623\u0645\u0627\u0646\u0629 \u0641\u064a\u0635\u0644 \u0627\u0644\u0632\u0647\u0631\u0627\u0646\u064a \u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u062a\u0647\u064a\u0626\u0629 \u0634\u0645\u0644\u062a \u0627\u0644\u0637\u0631\u0642 \u0648\u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a \u0648\u0645\u0636\u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0634\u064a \u0648\u0627\u0644\u062d\u062f\u0627\u0626\u0642 \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u0623\u0647\u0627\u0644\u064a \u0648\u0627\u0644\u0632\u0648\u0627\u0631.", "source_id": "article", "quote": "\u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0637\u0631\u0642\u060c \u0648\u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a\u060c \u0648\u0645\u0636\u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0634\u064a\u060c \u0648\u0627\u0644\u062d\u062f\u0627\u0626\u0642\u060c \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u0623\u0647\u0627\u0644\u064a \u0648\u0627\u0644\u0632\u0648\u0627\u0631. \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645", "passage_id": "article:p20"}, {"id": "c7", "fact": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0623\u0643\u0628\u0631 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0645\u0633\u0627\u062d\u0629 \u0648\u062b\u0627\u0644\u062b \u0623\u0643\u062b\u0631\u0647\u0627 \u0633\u0643\u0627\u0646\u0627\u064b \u0628\u0639\u062f \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0645\u0643\u0629\u060c \u0648\u0639\u062f\u062f \u0633\u0643\u0627\u0646\u0647\u0627 5,125,254 \u062d\u0633\u0628 \u0625\u062d\u0635\u0627\u0621 2022.", "source_id": "wiki-468721", "quote": "is the nation's largest province by area and the third most populous after Riyadh and Mecca provinces. As of 2022, the population", "passage_id": "wiki-468721:p1"}, {"id": "c8", "fact": "\u0623\u0643\u062b\u0631 \u0645\u0646 \u062b\u0644\u062b \u0633\u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u064a\u062a\u0631\u0643\u0632\u0648\u0646 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062f\u0645\u0627\u0645 \u0627\u0644\u062d\u0636\u0631\u064a\u0629\u060c \u0648\u0627\u0644\u062f\u0645\u0627\u0645 \u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0648\u0623\u0643\u0628\u0631 \u0645\u062f\u0646\u0647\u0627 \u0628\u0646\u062d\u0648 1.53 \u0645\u0644\u064a\u0648\u0646 \u0646\u0633\u0645\u0629 \u0641\u064a 2022.", "source_id": "wiki-468721", "quote": "concentrated in the Dammam metropolitan area. With an estimated population of 1.53 million as of 2022, Dammam, the capital and largest city", "passage_id": "wiki-468721:p3"}], "event_source_id": "article", "event_quote": "\u062a\u062a\u0632\u064a\u0646 \u0627\u062d\u062a\u0641\u0627\u0621\u064b \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0631\u0627\u0626\u062f \u0627\u0644\u0633\u0648\u064a\u0644\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/21 12:20 \u0623\u0646\u0647\u062a \u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u0627\u062a\u0647\u0627 \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0621 \u0628 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u060c \u0645\u062a\u0648\u0634\u062d\u0629 \u0628\u0640"}, "draft": {"title": "\u0648\u0631\u0627\u0621 \u0632\u064a\u0646\u0629 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0641\u064a \u0627\u0644\u0634\u0631\u0642\u064a\u0629.. 15 \u0623\u0644\u0641 \u0639\u0644\u0645 \u064870 \u0641\u0639\u0627\u0644\u064a\u0629", "cards": [{"kind": "info", "title": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629: \u0627\u0644\u0623\u0643\u0628\u0631 \u0645\u0633\u0627\u062d\u0629 \u0648\u062b\u0644\u062b \u0633\u0643\u0627\u0646\u0647\u0627 \u0641\u064a \u0627\u0644\u062f\u0645\u0627\u0645", "body": "\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0623\u0643\u0628\u0631 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0645\u0646 \u0646\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0633\u0627\u062d\u0629\u060c \u0648\u062b\u0627\u0644\u062b \u0623\u0643\u062b\u0631\u0647\u0627 \u0633\u0643\u0627\u0646\u0627\u064b \u0628\u0639\u062f \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0645\u0643\u0629\u060c \u0648\u0639\u062f\u062f \u0633\u0643\u0627\u0646\u0647\u0627 5,125,254 \u0646\u0633\u0645\u0629 \u062d\u0633\u0628 \u0625\u062d\u0635\u0627\u0621 2022. \u0648\u0627\u0644\u0644\u0627\u0641\u062a \u0623\u0646 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062b\u0644\u062b \u0647\u0624\u0644\u0627\u0621 \u064a\u062a\u0631\u0643\u0632\u0648\u0646 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062f\u0645\u0627\u0645 \u0627\u0644\u062d\u0636\u0631\u064a\u0629 \u0648\u062d\u062f\u0647\u0627\u060c \u0648\u0627\u0644\u062f\u0645\u0627\u0645 \u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0648\u0623\u0643\u0628\u0631 \u0645\u062f\u0646\u0647\u0627 \u0628\u0646\u062d\u0648 1.53 \u0645\u0644\u064a\u0648\u0646 \u0646\u0633\u0645\u0629.", "punch": "\u064a\u0639\u0646\u064a \u0645\u0633\u0627\u062d\u0629 \u0647\u0627\u0626\u0644\u0629\u060c \u0644\u0643\u0646 \u0627\u0644\u0643\u062b\u0627\u0641\u0629 \u0641\u064a \u0628\u0642\u0639\u0629 \u0648\u062d\u062f\u0629.", "claim_ids": ["c7", "c8"], "image_query": "Dammam Saudi Arabia"}, {"kind": "story", "title": "\u0627\u0644\u0632\u064a\u0646\u0629 \u0627\u0644\u0644\u064a \u062a\u0645\u0631 \u0639\u0644\u064a\u0647\u0627 \u0628\u0627\u0644\u0634\u0627\u0631\u0639 \u0648\u0631\u0627 15 \u0623\u0644\u0641 \u0639\u0644\u0645", "body": "\u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0623\u0646\u0647\u062a \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u0627\u062a\u0647\u0627 \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0621 \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a\u060c \u0648\u062a\u0648\u0634\u062d\u062a \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0628\u064015 \u0623\u0644\u0641 \u0639\u0644\u0645 \u0648\u0637\u0646\u064a. \u0648\u0645\u0639\u0647\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 70 \u0641\u0639\u0627\u0644\u064a\u0629 \u0648\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0648\u0632\u0639\u0629 \u0639\u0644\u0649 \u0646\u062d\u0648 30 \u0645\u0648\u0642\u0639 \u0641\u064a \u0645\u062f\u0646 \u0648\u0645\u062d\u0627\u0641\u0638\u0627\u062a \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0645\u0648 \u0641\u064a \u0645\u0643\u0627\u0646 \u0648\u0627\u062d\u062f.", "punch": "\u0648\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0648\u0631\u0627\u0647\u0627 \u0623\u0643\u062b\u0631.", "claim_ids": ["c1"], "image_query": "Saudi flag"}, {"kind": "story", "title": "\u0627\u0644\u062a\u062c\u0647\u064a\u0632\u0627\u062a \u062c\u0627\u062a \u0648\u0641\u0642 \u062a\u0648\u062c\u064a\u0647\u0627\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u0644\u062f\u064a\u0627\u062a \u0648\u0627\u0644\u0625\u0633\u0643\u0627\u0646", "body": "\u0627\u0644\u062a\u062c\u0647\u064a\u0632\u0627\u062a \u0646\u064f\u0641\u0630\u062a \u0648\u0641\u0642 \u062a\u0648\u062c\u064a\u0647\u0627\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u0644\u062f\u064a\u0627\u062a \u0648\u0627\u0644\u0625\u0633\u0643\u0627\u0646\u060c \u0648\u0634\u0645\u0644\u062a \u062a\u0631\u0643\u064a\u0628 50 \u0628\u0646\u0631 \u0639\u0644\u0649 \u062c\u0633\u0648\u0631 \u0627\u0644\u0645\u0634\u0627\u0629 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a\u060c \u0648400 \u0625\u0636\u0627\u0621\u0629 \u0623\u0633\u0641\u0644 \u0627\u0644\u062c\u0633\u0648\u0631 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a. \u0648\u0641\u0648\u0642 \u0630\u0644\u0643 \u0646\u064f\u0634\u0631\u062a 250 \u0644\u0648\u062d\u0629 \u0625\u0639\u0644\u0627\u0646\u064a\u0629\u060c \u0648750 \u0644\u0648\u062d\u0629 \u0639\u0644\u0649 \u0623\u0639\u0645\u062f\u0629 \u0627\u0644\u0625\u0646\u0627\u0631\u0629 \u0641\u064a \u0627\u0644\u0634\u0648\u0627\u0631\u0639.", "punch": "", "claim_ids": ["c2", "c3"], "image_query": "street light banners"}, {"kind": "story", "title": "\u0645\u0646 \u0627\u0644\u0645\u064a\u0627\u062f\u064a\u0646 \u0644\u0644\u062d\u062f\u0627\u0626\u0642 \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629", "body": "\u0627\u0644\u0645\u064a\u0627\u062f\u064a\u0646 \u0648\u0627\u0644\u0637\u0631\u0642 \u062c\u064f\u0647\u0632\u062a \u0628\u0640200 \u0645\u062c\u0633\u0645 \u062c\u0645\u0627\u0644\u064a \u0648200 \u0632\u064a\u0646\u0629 \u0644\u0623\u0639\u0645\u062f\u0629 \u0627\u0644\u0625\u0646\u0627\u0631\u0629\u060c \u0648\u0634\u064f\u063a\u0651\u0644\u062a 90 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636\u060c \u0648\u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0645\u0648\u0632\u0639\u0629 \u0628\u064a\u0646 \u0628\u0631\u0627\u0645\u062c \u062a\u0631\u0641\u064a\u0647\u064a\u0629 \u0648\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u062a\u0631\u0627\u062b\u064a\u0629. \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0644\u0623\u0645\u0627\u0646\u0629 \u0641\u064a\u0635\u0644 \u0627\u0644\u0632\u0647\u0631\u0627\u0646\u064a \u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u062a\u0647\u064a\u0626\u0629 \u0634\u0645\u0644\u062a \u0627\u0644\u0637\u0631\u0642 \u0648\u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a \u0648\u0645\u0636\u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0634\u064a \u0648\u0627\u0644\u062d\u062f\u0627\u0626\u0642 \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u0623\u0647\u0627\u0644\u064a \u0648\u0627\u0644\u0632\u0648\u0627\u0631.", "punch": "\u064a\u0639\u0646\u064a \u0627\u0644\u0645\u0634\u0647\u062f \u0643\u0627\u0645\u0644 \u0645\u0639\u0645\u0648\u0644 \u0628\u062d\u0633\u0627\u0628\u060c \u0645\u0648 \u0635\u062f\u0641\u0629.", "claim_ids": ["c4", "c5", "c6"], "image_query": "city square Saudi"}]}}