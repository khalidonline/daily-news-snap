645\u0646\u0637\u0642\u0629. \u0648\u0634\u0645\u0644\u062a\n\u0627\u0644\u062a\u062c\u0647\u064a\u0632\u0627\u062a\u060c \u0627\u0644\u0645\u0646\u0641\u0630\u0629 \u0648\u0641\u0642 \u062a\u0648\u062c\u064a\u0647\u0627\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u0644\u062f\u064a\u0627\u062a \u0648\u0627\u0644\u0625\u0633\u0643\u0627\u0646\u060c \u062a\u0631\u0643\u064a\u0628 50 \u0628\u0646\u0631\u0627\u064b \u0639\u0644\u0649 \u062c\u0633\u0648\u0631 \u0627\u0644\u0645\u0634\u0627\u0629 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a\u060c \u0648400 \u0625\u0636\u0627\u0621\u0629 \u0623\u0633\u0641\u0644 \u0627\u0644\u062c\u0633\u0648\u0631 \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a. \u0623\u062e\u0628\u0627\u0631 \u0645\u062a\u0639\u0644\u0642\u0629 \u0627\u0644\u064a\u0648\u0645\n\u0645\u062a\u0631 \u064827 \u0623\u0644\u0641 \u0645\u00b2.. \u062a\u0637\u0648\u064a\u0631 \u0645\u0636\u0645\u0627\u0631 \u0645\u0634\u064a \u0637\u0631\u064a\u0642 \u0627\u0644\u0623\u0645\u064a\u0631 \u062a\u0631\u0643\u064a \u0628\u0627\u0644\u062e\u0628\u0631 \u0648\u062a\u0636\u0645\u0646\u062a \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0646\u0634\u0631 250 \u0644\u0648\u062d\u0629 \u0625\u0639\u0644\u0627\u0646\u064a\u0629\u060c \u0648750 \u0644\u0648\u062d\u0629 \u0639\u0644\u0649 \u0623\u0639\u0645\u062f\u0629 \u0627\u0644\u0625\u0646\u0627\u0631\u0629.\n\u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u062a\u062a\u0632\u064a\u0646 \u0627\u062d\u062a\u0641\u0627\u0621\u064b \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0645\u064a\u0627\u062f\u064a\u0646 \u0643\u0645\u0627 \u062c\u0647\u0632\u062a \u0627\u0644\u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u0645\u064a\u0627\u062f\u064a\u0646 \u0648\u0627\u0644\u0637\u0631\u0642 \u0628\u0640 200 \u0645\u062c\u0633\u0645 \u062c\u0645\u0627\u0644\u064a\u060c \u0648200 \u0632\u064a\u0646\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0623\u0639\u0645\u062f\u0629\n\u0627\u0644\u0625\u0646\u0627\u0631\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u062a\u0634\u063a\u064a\u0644 90 \u0634\u0627\u0634\u0629 \u0639\u0631\u0636\u060c \u0648\u062a\u062a\u0648\u0632\u0639 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062a\u0631\u0641\u064a\u0647\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629 \u0644\u062a\u0647\u064a\u0626\u0629 \u0628\u064a\u0626\u0629 \u0627\u062d\u062a\u0641\u0627\u0644\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629. \u0648\u0623\u0648\u0636\u062d \u0645\u062f\u064a\u0631 \u0639\u0627\u0645 \u0627\u0644\u0625\u062f\u0627\u0631\u0629\n\u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0637\u0631\u0642\u060c \u0648\u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a\u060c \u0648\u0645\u0636\u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0634\u064a\u060c \u0648\u0627\u0644\u062d\u062f\u0627\u0626\u0642\u060c \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0631\u0627\u062b\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u0623\u0647\u0627\u0644\u064a \u0648\u0627\u0644\u0632\u0648\u0627\u0631. \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645\n\u062a\u062a\u0632\u064a\u0646 \u0627\u062d\u062a\u0641\u0627\u0621\u064b \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0631\u0627\u0626\u062f \u0627\u0644\u0633\u0648\u064a\u0644\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 20