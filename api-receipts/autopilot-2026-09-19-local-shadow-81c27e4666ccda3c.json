41\u0631\u0646\u0633\u064a\u0629 \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0644\u0645\u064a\u0646\u0627\u0621 \u0627\u0644\u0645\u062e\u0627 \u0633\u0646\u0629 1737 \u0628\u0633\u0641\u0646 \u0648\u0645\u062e\u0637\u0637 \u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0648\u0647\u064a \u0633\u064a\u0627\u0642 \u062a\u0627\u0631\u064a\u062e\u064a \u0635\u062d\u064a\u062d \u0644\u0627\u062f\u0639\u0627\u0621 \u0623\u0635\u0644 \u0627\u0644\u0642\u0647\u0648\u0629 \u0645\u0646 \u0627\u0644\u0645\u062e\u0627 \u0625\u0644\u0649 \u0645\u0643\u0629 \u0648\u0645\u0635\u0631 \u0648\u0627\u0644\u0634\u0627\u0645. \u0627\u0644\u0631\u0641\u0636 \u0644\u0633\u0628\u0628\u064a\u0646 \u0628\u0635\u0631\u064a\u064a\u0646: (\u0623) \u0627\u0644\u0628\u0637\u0627\u0642\u0629 2 \u0635\u0648\u0631\u062a\u0647\u0627 \u0644\u0648\u0627\u062c\u0647\u0629 \u0645\u062e\u0628\u0632 \u063a\u0631\u0628\u064a \u0641\u064a\u0647\u0627 \u0643\u0639\u0643 \u0645\u0644\u0641\u0648\u0641 \u0648\u0643\u0631\u0648\u0627\u0633\u0648\u0646 \u0648\u0644\u0627\u0641\u062a\u0627\u062a \u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629/\u0633\u0648\u064a\u062f\u064a\u0629 \u0645\u0643\u062a\u0648\u0628 \u0639\u0644\u064a\u0647\u0627 KARDEMUMMABULLAR - CARDAMOM BUN \u0648 KANELBULLE - CINNAMON BUN \u0645\u0639 \u0623\u0633\u0639\u0627\u0631 \u0628\u0627\u0644\u062f\u0648\u0644\u0627\u0631 \u0648\u0639\u0627\u0645\u0644\u0629 \u062e\u0644\u0641 \u0627\u0644\u0632\u062c\u0627\u062c\u061b \u0647\u0630\u0627 \u0645\u062d\u0644 \u0648\u0645\u0646\u062a\u062c \u0623\u062c\u0646\u0628\u064a \u0645\u062e\u062a\u0644\u0641 \u062a\u0645\u0627\u0645\u064b\u0627 \u0648\u0644\u0627 \u064a\u0648\u0636\u062d \u0627\u0644\u0647\u064a\u0644 \u0641\u064a \u0627\u0644\u0642\u0647\u0648\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u064a\u0642\u062f\u0651\u0645 \u0643\u064a\u0627\u0646\u064b\u0627/\u0633\u064a\u0627\u0642\u064b\u0627 \u0622\u062e\u0631 \u0628\u062f\u064a\u0644\u064b\u0627 \u0639\u0646 \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0627\u0644\u0645\u0630\u0643\u0648\u0631. \u0627\u0644\u0628\u062f\u064a\u0644: \u0635\u0648\u0631\u0629 \u062d\u0628\u0627\u062a \u0647\u064a\u0644 \u0623\u0648 \u062f\u0644\u0629 \u0645\u0639 \u0641\u0646\u0627\u062c\u064a\u0646. (\u0628) \u0627\u0644\u0628\u0637\u0627\u0642\u0629 4 \u0635\u0648\u0631\u062a\u0647\u0627 \u0641\u0646\u062c\u0627\u0646 \u0623\u0628\u064a\u0636 \u0628\u0645\u0642\u0628\u0636 \u0645\u0645\u0644\u0648\u0621 \u0628\u0642\u0647\u0648\u0629 \u062f\u0627\u0643\u0646\u0629 \u0630\u0627\u062a \u0631\u063a\u0648\u0629 \u0628\u0646\u064a\u0629 \u0643\u062b\u064a\u0641\u0629\u060c \u0648\u0647\u0630\u0627 \u0634\u0643\u0644 \u0642\u0647\u0648\u0629 \u062a\u0631\u0643\u064a\u0629/\u0625\u0633\u0628\u0631\u064a\u0633\u0648 \u063a\u0627\u0645\u0636 \u0648\u0644\u064a\u0633 \u0627\u0644\u0642\u0647\u0648\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0641\u0627\u062a\u062d\u0629 \u0641\u064a \u0641\u0646\u062c\u0627\u0646 \u0628\u0644\u0627 \u0645\u0642\u0628\u0636\u061b \u064a\u062c\u0628 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0635\u0648\u0631\u0629 \u062f\u0644\u0629 \u0648\u0641\u0646\u0627\u062c\u064a\u0646 \u0628\u0644\u0627 \u0645\u0642\u0627\u0628\u0636 \u0623\u0648 \u062a\u0643\u0631\u0627\u0631 \u0635\u0648\u0631\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0627\u0644\u0648\u0627\u0636\u062d\u0629."}