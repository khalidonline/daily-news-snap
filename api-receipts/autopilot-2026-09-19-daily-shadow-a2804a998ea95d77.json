u0631\u064a \u0641\u0631\u0627\u0646\u0643 \u0643\u064a\u0633\u064a\u0647\u060c \u0648\u0647\u0645\u0627 \u0645\u0646 \u0623\u0628\u0631\u0632 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062a\u064a \u0627\u0631\u062a\u0628\u0637 \u0628\u0647\u0627 \u0627\u0644\u0641\u0631\u064a\u0642 \u062e\u0644\u0627\u0644\n\u062a\u0631\u0643 \u0631\u062d\u064a\u0644 \u0631\u064a\u0627\u0636 \u0645\u062d\u0631\u0632 \u0641\u0631\u0627\u063a\u0627\u064b \u0644\u0627 \u064a\u0631\u062a\u0628\u0637 \u0628\u0645\u0631\u0643\u0632 \u0627\u0644\u062c\u0646\u0627\u062d \u0641\u0642\u0637\u060c \u0641\u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a \u0643\u0627\u0646 \u0623\u062d\u062f \u0623\u0628\u0631\u0632 \u0645\u0635\u0627\u062f\u0631 \u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u0641\u0631\u0635 \u0648\u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u0641\u0631\u062f\u064a\u0629 \u0641\u064a \u0627\u0644\u062b\u0644\u062b \u0627\u0644\u0647\u062c\u0648\u0645\u064a\u060c\n\u0623\u0645 \u0623\u0646\u0647 \u0627\u0643\u062a\u0641\u0649 \u0628\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0627\u0644\u0623\u0633\u0645\u0627\u0621. \u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644\u064a \u062a\u0631\u064a\u0646\u0643\u0627\u0648\u060c \u0623\u062d\u062f \u0623\u0628\u0631\u0632 \u0627\u0644\u0648\u0627\u0641\u062f\u064a\u0646\u060c \u0644\u0645 \u064a\u0642\u062f\u0645 \u0623\u0645\u0627\u0645 \u0635\u0646 \u062f\u0627\u0648\u0646\u0632 \u0627\u0644\u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0647\u062c\u0648\u0645\u064a \u0627\u0644\u0645\u0646\u062a\u0638\u0631 \u0645\u0646\u0647\u060c \u0641\u064a\u0645\u0627 \u0648\u062c\u062f \u0627\u0644\u0623\u0648\u0643\u0631\u0627\u0646\u064a\n\u0625\u0644\u0649 \u062a\u063a\u064a\u064a\u0631 \u0625\u064a\u0642\u0627\u0639 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629\u060c \u062c\u0627\u0621\u062a \u0627\u0644\u062a\u0628\u062f\u064a\u0644\u0627\u062a \u0641\u064a \u062a\u0648\u0642\u064a\u062a \u0645\u062a\u0623\u062e\u0631 \u0648