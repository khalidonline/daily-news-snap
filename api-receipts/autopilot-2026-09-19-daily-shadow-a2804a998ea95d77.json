644\u0627\u0639\u0628 \u0628\u0634\u0639\u0631 \u0645\u062c\u0639\u0651\u062f \u0628\u0642\u0645\u064a\u0635 \u0623\u0633\u0648\u062f \u0623\u0645\u0627\u0645 \u0645\u0642\u0627\u0639\u062f \u0628\u0631\u062a\u0642\u0627\u0644\u064a\u0629. (\u0665) \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631: \u0642\u0635\u0627\u0635\u0629 \u0639\u0631\u0636\u064a\u0629 \u0645\u0646 \u0646\u0641\u0633 \u0635\u0648\u0631\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0639 \u0642\u0627\u0626\u0645\u0629 \u062d\u0642\u0648\u0642 \u0648\u0627\u0636\u062d\u0629 \u0648\u0645\u0642\u0631\u0648\u0621\u0629 \u0648\u0645\u0637\u0627\u0628\u0642\u0629 \u0644\u0644\u0635\u0648\u0631 \u0627\u0644\u0623\u0631\u0628\u0639.\n\n\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0631\u0641\u0636:\n\u0661) \u062f\u0642\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629: \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0635\u0644\u064a \u0644\u0627 \u064a\u0630\u0643\u0631 \u0625\u0637\u0644\u0627\u0642\u0627\u064b \u0623\u0646 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0643\u0627\u0646\u062a \u00ab\u0646\u0647\u0627\u0626\u064a\u0627\u064b\u00bb\u061b \u064a\u0642\u0648\u0644 \u00ab\u062f\u062e\u0644 \u0627\u0644\u0623\u0647\u0644\u064a \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u0637\u0645\u0648\u062d \u0645\u0648\u0627\u0635\u0644\u0629 \u0645\u0634\u0648\u0627\u0631\u0647 \u0641\u064a \u0643\u0623\u0633 \u0627\u0644\u0642\u0627\u0631\u0627\u062a \u0644\u0644\u0623\u0646\u062f\u064a\u0629... \u0628\u0639\u062f\u0645\u0627 \u062a\u062c\u0627\u0648\u0632 \u0623\u0648\u0643\u0644\u0627\u0646\u062f \u0625\u0641 \u0633\u064a \u0641\u064a \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u0633\u0627\u0628\u0642\u00bb\u060c \u0648\u062e\u0628\u0631 \u0627\u0644\u0645\u062f\u0631\u0628 \u064a\u0633\u0645\u064a\u0647\u0627 \u00ab\u0643\u0623\u0633 \u0623\u0641\u0631\u064a\u0642\u064a\u0627 \u0648\u0622\u0633\u064a\u0627 \u0648\u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u0647\u0627\u062f\u0626\u00bb. \u0648\u0645\u0639 \u0630\u0644\u0643 \u0639\u0646\u0648\u0627\u0646 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u064a\u0642\u0648\u0644 \u00ab\u0642\u0628\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0627\u0644\u0642\u0627\u0631\u064a\u00bb \u0648\u0628\u0637\u0627\u0642\u0629 \u0661 \u0645\u0646 \u0663 \u062a\u0642\u0648\u0644 \u00ab\u0627\u0644\u0623\u0647\u0644\u064a \u0648\u0635\u0644 \u0644\u0644\u0646\u0647\u0627\u0626\u064a\u00bb \u2014 \u0648\u0647\u0630\u0647 \u0625\u0636\u0627\u0641\u0629 \u063a\u064a\u0631 \u0645\u0648\u062b\u0642\u0629 \u064a\u062c\u0628 \u062d\u0630\u0641\u0647\u0627 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0648\u0635\u0641 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u062f\u0642\u064a\u0642 \u0644\u0644\u0628\u0637\u0648\u0644\u0629 \u0648\u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629.\n\u0662) \u062a\u0646\u0648\u0639 \u0627\u0644\u0635\u0648\u0631: \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0662 \u0648\u0663 \u0648\u0664 \u062b\u0644\u0627\u062b \u0644\u0642\u0637\u0627\u062a \u0628\u0648\u0631\u062a\u0631\u064a\u0647 \u0634\u0628\u0647 \u0645\u062a\u0637\u0627\u0628\u0642\u0629 (\u0646\u0641\u0633 \u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0648\u062c\u0647\u060c \u0646\u0641\u0633 \u0642\u0645\u064a\u0635 \u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0623\u0633\u0648\u062f\u060c \u062e\u0644\u0641\u064a\u0629 \u0645\u062f\u0631\u062c\u0627\u062a) \u0648\u062a\u0628\u062f\u0648 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0628\u0627\u062f\u0644\u060c \u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u062a\u0643\u0631\u0627\u0631 \u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u0634\u0643\u064a\u0644\u0629 \u0641\u064a \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631. \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0645\u0634\u0627\u0647\u062f \u0645\u062e\u062a\u0644\u0641\u0629 (\u0644\u0642\u0637\u0629 \u0645\u0644\u0639\u0628/\u0645\u062f\u0631\u062c\u0627\u062a/\u062c\u0645\u0627\u0647\u064a\u0631 \u0623\u0648 \u062a\u0642\u0644\u064a\u0644 \u0639\u062f\u062f \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a).\n\u0663) \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0663 \u0646\u0635\u0647\u0627 \u064a\u062f\u0648\u0631 \u062d\u0648\u0644 \u0631\u062d\u064a\u0644 \u0645\u062d\u0631\u0632 \u0648\u0623\u062f\u0627\u0621 \u062a\u0631\u064a\u0646\u0643\u0627\u0648 \u062a\u062d\u062f\u064a\u062f\u0627\u064b\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0635\u0648\u0631\u0629 \u0644\u0627\u0639\u0628 \u0645\u062f\u0627\u0641\u0639 \u0645\u062e\u062a\u0644\u0641 \u062a\u0645\u0627\u0645\u0627\u064b\u060c \u0645\u0627 \u0642\u062f \u064a\u0648\u0647\u0645 \u0627\u0644\u0642\u0627\u0631\u0626 \u0623\u0646 \u0627\u0644\u0634\u062e\u0635 \u0641\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u0647\u0648 \u0623\u062d\u062f \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646\u061b \u0625\u0645\u0627 \u0635\u0648\u0631\u0629 \u0645\u062d\u0627\u064a\u062f\u0629 \u063a\u064a\u0631 \u0634\u062e\u0635\u064a\u0629 \u0623\u0648 \u0635\u0648\u0631\u0629 \u0644\u0644\u0627\u0639\u0628 \u0627\u0644\u0645\u0642\u0635\u0648\u062f \u0641\u0639\u0644\u0627\u064b."}, {"event": "drafted", "at": "2026-09-19T20:20:06.654954+00:00"}, {"event": "repair_required", "at": "2026-09-19T20:20:29.012028+00:00", "feedback": "unknown_visual_selection: Merih Demiral portrait: \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u062a\u0646\u0627\u0633\u0628\u0647\u0627 \u0635\u0648\u0631\u0629 \u062a\u0634\u0643\u064a\u0644\u0629 \u0627\u0644\u0623\u0647\u0644\u064a \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629 (198256711) \u0644\u0623\u0646\u0647\u0627 \u062a\u0645\u062b\u0644 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0634\u0