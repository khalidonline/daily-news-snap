37\u0648\u0644 \u0637\u0631\u0642 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0648\u0639\u0644\u0649 \u0627\u0645\u062a\u062f\u0627\u062f \u0647\u0630\u0627 \u0627\u0644\u0637\u0631\u064a\u0642 \u062e\u064f\u0635\u0635\u062a \u0623\u0631\u0636 \u0644\u062c\u0627\u0645\u0639 \u064a\u062d\u0645\u0644 \u0627\u0633\u0645\u0647.", "punch": "\u0644\u0643\u0646 \u0642\u0635\u062a\u0647 \u0628\u062f\u0623\u062a \u0648\u0647\u0648 \u062e\u0627\u0631\u062c \u0627\u0644\u0631\u064a\u0627\u0636 \u0623\u0635\u0644\u0627\u064b.", "claim_ids": ["c8", "c1", "c2"], "image_query": "Ibn Saud portrait"}, {"kind": "story", "title": "\u0639\u0634\u0631 \u0633\u0646\u0648\u0627\u062a \u0641\u064a \u0627\u0644\u0643\u0648\u064a\u062a \u0628\u0639\u064a\u062f \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636", "body": "\u0628\u0639\u062f \u062e\u0631\u0648\u062c \u0622\u0644 \u0633\u0639\u0648\u062f \u0645\u0646 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0633\u0645\u062d\u062a \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a\u0629 \u0644\u0647\u0645 \u0628\u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0641\u064a \u0627\u0644\u0643\u0648\u064a\u062a\u060c \u0648\u0639\u0627\u0634\u0648\u0627 \u0641\u064a\u0647\u0627 \u0642\u0631\u0627\u0628\u0629 \u0639\u0634\u0631 \u0633\u0646\u0648\u0627\u062a. \u064a\u0639\u0646\u064a \u0646\u0634\u0623 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0641\u064a \u0645\u062f\u064a\u0646\u0629 \u062b\u0627\u0646\u064a\u0629\u060c \u0648\u0627\u0644\u0631\u064a\u0627\u0636 \u0627\u0644\u0644\u064a \u062a\u062d\u0643\u0645\u0647\u0627 \u0623\u0633\u0631\u0629 \u0622\u0644 \u0631\u0634\u064a\u062f \u0635\u0627\u0631\u062a \u0647\u062f\u0641 \u064a\u062d\u062a\u0627\u062c \u062e\u0637\u0629\u060c \u0645\u0648 \u0645\u062c\u0631\u062f \u0639\u0648\u062f\u0629.", "punch": "", "claim_ids": ["c3"], "image_query": "Ibn Saud portrait"}, {"kind": "story", "title": "\u0623\u0631\u0628\u0639\u064a\u0646 \u0631\u062c\u0644 \u0648\u062c\u0630\u0648\u0639 \u0646\u062e\u0644 \u0645\u0627\u0626\u0644\u0629", "body": "\u0641\u064a \u0644\u064a\u0644\u0629 15 \u064a\u0646\u0627\u064a\u0631 1902 \u0642\u0627\u062f \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0623\u0631\u0628\u0639\u064a\u0646 \u0631\u062c\u0644\u0627\u064b\u060c \u062a\u0633\u0644\u0642\u0648\u0627 \u0633\u0648\u0631 \u0627\u0644\u0631\u064a\u0627\u0636 \u0639\u0644\u0649 \u062c\u0630\u0648\u0639 \u0646\u062e\u0644 \u0645\u0627\u0626\u0644\u0629 \u0648\u062f\u062e\u0644\u0648\u0627 \u0627\u0644\u0645\u062f\u064a\u0646\u0629. \u0648\u0642\u064f\u062a\u0644 \u0639\u0627\u062c\u0644\u0627\u0646\u060c \u062d\u0627\u0643\u0645 \u0627\u0644\u0631\u064a\u0627\u0636 \u0645\u0646 \u0642\u0650\u0628\u0644 \u0622\u0644 \u0631\u0634\u064a\u062f\u060c \u0639\u0644\u0649 \u064a\u062f \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0628\u0646 \u062c\u0644\u0648\u064a \u0623\u0645\u0627\u0645 \u0642\u0635\u0631\u0647.", "punch": "\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0647\u0630\u064a \u0643\u0627\u0646\u062a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629.", "claim_ids": ["c4", "c5"], "image_query": "Ibn Saud portrait"}, {"kind": "story", "title": "\u0645\u0646 \u0645\u062f\u064a\u0646\u0629 \u0648\u0627\u062d\u062f\u0629 \u0625\u0644\u0649 \u0646\u062c\u062f \u0648\u0627\u0644\u062d\u062c\u0627\u0632", "body": "\u0628\u0639\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0631\u064a\u0627\u0636 \u0623\u0631\u0633\u0644 \u062d\u0627\u0643\u0645 \u0627\u0644\u0643\u0648\u064a\u062a \u0645\u0628\u0627\u0631\u0643 \u0627\u0644\u0635\u0628\u0627\u062d \u0633\u0628\u0639\u064a\u0646 \u0645\u0642\u0627\u062a\u0644\u0627\u064b \u0625\u0636\u0627\u0641\u064a\u0627\u064b \u0628\u0642\u064a\u0627\u062f\u0629 \u0633\u0639\u062f\u060c \u0627\u0644\u0623\u062e \u0627\u0644\u0623\u0635\u063a\u0631 \u0644\u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632. \u0648\u0645\u0646 \u0647\u0646\u0627\u0643 \u062a\u0648\u0633\u0651\u0639 \u062a\u062f\u0631\u064a\u062c\u064a\u0627\u064b \u062d\u062a\u0649 \u062b\u0628\u0651\u062a \u0633\u064a\u0637\u0631\u062a\u0647 \u0639\u0644\u0649 \u0646\u062c\u062f \u0633\u0646\u0629 1921\u060c \u062b\u0645 \u0636\u0645\u0651 \u0627\u0644\u062d\u062c\u0627\u0632 \u0633\u0646\u0629 1925.", "punch": "\u0648\u0627\u0644\u064a\u0648\u0645 \u064a\u064f\u0637\u0644\u0642 \u0627\u0633\u0645\u0647 \u0639\u0644\u0649 \u062c\u0627\u0645\u0639 \u0633\u064a\u064f\u0646\u0641\u0630 \u0634\u0645\u0627\u0644 \u0627\u0644\u0631\u064a\u0627\u0636 \u062a\u0631\u0633\u064a\u062e\u0627\u064b \u0644\u0625\u0631\u062b\u0647.", "claim_ids": ["c6", "c7", "c1", "c2"], "image_query": "Ibn Saud Roosevelt", "image_caption": "\u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0641\u064a \u0644\u0642\u0627\u0621 \u0633\u0646\u0629 1945"}]}}