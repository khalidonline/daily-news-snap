45\u062f\u0631\u0628 \u0628\u0642\u0627\u0621\u064b \u0641\u064a \u0645\u0646\u0635\u0628\u0647 \u0628\u0623\u0648\u0631\u0648\u0628\u0627. \u0641\u064a \u0632\u0645\u0646 \u0627\u0644\u0645\u062f\u0631\u0628\u064a\u0646 \u0627\u0644\u0644\u064a \u064a\u0637\u064a\u0631\u0648\u0646 \u0628\u0639\u062f \u0645\u0648\u0633\u0645 \u0648\u0627\u062d\u062f\u060c \u0647\u0630\u0627 \u0627\u0644\u062b\u0628\u0627\u062a \u0648\u062d\u062f\u0647 \u0642\u0635\u0629.", "punch": "\u0648\u0627\u0644\u0623\u062d\u062f \u064a\u0633\u062a\u0642\u0628\u0644 \u0639\u0644\u0649 \u0645\u0644\u0639\u0628\u0647 \u062e\u0635\u0645 \u0642\u062f\u064a\u0645 \u0645\u0627 \u0634\u0627\u0641\u0647 \u0645\u0646 \u0633\u0646\u064a\u0646: \u062c\u0648\u0632\u064a\u0647 \u0645\u0648\u0631\u064a\u0646\u064a\u0648.", "claim_ids": ["c6", "c1"], "image_query": "Atletico Madrid team"}, {"kind": "story", "title": "\u0628\u062f\u0623\u062a \u0627\u0644\u062e\u0635\u0648\u0645\u0629 \u0628\u06404-1 \u0648\u0627\u0646\u062a\u0647\u062a \u0628\u0643\u0623\u0633", "body": "\u0623\u0648\u0644 \u062f\u064a\u0631\u0628\u064a \u0628\u064a\u0646\u0647\u0645 \u0643\u0645\u062f\u0631\u0628\u064a\u0646 \u0643\u0627\u0646 \u0633\u0646\u0629 2012\u060c \u0644\u0645\u0627 \u0627\u0633\u062a\u0642\u0628\u0644 \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0641\u0631\u064a\u0642 \u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0648\u0642\u062a\u0647\u0627 \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f \u0641\u064a \u0645\u0644\u0639\u0628 \u0641\u064a\u0633\u0646\u062a\u064a \u0643\u0627\u0644\u062f\u064a\u0631\u0648\u0646\u060c \u0648\u062e\u0631\u062c \u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0628\u0641\u0648\u0632 4-1. \u0628\u0639\u062f\u0647\u0627 \u0628\u0633\u0646\u0629 \u0627\u0646\u0642\u0644\u0628\u062a \u0627\u0644\u0635\u0648\u0631\u0629: \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0641\u0627\u0632 \u0639\u0644\u0649 \u0631\u064a\u0627\u0644 2-1 \u0628\u0639\u062f \u0648\u0642\u062a \u0625\u0636\u0627\u0641\u064a \u0641\u064a \u0646\u0647\u0627\u0626\u064a \u0643\u0623\u0633 \u0645\u0644\u0643 \u0625\u0633\u0628\u0627\u0646\u064a\u0627 2013.", "punch": "\u0630\u0627\u0643 \u0627\u0644\u0641\u0648\u0632 \u0623\u0646\u0647\u0649 \u0627\u0646\u062a\u0638\u0627\u0631 14 \u0633\u0646\u0629 \u0628\u062f\u0648\u0646 \u0641\u0648\u0632 \u0644\u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0641\u064a \u0627\u0644\u062f\u064a\u0631\u0628\u064a.", "claim_ids": ["c3", "c5", "c4"], "image_query": "Real Madrid players"}, {"kind": "story", "title": "\u0622\u062e\u0631 \u0645\u0648\u0627\u062c\u0647\u0629 \u0643\u0627\u0646\u062a \u0641\u064a \u0644\u0646\u062f\u0646 \u0633\u0646\u0629 2014", "body": "\u0628\u0639\u062f \u0646\u0647\u0627\u0626\u064a \u0627\u0644\u0643\u0623\u0633 \u0627\u0641\u062a\u0631\u0642\u062a \u0627\u0644\u0637\u0631\u0642\u060c \u0648\u0622\u062e\u0631 \u0644\u0642\u0627\u0621 \u062c\u0645\u0639\u0647\u0645 \u0643\u0627\u0646 \u0633\u0646\u0629 2014 \u064a\u0648\u0645 \u0643\u0627\u0646 \u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0645\u062f\u0631\u0628 \u062a\u0634\u064a\u0644\u0633\u064a \u0648\u0623\u0642\u0635\u0627\u0647 \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0645\u0646 \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0623\u0648\u0631\u0648\u0628\u0627 \u0639\u0644\u0649 \u0633\u062a\u0627\u0645\u0641\u0648\u0631\u062f \u0628\u0631\u064a\u062f\u062c. \u0641\u064a \u0633\u062a \u0645\u0648\u0627\u062c\u0647\u0627\u062a \u0628\u064a\u0646\u0647\u0645\u060c \u0644\u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u062b\u0644\u0627\u062b\u0629 \u0627\u0646\u062a\u0635\u0627\u0631\u0627\u062a \u0648\u062a\u0639\u0627\u062f\u0644.", "punch": "\u0648\u0631\u063a\u0645 \u0643\u0644 \u0647\u0630\u0627\u060c \u0633\u064a\u0645\u064a\u0648\u0646\u064a \u064a\u0642\u0648\u0644 \u0625\u0646\u0647 \u0645\u0639\u062c\u0628 \u0628\u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0645\u0646 \u0632\u0645\u0627\u0646 \u0648\u064a\u0643\u0646\u0651 \u0644\u0647 \u0627\u062d\u062a\u0631\u0627\u0645 \u0643\u0628\u064a\u0631.", "claim_ids": ["c2", "c4", "c8"], "image_query": "Metropolitano stadium"}]}, "feedback": "unknown_visual_selection: Jose Mourinho portrait: \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649: \u0645\u0627 \u0641\u064a\u0647 \u0635\u0648\u0631\u0629 \u0644\u0633\u064a\u0645\u064a\u0648\u0646\u064a \u0646\u0641\u0633\u0647 (\u0643\u0644 \u0646\u062a\u0627\u0626\u062c \u00abSimeone\u00bb \u0644\u0648\u062d\u0627\u062a \u0648\u0645\u0628\u0627\u0646\u064d \u0625\u064a\u0637\u0627\u0644\u064a\u0629 \u0644\u0627 \u0639\u0644\u0627\u0642\u0629 \u0644\u0647\u0627)\u060c \u0641\u0627\u062e\u062a\u0631\u0646\u0627 \u0635\u0648\u0631\u0629 \u0641\u0631\u064a\u0642 \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0645\u062f\u0631\u064a\u062f \u0645\u0639 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0646\u0627\u062f\u064a \u0643\u062a\u0648\u0636\u064a\u062d \u0645\u062d\u0627\u064a\u062f \u0644\u0644\u0646\u0627\u062f\u064a \u0627\u0644\u0630\u064a \u064a\u062f\u0631\u0628\u0647. \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629: \u0644\u0627 \u062a\u0648\u062c\u062f \u0623\u064a \u0635\u0648\u0631\u0629 \u0644\u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0648\u0644\u0627 \u0644\u0645\u0644\u0639\u0628 \u0641\u064a\u0633\u0646\u062a\u064a \u0643\u0627\u0644\u062f\u064a\u0631\u0648\u0646\u060c \u0648\u0627\u0644\u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 (\u0645\u0637\u0627\u0639\u0645 \u0641\u064a \u0634\u0646\u062c\u0646 \u0623\u0648 \u0644\u0648\u062d\u0627\u062a) \u0645\u0636\u0644\u0644\u0629 \u062a\u0645\u0627\u0645\u064b\u0627\u060c \u0641\u0627\u0644\u0646\u062a\u064a\u062c\u0629 null. \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629: \u0635\u0648\u0631 \u00ab\u0643\u0623\u0633 \u0645\u0644\u0643 \u0625\u0633\u0628\u0627\u0646\u064a\u0627\u00bb \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u062a\u062e\u0635 \u0643\u0631\u0629 \u0627\u0644\u0645\u0627\u0621 2022 \u0648\u0647\u0648\u0643\u064a \u0627\u0644\u0632\u0644\u0627\u062c\u0627\u062a 2025 \u0648\u0641\u0631\u064a\u0642 \u0633\u064a\u0643\u0644\u064a\u0633\u062a\u0627 1909\u060c \u0648\u0643\u0644\u0647\u0627 \u0639\u0644\u0627\u0645\u0627\u062a \u0648\u0641\u0631\u0642 \u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0627 \u062a\u0635\u0644\u062d \u0644\u062a\u0645\u062b\u064a\u0644 \u0646\u0647\u0627\u0626\u064a 2013 \u0628\u064a\u0646 \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0648\u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f\u060c \u0641\u0627\u0644\u0646\u062a\u064a\u062c\u0629 null. \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0627\u0628\u0639\u0629: \u0635\u0648\u0631\u0629 \u0645\u0644\u0639\u0628 \u0627\u0644\u0645\u064a\u062a\u0631\u0648\u0628\u0648\u0644\u064a\u062a\u0627\u0646\u0648 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u062a\u0648\u0636\u064a\u062d \u0645\u062d\u0627\u064a\u062f \u0648\u0645\u0646\u0627\u0633\u0628 \u0644\u0645\u0644\u0639\u0628 \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0627\u0644\u0633\u064a\u0627\u0642\u060c \u0648\u0647\u064a \u0645\u062e\u062a\u0644\u0641\u0629 \u0628\u0635\u0631\u064a\u064b\u0627 \u0639\u0646 \u0635\u0648\u0631\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649."}