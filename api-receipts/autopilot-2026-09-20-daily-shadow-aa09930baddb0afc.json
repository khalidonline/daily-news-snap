{"version": 1, "engine": "aa09930baddb0afca882b48102df6ab4c8a65b3bbc5f05834fe7c8e84c29d924", "lane": "daily", "mode": "shadow", "status": "working", "started_at": "2026-09-20T08:11:05.676467+00:00", "expires_at": "2026-09-22T00:00:00+03:00", "audit": [{"event": "started", "at": "2026-09-20T08:11:05.676505+00:00"}, {"event": "selected", "at": "2026-09-20T08:11:44.993916+00:00"}, {"event": "candidate_rejected", "at": "2026-09-20T08:12:10.075318+00:00", "reason": "sensitive_or_uncertain_topic"}, {"event": "selected", "at": "2026-09-20T08:12:10.979359+00:00"}, {"event": "researched", "at": "2026-09-20T08:12:35.677337+00:00"}, {"event": "drafted", "at": "2026-09-20T08:12:55.236462+00:00"}, {"event": "repair_required", "at": "2026-09-20T08:14:01.343725+00:00", "feedback": "editorial_review_rejected: \u0627\u0644\u0646\u0635 \u0633\u0644\u064a\u0645 \u0645\u0642\u0627\u0628\u0644 \u0646\u0635 BBC \u0627\u0644\u0623\u0635\u0644\u064a: 42 \u0645\u0628\u0627\u0631\u0627\u0629 NFL \u0645\u0646\u0630 2007\u060c \u00abrabid\u00bb \u0645\u0646 \u0645\u0634\u062c\u0639\u0629 \u0643\u0627\u0646\u0633\u0627\u0633\u060c 15,000 \u0645\u0633\u0627\u0641\u0631 (9,000 ASU \u06486,000 \u0643\u0627\u0646\u0633\u0627\u0633)\u060c \u0627\u0644\u062a\u0627\u064a\u0644\u063a\u064a\u062a \u0627\u0644\u0633\u0627\u0639\u0629 10 \u0635\u0628\u0627\u062d\u0627\u064b \u0642\u0628\u0644 \u0633\u0628\u0639 \u0633\u0627\u0639\u0627\u062a\u060c 105 \u0644\u0627\u0639\u0628\u064a\u0646 \u064890% \u0628\u0644\u0627 \u062c\u0648\u0627\u0632 \u0633\u0641\u0631\u060c 46,523 \u0645\u0646 \u0623\u0635\u0644 \u062a\u062e\u0637\u064a\u0637 60 \u0623\u0644\u0641 \u0648\u0646\u0642\u0644 \u062d\u0627\u0645\u0644\u064a \u062a\u0630\u0627\u0643\u0631 \u0644\u0644\u0645\u062f\u0631\u062c \u0627\u0644\u0633\u0641\u0644\u064a\u060c \u0641\u0648\u0632 \u0623\u0631\u064a\u0632\u0648\u0646\u0627 \u0633\u062a\u064a\u062a 24-17\u060c \u0648\u0627\u0644\u0627\u062a\u0641\u0627\u0642\u064a\u0629 \u0627\u0644\u062d\u0635\u0631\u064a\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0633\u0646\u0648\u0627\u062a \u0645\u0639 \u0648\u064a\u0645\u0628\u0644\u064a \u0648\u0627\u0647\u062a\u0645\u0627\u0645 \u062c\u0627\u0645\u0639\u0627\u062a Big 12. \u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0633\u0644\u064a\u0645: \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0633\u0628\u062a \u0648\u0627\u0644\u062e\u0628\u0631 \u0645\u0646\u0634\u0648\u0631 20 \u0633\u0628\u062a\u0645\u0628\u0631 2026. \u0627\u0644\u062a\u0631\u0642\u064a\u0645 1 \u0645\u0646 3 \u06482 \u0645\u0646 3 \u06483 \u0645\u0646 3 \u0628\u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0635\u062d\u064a\u062d\u060c \u0648\u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0628\u0635\u0631\u064a\u0629 \u0648\u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0627\u0644\u0641\u0627\u062a\u062d\u0629 \u0633\u0644\u064a\u0645\u0629.\n\n\u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u0631:\n- \u0628\u0637\u0627\u0642\u0629 1: \u0644\u0642\u0637\u0629 \u0644\u064a\u0644\u064a\u0629 \u0648\u0627\u0633\u0639\u0629 \u0644\u0645\u0644\u0639\u0628 \u0648\u064a\u0645\u0628\u0644\u064a \u0628\u0623\u0631\u0636\u064a\u0629 \u0643\u0631\u0629 \u0642\u062f\u0645 (\u062f\u0627\u0626\u0631\u0629 \u0645\u0646\u062a\u0635\u0641) \u0648\u0645\u062f\u0631\u062c\u0627\u062a \u062d\u0645\u0631\u0627\u0621 \u0634\u0628\u0647 \u0641\u0627\u0631\u063a\u0629 \u2014 \u0645\u0642\u0628\u0648\u0644\u0629 \u0643\u0644\u0642\u0637\u0629 \u062a\u0639\u0631\u064a\u0641\u064a\u0629 \u0644\u0644\u0645\u0644\u0639\u0628.\n- \u0628\u0637\u0627\u0642\u0629 2: \u0648\u0627\u062c\u0647\u0629 \u0648\u064a\u0645\u0628\u0644\u064a \u0646\u0647\u0627\u0631\u0627\u064b \u0648\u062c\u0645\u0647\u0648\u0631 \u064a\u0635\u0639\u062f \u0627\u0644\u062f\u0631\u062c\u060c \u0644\u0643\u0646 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0627\u0644\u0644\u0627\u0641\u062a\u0627\u062a \u062a\u062d\u0645\u0644 \u0628\u0648\u0636\u0648\u062d \u0639\u0644\u0627\u0645\u0629 \u00abALL IN LONDON\u00bb (\u062d\u062f\u062b \u0645\u0635\u0627\u0631\u0639\u0629 AEW 2024). \u062d\u062f\u062b \u0645\u062e\u062a\u0644\u0641 \u062a\u0645\u0627\u0645\u0627\u064b \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u062a\u0648\u0636\u064a\u062d \u0648\u0635\u0648\u0644 15 \u0623\u0644\u0641 \u0645\u0634\u062c\u0639 \u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0643\u0648\u0631\u0629 \u0627\u0644\u062c\u0627\u0645\u0639\u064a\u0629 = \u062a\u0636\u0644\u064a\u0644. \u0627\u0633\u062a\u0628\u062f\u0644\u0647\u0627 \u0628\u0635\u0648\u0631\u0629 \u0639\u0627\u0645\u0629 \u0644\u0644\u0648\u0627\u062c\u0647\u0629 \u0628\u0644\u0627 \u0639\u0644\u0627\u0645\u0627\u062a \u062d\u062f\u062b \u0622\u062e\u0631.\n- \u0628\u0637\u0627\u0642\u0629 3: \u0635\u0648\u0631\u0629 \u0631\u0645\u0627\u062f\u064a\u0629 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u062d\u0628\u0628 (noise) \u0644\u0639\u062c\u0644\u0629 \u0644\u0646\u062f\u0646 \u0622\u064a\u0632 \u0648\u0623\u0628\u0631\u0627\u062c \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0645\u0639 \u0642\u0648\u0633 \u0648\u064a\u0645\u0628\u0644\u064a \u0628\u0627\u0644\u0643\u0627\u062f \u064a\u064f\u0645\u064a\u0651\u0632\u060c \u0628\u0644\u0627 \u0623\u064a \u0639\u0644\u0627\u0642\u0629 \u0628\u062d\u0641\u0644\u0627\u062a \u0627\u0644\u062a\u0627\u064a\u0644\u063a\u064a\u062a \u0648\u062c\u0648\u062f\u062a\u0647\u0627 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 \u0644\u0644\u0646\u0634\u0631.\n- \u0628\u0637\u0627\u0642\u0629 4: \u0645\u062f\u0631\u062c\u0627\u062a \u062d\u0645\u0631\u0627\u0621 \u0646\u0635\u0641 \u0645\u0645\u062a\u0644\u0626\u0629 \u0648\u0623\u0631\u0636\u064a\u0629 \u0641\u064a\u0647\u0627 \u0642\u0648\u0627\u0626\u0645 \u0645\u0631\u0645\u0649 \u0639\u0644\u0649 \u0634\u0643\u0644 H \u2014 \u0645\u0634\u0647\u062f \u0645\u0628\u0627\u0631\u0627\u0629 \u0631\u063a\u0628\u064a (\u0646\u0647\u0627\u0626\u064a \u062a\u0634\u0627\u0644\u0646\u062c \u0643\u0628) \u064a\u064f\u0639\u0631\u0636 \u062a\u062d\u062a \u0646\u0635 \u064a\u062a\u062d\u062f\u062b \u062a\u062d\u062f\u064a\u062f\u0627\u064b \u0639\u0646 \u062d\u0636\u0648\u0631 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u062c\u0627\u0645\u0639\u064a 46,523\u060c \u0641\u064a\u0642\u0631\u0623\u0647 \u0627\u0644\u0645\u062a\u0627\u0628\u0639 \u0643\u0623\u0646\u0647 \u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0646\u0641\u0633\u0647\u0627.\n\u0643\u0630\u0644\u0643 \u0628\u0637\u0627\u0642\u062a\u0627 1 \u06484 \u0644\u0642\u0637\u062a\u0627\u0646 \u0639\u0627\u0645\u062a\u0627\u0646 \u0645\u062a\u0634\u0627\u0628\u0647\u062a\u0627\u0646 \u0644\u0644\u0645\u062f\u0631\u062c\u0627\u062a \u0645\u0646 \u0623\u0639\u0644\u0649\u060c \u0641\u0627\u0644\u062a\u0646\u0648\u064a\u0639 \u0627\u0644\u0628\u0635\u0631\u064a \u0636\u0639\u064a\u0641. \u0627\u0644\u0645\u0637\u0644\u0648\u0628: \u0635\u0648\u0631 \u0645\u0648\u062b\u0642\u0629 \u0644\u0644\u062d\u062f\u062b \u0646\u0641\u0633\u0647 \u0623\u0648 \u0644\u0642\u0637\u0627\u062a \u0648\u064a\u0645\u0628\u0644\u064a \u0645\u062d\u0627\u064a\u062f\u0629 \u0648\u0645\u062a\u0645\u0627\u064a\u0632\u0629\u060c \u0623\u0648 \u062a\u0642\u0644\u064a\u0635 \u0639\u062f\u062f \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a."}, {"event": "repair_required", "at": "2026-09-20T08:14:30.294183+00:00", "feedback": "invalid_closing"}, {"event": "drafted", "at": "2026-09-20T08:14:58.721451+00:00"}, {"event": "repair_required", "at": "2026-09-20T08:15:15.592664+00:00", "feedback": "unknown_visual_selection: Wembley Stadium: \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062b\u0644\u0627\u062b \u0627\u0644\u0623\u0648\u0644\u0649 \u0623\u062e\u0630\u062a \u062b\u0644\u0627\u062b \u0635\u0648\u0631 \u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0645\u0644\u0639\u0628 \u0648\u064a\u0645\u0628\u0644\u064a (\u