633\u0629 \u0627\u0644\u062d\u0636\u0648\u0631\u064a\u0629 \u063a\u062f\u064b\u0627 \u0641\u064a \u0643\u0644\u064a\u0627\u062a\u0647\u0627 \u0628\u0645\u062f\u064a\u0646\u0629 \u0623\u0628\u0647\u0627 \u0648 \u0645\u062d\u0627\u0641\u0638\u0629 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u060c \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0648\u0627\u0631\u062f\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f. \u0648\u0623\u0648\u0636\u062d\u062a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0623\u0646 \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0633\u062a\u0633\u062a\u0645\u0631 \u0639\u0646 \u0628\u064f\u0639\u062f \u0639\u0628\u0631 \u0645\u0646\u0635\u0629 \"\u0627\u0644\u0628\u0644\u0627\u0643 \u0628\u0648\u0631\u062f\"\u060c \u062d\u0631\u0635\u064b\u0627 \u0639\u0644\u0649 \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0637\u0644\u0628\u0629 \u0648\u0645\u0646\u0633\u0648\u0628\u064a \u0648\u0645\u0646\u0633\u0648\u0628\u0627\u062a \u0627\u0644\u062c\u0627\u0645\u0639\u0629. #\u0625\u0639\u0644\u0627\u0646 #\u062c\u0627\u0645\u0639\u0629_\u0627\u0644\u0645\u0644\u0643_\u062e\u0627\u0644\u062f pic.twitter.com/Txb7vsL0uk \u2014 \u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u0645\u0644\u0643 \u062e\u0627\u0644\u062f (@kkueduksa) September 19, 2026", "published_at": "2026-09-19T22:56:00+03:00", "editorial": {"id": "168561e764d8a36a", "why_saudi": "\u064a\u062e\u0635 \u0637\u0644\u0627\u0628 \u0648\u0637\u0627\u0644\u0628\u0627\u062a \u062c\u0627\u0645\u0639\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0623\u0647\u0627\u0644\u064a\u0647\u0645 \u0641\u064a \u0623\u0628\u0647\u0627 \u0648\u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0627\u0644\u0644\u064a \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u064a\u0648\u0645\u064