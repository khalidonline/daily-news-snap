u0639\u0627\u0631\u0636 \u0648\u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a \u0628\u0645\u0644\u0647\u0645\u060c (\u0634\u0645\u0627\u0644 \u0627\u0644\u0639\u0627\u0635\u0645\u0629)\u060c \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629"}, "candidate": {"id": "f4fa6b2d075e7b94", "title": "\u0627\u0644\u0631\u064a\u0627\u0636 \u062a\u062d\u062a\u0641\u0644 \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0628\u0639\u0631\u0648\u0636 \u0639\u0633\u0643\u0631\u064a\u0629 \u0648\u0645\u0646\u0627\u0648\u0631\u0627\u062a \u062c\u0648\u064a\u0629", "url": "https://www.alyaum.com/articles/6683976/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D8%AA%D8%AD%D8%AA%D9%81%D9%84-%D8%A8%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D9%88%D8%B7%D9%86%D9%8A-%D8%A8%D8%B9%D8%B1%D9%88%D8%B6-%D8%B9%D8%B3%D9%83%D8%B1%D9%8A%D8%A9-%D9%88%D9%85%D9%86%D8%A7%D9%88%D8%B1%D8%A7%D8%AA-%D8%AC%D9%88%D9%8A%D8%A9", "summary": "\u0627\u062e\u062a\u062a\u0645\u062a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u0641\u064a \u0645\u0631\u0643\u0632 \u0627\u0644\u0631\u064a\u0627\u0636 \u0644\u0644\u0645\u0639\u0627\u0631\u0636 \u0648\u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a \u0628\u0645\u0644\u0647\u0645\u060c (\u0634\u0645\u0627\u0644 \u0627\u0644\u0639\u0627\u0635\u0645\u0629)\u060c \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0644\u0627\u062d\u062a\u0641\u0627\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u0628\u0639\u062f \u064a\u0648\u0645\u064a\u0646 \u0634\u0647\u062f\u0627 \u062d\u0636\u0648\u0631\u064b\u0627 \u062c\u0645\u0627\u0647\u064a\u0631\u064a\u064b\u0627 \u0643\u0628\u064a\u0631\u064b\u0627 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u062f\u0646\u064a\u0629\u060c \u0641\u064a \u0645\u0634\u0647\u062f \u0627\u062d\u062a\u0641\u0627\u0644\u064a \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0627\u0633\u062a\u0639\u0631\u0627\u0636\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0639\u0644\u0649 \u0623\u0631\u0636 \u0627\u0644\u0645\u0639\u0631\u0636. \u0648\u062a\u0648\u0627\u0641\u062f\u062a \u0623\u0639\u062f\u0627\u062f \u0643\u0628\u064a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0632\u0648\u0627\u0631 \u062d\u0627\u0645\u0644\u064a\u0646 \u0627\u0644\u0623\u0639\u0644\u0627\u0645 \u0648\u0635\u0648\u0631 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 -\u062d\u0641\u0638\u0647\u0627 \u0627\u0644\u0644\u0647- \u0625\u0644\u0649 \u0633\u0627\u062d\u0627\u062a \u0627\u0644\u0639\u0631\u0636 \u0645\u0646\u0630 \u0648\u0642\u062a \u0645\u0628\u0643\u0631\u060c \u062d\u064a\u062b \u0623\u062a\u064a\u062d\u062a \u0644\u0647\u0645 \u0641\u0631\u0635\u0629 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0646 \u0642\u0631\u0628 \u0639\u0644\u0649 \u0627\u0644\u0639\u0631\u0628\u0627\u062a \u0648\u0627\u0644\u0622\u0644\u064a\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629\u060c \u0648\u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647\u0627 \u0648\u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062a\u0630\u0643\u0627\u0631\u064a\u0629 \u0625\u0644\u0649 \u062c\u0627\u0646\u0628\u0647\u0627 \u0648\u0645\u0639 \u0631\u062c\u0627\u0644 \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0641\u064a \u0645\u0634\u0627\u0647\u062f \u0639\u0643\u0633\u062a \u0645\u0634\u0627\u0639\u0631 \u0627\u0644\u0641\u062e\u0631 \u0648\u0627\u0644\u0627\u0639\u062a\u0632\u0627\u0632. \u0648\u0627\u0646\u0637\u0644\u0642\u062a \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0628\u0639\u0632\u0641 \u0627\u0644\u0633\u0644\u0627\u0645 \u0627\u0644\u0645\u0644\u0643\u064a \u0645\u0646 \u0642\u0628\u0644 \u0643\u062a\u064a\u0628\u0629 \u062d\u0631\u0633 \u0627\u0644\u0634\u0631\u0641 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u0645\u0644\u0643\u064a\u060c \u0648\u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0646 \u0633\u0631\u064a\u0629 \u0627\u0644\u0641\u0631\u0633\u0627\u0646 \u0648\u0645\u0648\u0643\u0628 \u0636\u0645 \u0639\u062f\u062f\u064b\u0627 \u0645\u0646 \u0627\u0644\u0639\u0631\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0646\u0648\u0639\u0629. \u0639\u0631\u0636 \u0627\u0644\u0635\u0642\u0648\u0631 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u062a\u0648\u0627\u0644\u062a \u0627\u0644\u0627\u0633\u062a\u0639\u0631\u0627\u0636\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0631\u0648\u062d\u064a\u0627\u062a \u062a\u0627\u0628\u0639\u0629 \u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u0623\u0645\u0646\u060c \u0648\u0645\u0631\u0648\u062d\u064a\u0627\u062a \u0645\u0646 \u0646\u0648\u0639 \"\u0628\u0644\u0627\u0643 \u0647\u0648\u0643\" \u062a\u0627\u0628\u0639\u0629 \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u0648\u0637\u0646\u064a\u060c \u0648\u0637\u0627\u0626\u0631\u0627\u062a \u0645\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u0629 \u0648\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0646 \"\u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0644\u0637\u064a\u0631\u0627\u0646\" \u0628\u0645\u0631\u0648\u062d\u064a\u0629 \u0645\u0646 \u0637\u0631\u0627\u0632 \"\u0644\u064a\u0648\u0646\u0627\u0631\u062f\u0648\"\u060c \u0648\u0637\u0627\u0626\u0631\u0627\u062a \u0645\u0646 \u0646\u0627\u062f\u064a \u0627\u0644\u0637\u064a\u0631\u0627", "published_at": "2026-09-23T20:30:00+03:00", "editorial": {"id": "f4fa6b2d075e7b94", "evidence_format": "source-fields-v1", "subject_evidence": [{"subject": "UH-60 Black Hawk", "mention": "\u0645\u0631\u0648\u062d\u064a\u0627\u062a \u0645\u0646 \u0646\u0648\u0639 \"\u0628\u0644\u0627\u0643 \u0647\u0648\u0643\" \u062a\u0627\u0628\u0639\u0629 \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u0648\u0637\u0646\u064a", "quote": "\u0627\u062e\u062a\u062a\u0645\u062a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u0641\u064a \u0645\u0631\u0643\u0632 \u0627\u0644\u0631\u064a\u0627\u0636 \u0644\u0644\u0645\u0639\u0627\u0631\u0636 \u0648\u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a \u0628\u0645\u0644\u0647\u0645\u060c (\u0634\u0645\u0627\u0644 \u0627\u0644\u0639\u0627\u0635\u0645\u0629)\u060c \u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0644\u0627\u062d\u062a\u0641\u0627\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u0628\u0639\u062f \u064a\u0648\u0645\u064a\u0646 \u0634\u0647\u062f\u0627 \u062d\u0636\u0648\u0631\u064b\u0627 \u062c\u0645\u0627\u0647\u064a\u0631\u064a\u064b\u0627 \u0643\u0628\u064a\u0631\u064b\u0627 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u062f\u0646\