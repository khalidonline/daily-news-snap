u0644\u0642\u0631\u0628 \u0645\u0646\u0647\u0627.", "source_id": "article", "quote": "\u0627\u0644\u0625\u0632\u0639\u0627\u062c \u0623\u0648 \u0627\u0644\u0636\u0631\u0631. \u0648\u062a\u062d\u0638\u0631 \u0627\u0644\u0636\u0648\u0627\u0628\u0637 \u0625\u063a\u0627\u0638\u0629 \u0627\u0644\u0625\u0628\u0644 \u0623\u0648 \u062a\u0639\u0645\u062f \u0625\u0632\u0639\u0627\u062c\u0647\u0627\u060c \u0648\u062a\u062f\u0639\u0648 \u0625\u0644\u0649 \u0627\u062d\u062a\u0631\u0627\u0645 \u062e\u0635\u0648\u0635\u064a\u062a\u0647\u0627 \u0648\u062a\u0631\u0643 \u0645\u0633\u0627\u0641\u0629 \u0645\u0646\u0627\u0633\u0628\u0629 \u062d\u0648\u0644\u0647\u0627\u060c \u0645\u0639 \u0645\u0646\u0639 \u0631\u0641\u0639 \u0627\u0644\u0623\u0635\u0648\u0627\u062a", "passage_id": "article:p34"}, {"id": "c6", "fact": "\u0627\u0644\u0636\u0648\u0627\u0628\u0637 \u062a\u0637\u0631\u0642\u062a \u0644\u0645\u0624\u0634\u0631\u0627\u062a \u0623\u0633\u0639\u0627\u0631 \u0641\u0626\u0627\u062a \u0627\u0644\u0625\u0628\u0644\u060c \u0648\u0630\u0643\u0631\u062a \u0623\u0646 \u0633\u0639\u0631 \u0627\u0644\u062c\u0645\u0644 \u201d\u0639\u0631\u0646\u0648\u0646\u201c \u0642\u062f \u064a\u0635\u0644 \u0625\u0644\u0649 200 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0648\u0623\u0646 \u0623\u0633\u0639\u0627\u0631 \u0646\u0648\u0642 \u0627\u0644\u0645\u0632\u0627\u064a\u0646 \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0625\u0628\u0644 \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0628\u0623\u0636\u0639\u0627\u0641.", "source_id": "article", "quote": "\u0648\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0648\u0642\u064a\u0629\u060c \u0648\u0645\u0646 \u0630\u0644\u0643 \u0623\u0646 \u0633\u0639\u0631 \u0627\u0644\u062c\u0645\u0644 \u201d\u0639\u0631\u0646\u0648\u0646\u201c \u0642\u062f \u064a\u0635\u0644 \u0625\u0644\u0649 200 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0641\u064a\u0645\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 \u0623\u0633\u0639\u0627\u0631 \u0646\u0648\u0642 \u0627\u0644\u0645\u0632\u0627\u064a\u0646 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0625\u0628\u0644", "passage_id": "article:p16"}, {"id": "c7", "fact": "\u0627\u0644\u062c\u0645\u0644 \u0648\u062d\u064a\u062f \u0627\u0644\u0633\u0646\u0627\u0645 \u063a\u0627\u0644\u0628\u064b\u0627 \u062a\u0645 \u062a\u062f\u062c\u064a\u0646\u0647 \u0623\u0648\u0644 \u0645\u0631\u0629 \u0641\u064a \u0634\u0628\u0647 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0642\u0628\u0644 \u0646\u062d\u0648 4,000 \u0633\u0646\u0629.", "source_id": "wiki-326340", "quote": "probably first domesticated in the Arabian Peninsula about 4,000 years ago. In the wild, the dromedary inhabited arid regions, including the Sahara.", "passage_id": "wiki-326340:p10"}, {"id": "c8", "fact": "\u0639\u064f\u062b\u0631 \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u062c\u0646\u0648\u0628\u064a \u0644\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0639\u0644\u0649 \u0639\u0638\u0645 \u0641\u0643 \u0644\u062c\u0645\u0644 \u0648\u062d\u064a\u062f \u0627\u0644\u0633\u0646\u0627\u0645 \u064a\u0639\u0648\u062f \u0644\u0639\u0627\u0645 8,200 \u0642\u0628\u0644 \u0627\u0644\u0645\u064a\u0644\u0627\u062f.", "source_id": "wiki-326340", "quote": "studies have shown this to be false. A jawbone of a dromedary that dated from 8,200 BC was found in Saudi Arabia", "passage_id": "wiki-326340:p47"}], "event_source_id": "article", "event_quote": "\u0627\u0639\u062a\u0645\u062f\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u064a\u0626\u0629 \u0648\u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0627\u0644\u0632\u0631\u0627\u0639\u0629 \u060c \u0636\u0648\u0627\u0628\u0637 \u062a\u0646\u0638\u064a\u0645\u064a\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u062a\u0646\u0638\u064a\u0645 \u0639\u0645\u0644\u064a\u0627\u062a \u0628\u064a\u0639 \u0648\u0634\u0631\u0627\u0621 \u0648\u062a\u0623\u062c\u064a\u0631 \u0648\u0645\u0642\u0627\u064a\u0636\u0629 \u0627\u0644\u0625\u0628\u0644 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0645\u062a\u0636\u0645\u0646\u0629 \u0627\u0634\u062a\u0631\u0627\u0637\u0627\u062a \u062a\u0641\u0635\u064a\u0644\u064a\u0629 \u0644\u062d\u0641\u0638"}, "hook": {"options": [{"title": "\u062c\u0645\u0644 \u0648\u0627\u062d\u062f \u0627\u0633\u0645\u0647 \u0639\u0631\u0646\u0648\u0646 \u064a\u0635\u0644 \u0633\u0639\u0631\u0647 200 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644", "opening": "\u0627\u0644\u0636\u0648\u0627\u0628\u0637 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0644\u062a\u0646\u0638\u064a\u0645 \u0628\u064a\u0639 \u0627\u0644\u0625\u0628\u0644 \u0630\u0643\u0631\u062a \u0623\u0631\u0642\u0627\u0645 \u062a\u0641\u062a\u062d \u0627\u0644\u0646\u0641\u0633: \u0633\u0639\u0631 \u0627\u0644\u062c\u0645\u0644 \u201d\u0639\u0631\u0646\u0648\u0646\u201c \u0645\u0645\u0643\u0646 \u064a\u0648\u0635\u0644 200 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644.", "share_line": "\u062a\u062f\u0631\u064a \u0625\u0646 \u062c\u0645\u0644 \u0627\u0633\u0645\u0647 \u201d\u0639\u0631\u0646\u0648\u0646\u201c \u0633\u0639\u0631\u0647 \u064a\u0648\u0635\u0644 200 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u061f", "claim_ids": ["c1", "c6"]}, {"title": "\u0645\u0627 \u062a\u0642\u062f\u0631 \u062a\u0623\u062c\u0631 \u062c\u0645\u0644 \u0628\u062f\u0648\u0646 \u062a\u0648\u062b\u064a\u0642 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0628\u0639\u062f \u0627\u0644\u064a\u0648\u0645", "opening": "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u064a\u0626\u0629 \u0627\u0639\u062a\u0645\u062f\u062a \u0636\u0648\u0627\u0628\u0637 \u062c\u062f\u064a\u062f\u0629 \u062a\u0644\u0632\u0645 \u0628\u062a\u0648\u062b\u064a\u0642 \u0643\u0644 \u0639\u0642\u0648\u062f \u0625\u064a\u062c\u0627\u063