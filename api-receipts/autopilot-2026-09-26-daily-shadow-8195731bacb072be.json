2a\u0627\u062f\u0644\u0631\u00bb \u0627\u0644\u0633\u0648\u064a\u0633\u0631\u064a\u0629 \u0639\u0627\u0645 2024 \u0644\u0634\u0631\u0627\u0621 \u0648\u0635\u064a\u0627\u0646\u0629 10 \u0642\u0637\u0627\u0631\u0627\u062a \u0631\u0643\u0627\u0628 \u062d\u062f\u064a\u062b\u0629. \u0628\u0627\u0644\u0635\u0641\u0642\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u064a\u0631\u062a\u0641\u0639 \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0642\u0637\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0627\u0642\u062f \u0639\u0644\u064a\u0647\u0627 \u0645\u0639 \u0627\u0644\u0634\u0631\u0643\u0629 \u0625\u0644\u0649 20 \u0642\u0637\u0627\u0631\u064b\u0627\u060c \u0648\u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0633\u0639\u0629 \u0645\u0642\u0639\u062f\u064a\u0629 \u0623\u0643\u0628\u0631 \u0644\u0644\u0631\u0643\u0627\u0628.", "punch": "\u0642\u0637\u0627\u0631\u0627\u062a \u0623\u0643\u062b\u0631 \u0644\u0644\u0631\u0643\u0627\u0628\u060c \u0648\u0627\u0644\u0645\u0643\u0627\u0628\u062d \u0627\u0644\u0644\u064a \u062a\u0648\u0642\u0641\u0647\u0627 \u0647\u062f\u0641\u0647\u0627 \u062a\u0646\u0635\u0646\u0639 \u0639\u0646\u062f\u0646\u0627", "claim_ids": ["c5", "c6"], "image_query": "Stadler passenger train"}]}, "text_approval": {"input_sha256": "d50bc2e8ee1d2954ee433b708341818aad9fe729c4fec515f1406782da41189e", "review": {"checks": {"factual": true, "timely": true, "current_attention": true, "saudi_language": true, "broad_appeal": true, "story_coherent": true, "documented_story": true, "distinct_value": true, "owner_quality": true, "safe_routine": true}, "repair_indices": [], "reason": "Takeaway a viewer could retell: '\u0633\u0627\u0631' \u0648\u0642\u0639\u062a \u0627\u062a\u0641\u0627\u0642\u064a\u0627\u062a \u0641\u064a \u0645\u0639\u0631\u0636 \u0625\u0646\u0648\u062a\u0631\u0627\u0646\u0633 \u0628\u0628\u0631\u0644\u064a\u0646 \u062a\u0648\u0637\u0651\u0646 \u0641\u064a\u0647\u0627 \u0635\u0646\u0627\u0639\u0629 \u0642\u0637\u0639 \u0645\u0643\u0627\u0628\u062d \u0627\u0644\u0642\u0637\u0627\u0631\u0627\u062a \u062c\u0630\u0627\u062e\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0648\u0633\u0651\u0639\u062a \u0623\u0633\u0637\u0648\u0644 \u0642\u0637\u0627\u0631\u0627\u062a\u0647\u0627 \u0645\u0646 10 \u0625\u0644\u0649 20 \u0642\u0637\u0627\u0631 \u0631\u0643\u0627\u0628. Sourced arc: \u0628\u062f\u0627\u064a\u0629 \u0633\u0627\u0631 \u0643\u0634\u0631\u0643\u0629 \u0633\u0643\u0643 \u062d\u062f\u064a\u062f \u062a\u0623\u0633\u0633\u062a 2006 \u0644\u062e\u0637 \u0648\u0627\u062d\u062f (c1) -> \u062a\u063a\u064a\u0651\u0631 \u0628\u0627\u0644\u062f\u0645\u062c \u0645\u0639 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u062d\u062f\u064a\u062f\u064a\u0629 \u0641\u064a \u0641\u0628\u0631\u0627\u064a\u0631/\u0623\u0628\u0631\u064a\u0644 2021 \u0644\u062a\u0643\u0648\u064a\u0646 \u0645\u0634\u063a\u0644 \u0648\u0637\u0646\u064a \u0645\u0648\u062d\u062f (c2,c3) -> \u0646\u062a\u064a\u062c\u0629 \u062d\u0627\u0644\u064a\u0629: \u062a\u0648\u0633\u0639 \u0645\u0633\u062a\u0645\u0631 \u0628\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062c\u0633\u0631 \u0627\u0644\u0628\u0631\u064a (c4) \u0648\u0635\u0641\u0642\u0629 \u0633\u062a\u0627\u062f\u0644\u0631 \u062a\u0631\u0641\u0639 \u0627\u0644\u0642\u0637\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0627\u0642\u062f \u0639\u0644\u064a\u0647\u0627 \u0645\u0646 10 \u0625\u0644\u0649 20 (c5,c6)\u060c \u0625\u0636\u0627\u0641\u0629 \u0644\u0645\u0630\u0643\u0631\u062a\u064a \u062a\u0641\u0627\u0647\u0645 \u0644\u062a\u0648\u0637\u064a\u0646 \u062a\u0635\u0646\u064a\u0639 \u0645\u0643\u0648\u0646\u0627\u062a \u0627\u0644\u0645\u0643\u0627\u0628\u062d (c8) \u0648\u0647\u0648 \u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0645\u0645\u064a\u0632\u0629 \u0641\u064a \u0628\u0637\u0627\u0642\u0629 Info. \u0627\u0644\u0641\u0631\u0648\u0642\u0627\u062a \u0628\u064a\u0646 \u0628\u0637\u0627\u0642\u0629 Info (\u062a\u0648\u0637\u064a\u0646 \u062a\u0635\u0646\u064a\u0639 \u0627\u0644\u0645\u0643\u0627\u0628\u062d) \u0648\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0642\u0635\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 (\u062a\u0623\u0633\u064a\u0633 \u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u062a\u0627\u0631\u064a\u062e\u0647\u0627) \u0648\u0627\u0636\u062d\u0629 \u0648\u063a\u064a\u0631 \u0645\u062a\u0643\u0631\u0631\u0629. \u0643\u0644 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0628\u0623\u062d\u0631\u0641 \u063a\u0631\u0628\u064a\u0629\u060c \u0627\u0644\u0623\u0633\u0645\u0627\u0621 (\u0627\u0633\u062a\u0646\u0627\u062f\u060c Shenyang\u060c Knorr-Bremse\u060c \u0633\u062a\u0627\u062f\u0644\u0631) \u0645\u0630\u0643\u0648\u0631\u0629 \u0628\u0648\u0636\u0648\u062d \u0639\u0646\u062f \u0623\u0648\u0644 \u0630\u0643\u0631\u060c \u0648\u0644\u0627 \u064a\u0648\u062c\u062f \u0646\u0645\u0637 \u0639\u0646\u0648\u0627\u0646 X: \u0645\u0646...\u0625\u0644\u0649 \u0648\u0644\u0627 \u0631\u0645\u0648\u0632 \u0623\u0633\u0647\u0645. \u0627\u0644\u0644\u063a\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 \u064a\u0648\u0645\u064a\u0629 \u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0645\u0646\u0627\u0633\u0628\u0629."}}, "revision": 1}