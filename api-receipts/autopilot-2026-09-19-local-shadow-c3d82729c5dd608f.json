{"version": 1, "engine": "c3d82729c5dd608f3c038e238f71d373cb5c44e8f59eaf7891e533e5864afa80", "lane": "local", "mode": "shadow", "status": "working", "started_at": "2026-09-19T18:16:46.973462+00:00", "expires_at": "2026-09-21T00:00:00+03:00", "audit": [{"event": "started", "at": "2026-09-19T18:16:46.973486+00:00"}, {"event": "selected", "at": "2026-09-19T18:17:18.435856+00:00"}, {"event": "researched", "at": "2026-09-19T18:17:31.185662+00:00"}], "agent_receipts": [{"role": "editor", "model": "claude-sonnet-5", "response_id": "msg_011CfDFpKKgtR8Yx169qAo6X", "usage": {"input_tokens": 19406, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 0}, "output_tokens": 1822, "output_tokens_details": {"thinking_tokens": 1160}, "service_tier": "standard", "inference_geo": "global"}, "cost_micro_usd": 57032, "stop_reason": "end_turn", "content_types": ["thinking", "text"], "response_format": "plain"}, {"role": "researcher", "model": "claude-sonnet-5", "response_id": "msg_011CfDFrek3J9SSLnqxhxkyD", "usage": {"input_tokens": 6589, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 0}, "output_tokens": 646, "output_tokens_details": {"thinking_tokens": 0}, "service_tier": "standard", "inference_geo": "global"}, "cost_micro_usd": 19638, "stop_reason": "end_turn", "content_types": ["text"], "response_format": "plain", "research_shape": {"event_date": "2026-09-19", "event_passage_type": "str", "claim_count": 7}}], "candidate": {"id": "145adf38d8958e47", "title": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c", "url": "https://www.alyaum.com/articles/6683306/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%AF%D9%81%D8%A7%D8%B9-%D8%A7%D9%84%D9%85%D8%AF%D9%86%D9%8A-%D8%B2%D9%88%D8%A7%D9%84-%D8%A7%D9%84%D8%AE%D8%B7%D8%B1-%D8%B9%D9%86-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D9%88%D8%A7%D9%84%D8%AE%D8%B1%D8%AC", "summary": "\u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/Go3VPCZs0l \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026", "published_at": "2026-09-19T03:19:00+03:00", "editorial": {"id": "145adf38d8958e47", "why_saudi": "\u0646\u0627\u0633 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u062a\u0648\u0647\u0645 \u064a\u0630\u0643\u0631\u0648\u0646 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0644\u064a \u0648\u0635\u0644\u0647\u0645 \u0639\u0644\u0649 \u062c\u0648\u0627\u0644\u0627\u062a\u0647\u0645 \u0623\u0645\u0633 \u0628\u0633\u0628\u0628 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0648\u0627\u0644\u0633\u064a\u0648\u0644", "why_now": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0623\u0637\u0644\u0642 \u0625\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c \u0628\u0633\u0628\u0628 \u062d\u0627\u0644\u0629 \u0645\u0637\u0631\u064a\u0629\u060c \u0648\u0628\u0639\u062f\u0647\u0627 \u0623\u0639\u0644\u0646 \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u062e\u0644\u0627\u0644 \u0633\u0627\u0639\u0627\u062a", "angle": "\u0646\u062a\u0643\u0644\u0645 \u0639\u0646 \u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0627\u0644\u0644\u064a \u064a\u0631\u0633\u0644 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u062c\u0648\u0627\u0644 \u0648\u0642\u062a \u0627\u0644\u0623\u062e\u0637\u0627\u0631 \u0627\u0644\u062c\u0648\u064a\u0629\u060c \u0648\u0643\u064a\u0641 \u064a\u0634\u062a\u063a\u0644 \u0648\u0644\u0645\u064a\u0646 \u064a\u0648\u0635\u0644\u060c \u0648\u0644\u064a\u0647 \u0635\u0627\u0631 \u0627\u0644\u0646\u0627\u0633 \u064a\u0639\u062a\u0645\u062f\u0648\u0646 \u0639\u0644\u064a\u0647 \u0628\u062f\u0644 \u0645\u0627 \u064a\u0633\u062a\u0646\u0648\u0646 \u0646\u0634\u0631\u0629 \u0627\u0644\u0623\u0631\u0635\u0627\u062f", "share_reason": "\u0643\u0644 \u0634\u062e\u0635 \u0639\u0646\u062f\u0647 \u062c\u0648\u0627\u0644 \u0645\u0645\u0643\u0646 \u064a\u0648\u0635\u0644\u0647 \u0647\u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0641\u062c\u0623\u0629\u060c \u0641\u0645\u0639\u0631\u0641\u0629 \u0642\u0635\u062a\u0647 \u0648\u0645\u0635\u062f\u0631\u0647 \u0634\u064a \u064a\u0647\u0645 \u0627\u0644\u0643\u0644", "research_query": "Saudi National Early Warning Platform civil defense"}}, "sources": [{"id": "article", "url": "https://www.alyaum.com/articles/6683306/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%AF%D9%81%D8%A7%D8%B9-%D8%A7%D9%84%D9%85%D8%AF%D9%86%D9%8A-%D8%B2%D9%88%D8%A7%D9%84-%D8%A7%D9%84%D8%AE%D8%B7%D8%B1-%D8%B9%D9%86-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D9%88%D8%A7%D9%84%D8%AE%D8%B1%D8%AC", "text": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639\n\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629\n\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a\n\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0623\u062e\u0628\u0627\u0631 \u0645\u062a\u0639\u0644\u0642\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a\n\u064a\u0637\u0644\u0642 \u062a\u0646\u0628\u064a\u0647\u064b\u0627 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u064a\u062d\u0630\u0631.. \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062a\u0633\u062a\u0645\u0631 6 \u0623\u064a\u0627\u0645 \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629", "retrieved_text_sha256": "948aa33aabf1a84adc76bf7eac4755756ff37c636f3690d7a5c2098861dcf1f6"}], "research": {"event_date": "2026-09-19", "sensitive": false, "claims": [{"id": "c1", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0623\u0639\u0644\u0646 \u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c.", "source_id": "article", "quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639", "passage_id": "article:p9"}, {"id": "c2", "fact": "\u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0631\u0633\u0645\u064a \u062c\u0627\u0621 \u0628\u0635\u064a\u063a\u0629: \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0645\u0639 \u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a.", "source_id": "article", "quote": "\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (998). \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a #\u0627\u0644\u062f\u0641\u0627\u0639_\u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0641\u064a \u062d\u0627\u0644\u0629", "passage_id": "article:p12"}, {"id": "c3", "fact": "\u0646\u0641\u0633 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0635\u062f\u0631 \u0644\u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c \u0628\u0639\u062f \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646\u0647\u0627.", "source_id": "article", "quote": "\u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 (911). pic.twitter.com/PVZKK3iVyc \u2014 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a (@SaudiDCD) September 19, 2026 \u062a\u0646\u0628\u064a\u0647 \u0632\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u062e\u0631\u062c\u060c \u0644\u0633\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a", "passage_id": "article:p13"}, {"id": "c4", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062c\u0647 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0634\u0627\u0628\u0647\u0629 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0645\u062f\u0646 \u0623\u062e\u0631\u0649 \u0645\u062b\u0644 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0641\u062a\u0631\u0629.", "source_id": "article", "quote": "\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0648\u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0623\u062e\u0628\u0627\u0631 \u0645\u062a\u0639\u0644\u0642\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a: \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062c\u062f\u0629 \u0648\u064a\u0646\u0628\u0639 \u0648\u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u062c\u0627\u0632\u0627\u0646 \u0648\u0623\u0628\u0647\u0627 \u0648\u0627\u0644\u0639\u0644\u0627 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a", "passage_id": "article:p10"}, {"id": "c5", "fact": "\u0643\u0645\u0627 \u0635\u062f\u0631 \u062a\u0646\u0628\u064a\u0647 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637\u060c \u0648\u0633\u0637 \u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0645\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0628\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0627\u0644\u0631\u0639\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0645\u0646 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0644\u0645\u062f\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 6 \u0623\u064a\u0627\u0645.", "source_id": "article", "quote": "\u064a\u0637\u0644\u0642 \u062a\u0646\u0628\u064a\u0647\u064b\u0627 \u0628\u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u064a\u062d\u0630\u0631.. \u0623\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062a\u0633\u062a\u0645\u0631 6 \u0623\u064a\u0627\u0645 \u0648\u0623\u0641\u0627\u062f \u0628\u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629", "passage_id": "article:p11"}, {"id": "c6", "fact": "\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0634\u062f\u062f \u0641\u064a \u062a\u0646\u0628\u064a\u0647\u0627\u062a\u0647 \u0639\u0644\u0649 \u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u062c\u0645\u0647\u0631 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0646\u0647\u0627\u0626\u064a\u064b\u0627 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0637\u0631\u064a\u0629.", "source_id": "article", "quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639", "passage_id": "article:p9"}, {"id": "c7", "fact": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0630\u064a \u062d\u062f\u062f\u0647 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629 \u0647\u0648 998\u060c \u0628\u064a\u0646\u0645\u0627 \u0648\u0631\u062f \u0641\u064a \u0627\u0644\u062a\u063a\u0631\u064a\u062f\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0631\u0642\u0645 911 \u0644\u0644\u0637\u0648\u0627\u0631\u0626.", "source_id": "article", "quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0632\u0648\u0627\u0644 \u0627\u0644\u062e\u0637\u0631 \u0639\u0646 \u0627\u0644\u0631\u064a\u0627\u0636 \u0648\u0627\u0644\u062e\u0631\u062c . \u0648\u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639", "passage_id": "article:p9"}], "event_source_id": "article", "event_quote": "\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645 2026/09/19 03:19 \u0623\u0639\u0644\u0646 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0645\u062f\u0646\u064a \u060c \u0627\u0644\u064