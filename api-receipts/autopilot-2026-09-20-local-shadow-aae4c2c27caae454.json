644\u0643\u0646\u0647 \u062e\u0631\u062c \u062e\u0627\u0633\u0631\u0627\u064b 1-2 \u0623\u0645\u0627\u0645 \u0628\u0637\u0644 \u0623\u0641\u0631\u064a\u0642\u064a\u0627\u060c \u0641\u064a \u0645\u0628\u0627\u0631\u0627\u0629 \u0638\u0647\u0631 \u062e\u0644\u0627\u0644\u0647\u0627 \u0628\u0635\u0648\u0631\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u0645\u0627 \u0628\u064a\u0646 \u0634\u0648\u0637\u064a\u0647\u0627. \u0648\u0628\u062f\u0623 \u0627\u0644\u0641\u0631\u064a\u0642 \u0628\u0635\u0648\u0631\u0629", "passage_id": "article:p18"}, {"id": "c8", "fact": "\u0645\u0646\u0630 \u0645\u0634\u0627\u0631\u0643\u062a\u0647 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0641\u064a \u0643\u0623\u0633 \u0627\u0644\u0642\u0627\u0631\u0627\u062a \u062a\u063a\u064a\u0631\u062a \u0645\u0644\u0627\u0645\u062d \u0627\u0644\u0641\u0631\u064a\u0642: \u0631\u062d\u0644 \u0627\u0644\u0645\u062f\u0631\u0628 \u0645\u0627\u062a\u064a\u0627\u0633 \u064a\u0627\u064a\u0633\u0644\u0647\u060c \u0648\u063a\u0627\u062f\u0631 \u0631\u064a\u0627\u0636 \u0645\u062d\u0631\u0632 \u0648\u0641\u0631\u0627\u0646\u0643 \u0643\u064a\u0633\u064a\u0647\u060c \u0648\u062c\u0627\u0621 \u0627\u0644\u0647\u0648\u0644\u0646\u062f\u064a \u0628\u0648\u0634\u064a\u062a\u0634 \u0644\u0642\u064a\u0627\u062f\u0629 \u0645\u0634\u0631\u0648\u0639 \u062c\u062f\u064a\u062f.", "source_id": "article", "quote": "\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a \u0645\u0627\u062a\u064a\u0627\u0633 \u064a\u0627\u064a\u0633\u0644\u0647\u060c \u0643\u0645\u0627 \u063a\u0627\u062f\u0631 \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a \u0631\u064a\u0627\u0636 \u0645\u062d\u0631\u0632 \u0648\u0627\u0644\u0625\u064a\u0641\u0648\u0627\u0631\u064a \u0641\u0631\u0627\u0646\u0643 \u0643\u064a\u0633\u064a\u0647\u060c \u0648\u0647\u0645\u0627 \u0645\u0646 \u0623\u0628\u0631\u0632 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062a\u064a \u0627\u0631\u062a\u0628\u0637 \u0628\u0647\u0627 \u0627\u0644\u0641\u0631\u064a\u0642 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c", "passage_id": "article:p21"}], "event_source_id": "article", "event_quote": "(\u062a\u0635\u0648\u064a\u0631: \u0639\u0644\u064a \u062e\u0645\u062c) \u0623\u0628\u0647\u0627: \u0641\u064a\u0635\u0644 \u0627\u0644\u0645\u0641\u0636\u0644\u064a \u0646\u064f\u0634\u0631: 20:37-19 \u0633\u0628\u062a\u0645\u0628\u0631 2026 \u0645 \u0640 08 \u0631\u0628\u064a\u0639 \u0627\u0644\u062b\u0627\u0646\u064a 1448 \u0647\u0640 T T \u0623\u0628\u0647\u0627: \u0641\u064a\u0635\u0644 \u0627\u0644\u0645\u0641\u0636\u0644\u064a"}, "draft": {"title": "\u0627\u0644\u0623\u0647\u0644\u064a... \u0646\u0627\u062f\u064a \u062c\u062f\u0629 \u0627\u0644\u0644\u064a \u0645\u0627 \u0639\u0631\u0641 \u0627\u0644\u0647\u0628\u0648\u0637 84 \u0633\u0646\u0629", "cards": [{"kind": "info", "title": "\u0646\u0627\u062f\u064a \u0639\u0645\u0631\u0647 \u064a\u0642\u0627\u0631\u0628 90 \u0633\u0646\u0629 \u0648\u0645\u0642\u0631\u0647 \u062c\u062f\u0629", "body": "\u0627\u0644\u0623\u0647\u0644\u064a \u062a\u0623\u0633\u0633 \u0633\u0646\u0629 1937 \u0641\u064a \u062c\u062f\u0629\u060c \u0648\u064a\u064f\u0639\u062f \u0645\u0646 \u0623\u0646\u062c\u062d \u0627\u0644\u0623\u0646\u062f\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u064a\u0644\u0639\u0628 \u0641\u064a \u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0623\u0639\u0644\u0649 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u0643\u0631\u0629 \u0628\u0627\u0644\u0645\u0645\u0644\u0643\u0629. \u0648\u0647\u0648 \u0648\u0627\u062d\u062f \u0645\u0646 \u0623\u0631\u0628\u0639\u0629 \u0623\u0646\u062f\u064a\u0629 \u0623\u0633\u0633\u062a \u062f\u0648\u0631\u064a \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0645\u0639 \u0627\u0644\u0647\u0644\u0627\u0644 \u0648\u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0648\u0627\u0644\u0646\u0635\u0631.", "punch": "\u0646\u0627\u062f\u064a \u0645\u0646 \u062c\u064a\u0644 \u0627\u0644\u062a\u0623\u0633\u064a\u0633", "claim_ids": ["c1", "c2", "c4"], "image_query": "Al-Ahli footballer portrait"}, {"kind": "story", "title": "\u0623\u0648\u0644 \u0641\u0631\u064a\u0642 \u0633\u0639\u0648\u062f\u064a \u064a\u062c\u0645\u0639 \u0627\u0644\u062f\u0648\u0631\u064a \u0648\u0627\u0644\u0643\u0623\u0633 \u0641\u064a \u0645\u0648\u0633\u0645 \u0648\u0627\u062d\u062f", "body": "\u0627\u0644\u0623\u0647\u0644\u064a \u0633\u062c\u0644 \u0633\u0627\u0628\u0642\u0629 \u0645\u062d\u0644\u064a\u0629 \u0644\u0645\u0627 \u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u062f\u0648\u0631\u064a \u0648\u0643\u0623\u0633 \u0627\u0644\u0645\u0644\u0643 \u0641\u064a \u0645\u0648\u0633\u0645 \u0648\u0627\u062d\u062f \u0633\u0646\u0629 1978\u060c \u0648\u0643\u0631\u0631 \u0627\u0644\u0625\u0646\u062c\u0627\u0632 \u0646\u0641\u0633\u0647 \u0641\u064a 2016. \u0648\u0628\u064a\u0646 2014 \u06482016 \u0645\u0634\u0649 51 \u0645\u0628\u0627\u0631\u0627\u0629 \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u064a \u0628\u0644\u0627 \u062e\u0633\u0627\u0631\u0629\u060c \u0648\u0647\u0648 \u0631\u0642\u0645 \u0642\u064a\u0627\u0633\u064a \u0644\u062d\u062f \u0627\u0644\u0622\u0646.", "punch": "51 \u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u0644\u0627 \u0647\u0632\u064a\u0645\u0629", "claim_ids": ["c3", "c5"], "image_query": "Saudi league trophy"}, {"kind": "story", "title": "84 \u0633\u0646\u0629 \u0628\u062f\u0648\u0646 \u0647\u0628\u0648\u0637... \u0648\u0628\u0639\u062f\u064a\u0646 \u0635\u0627\u0631", "body": "\u0627\u0644\u0623\u0647\u0644\u064a \u0638\u0644 \u0641\u064a \u062f\u0648\u0631\u064a \u0627\u0644\u0623\u0636\u0648\u0627\u0621 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627 \u064a\u0647\u0628\u0637 \u0648\u0644\u0627 \u0645\u0631\u0629\u060c \u0625\u0644\u0649 \u0623\u0646 \u062c\u0627\u0621 \u0645\u0648\u0633\u0645 2021-2022 \u0648\u0646\u0632\u0644 \u0644\u0623\u0648\u0644 \u0645\u0631\u0629 \u0641\u064a \u062a\u0627\u0631\u064a\u062e\u0647. \u0627\u0644\u0635\u062f\u0645\u0629 \u0645\u0627 \u0637\u0648\u0644\u062a\u060c \u0648\u0631\u062c\u0639 \u0644\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632 \u0648\u064a\u0644\u0639\u0628 \u0627\u0644\u064a\u0648\u0645 \u0645\u0628\u0627\u0631\u064a\u0627\u062a\u0647 \u0639\u0644\u0649 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0629 \u0641\u064a \u062c\u062f\u0629.", "punch": "\u0646\u0632\u0644\u0629 \u0648\u062d\u062f\u0629 \u0641\u064a \u062a\u0627\u0631\u064a\u062e\u0647 \u0643\u0644\u0647", "claim_ids": ["c4", "c5", "c2"], "image_query": "Saudi football stadium"}, {"kind": "story", "title": "\u0645\u0646 \u0644\u0642\u0628\u064a\u0646 \u0622\u0633\u064a\u0648\u064a\u064a\u0646 \u0625\u0644\u0649 \u0645\u0648\u0627\u062c\u0647\u0629 \u0628\u0637\u0644 \u0623\u0641\u0631\u064a\u0642\u064a\u0627", "body": "\u062e\u0627\u0631\u062c\u064a\u0627\u064b \u0631\u0641\u0639 \u0627\u0644\u0623\u0647\u0644\u064a \u0643\u0623\u0633 \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0622\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629 \u0645\u0631\u062a\u064a\u0646\u060c \u0648\u0645\u0639\u0647\u0627 \u062b\u0644\u0627\u062b \u0628\u0637\u0648\u0644\u0627\u062a \u062e\u0644\u064a\u062c\u064a\u0629 \u0648\u0628\u0637\u0648\u0644\u0629 \u0639\u0631\u0628\u064a\u0629. \u0648\u0641\u064a \u0643\u0623\u0633 \u0627\u0644\u0642\u0627\u0631\u0627\u062a \u062a\u062c\u0627\u0648\u0632 \u0623\u0648\u0643\u0644\u0627\u0646\u062f \u062b\u0645 \u062e\u0633\u0631 1-2 \u0623\u0645\u0627\u0645 \u0645\u0627\u0645\u064a\u0644\u0648\u062f\u064a \u0635\u0646 \u062f\u0627\u0648\u0646\u0632 \u0628\u0637\u0644 \u0623\u0641\u0631\u064a\u0642\u064a\u0627\u060c \u0628\u0641\u0631\u064a\u0642 \u062a\u063a\u064a\u0631\u062a \u0645\u0644\u0627\u0645\u062d\u0647 \u0628\u0639\u062f \u0631\u062d\u064a\u0644 \u0627\u0644\u0645\u062f\u0631\u0628 \u064a\u0627\u0