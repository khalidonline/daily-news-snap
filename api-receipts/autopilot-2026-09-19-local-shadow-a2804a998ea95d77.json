5\u0627\u062c\u062f \u0623\u0628\u0648\u0632\u0627\u0647\u0631\u0629\u060c \u0623\u0646 \u064a\u0648\u0645 \u0627\u0644\u0641\u0644\u0643 \u0627\u0644\u062e\u0631\u064a\u0641\u064a \u0644\u0639\u0627\u0645 2026 \u064a\u0635\u0627\u062f\u0641 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a 19 \u0633\u0628\u062a\u0645\u0628\u0631\u060c \u0641\u064a \u0645\u0646\u0627\u0633\u0628\u0629 \u062a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0646\u0634\u0631 \u0627\u0644\u0648\u0639\u064a \u0628\u0639\u0644\u0645 \u0627\u0644\u0641\u0644\u0643 \u0648\u0627\u0644\u0641\u0636\u0627\u0621\u060c \u0648\u062a\u0634\u062c\u064a\u0639 \u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u0631\u0641 \u0625\u0644\u0649 \u0627\u0644\u0633\u0645\u0627\u0621 \u0648\u0645\u0627 \u062a\u0636\u0645\u0647 \u0645\u0646 \u0642\u0645\u0631 \u0648\u0643\u0648\u0627\u0643\u0628 \u0648\u0646\u062c\u0648\u0645 \u0648\u0623\u062c\u0631\u0627\u0645 \u0633\u0645\u0627\u0648\u064a\u0629. \u0648\u0623\u0648\u0636\u062d \u0623\u0646 \u064a\u0648\u0645 \u0627\u0644\u0641\u0644\u0643 \u064a\u0642\u0627\u0645 \u0641\u064a \u0645\u0646\u0627\u0633\u0628\u062a\u064a\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0639\u0627\u0645\u060c \u0631\u0628\u064a\u0639\u064a\u0629 \u0648\u062e\u0631\u064a\u0641\u064a\u0629\u060c \u0648\u064a\u0633\u062a\u0647\u062f\u0641 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u0627\u0644\u0641\u0644\u0643\u064a\u0629 \u0644\u062f\u0649 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u060c \u0648\u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0628\u0623\u0647\u0645\u064a\u0629 \u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0643\u0648\u0646 \u0648\u0641\u0647\u0645 \u0627\u0644\u0638\u0648\u0627\u0647\u0631 \u0627\u0644\u0641\u0644\u0643\u064a\u0629 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u062a\u0634\u062c\u064a\u0639 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0648\u0627\u0644\u0634\u0628\u0627\u0628 \u0639\u0644\u0649 \u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645 \u0628\u0639\u0644\u0648\u0645 \u0627\u0644\u0641\u0636\u0627\u0621 \u0648\u062a\u0646\u0645\u064a\u0629 \u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u0639\u0644\u0645\u064a \u0644\u062f\u064a\u0647\u0645. \u0648\u0623\u0634\u0627\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u062a\u062a\u064a\u062d \u0641\u0631\u0635\u0629 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u064a\u0646 \u0648\u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0645\u0646 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0623\u0639\u0645\u0627\u0631\u060c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u062d\u0627\u0636\u0631\u0627\u062a \u0648\u0627\u0644\u0646\u062f\u0648\u0627\u062a \u0648\u0648\u0631\u0634 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0627\u062a \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0648\u0627\u0644\u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u0639\u0645\u0644\u064a\u0629\u060c \u0628\u0645\u0627 \u064a\u0633\u0647\u0645 \u0641\u064a \u062a\u0642\u062f\u064a\u0645 \u0639\u0644\u0645 \u0627\u0644\u0641\u0644\u0643 \u0628\u0635\u0648\u0631\u0629 \u0623\u0643\u062b\u0631 \u0642\u0631\u0628\u064b\u0627 \u0648\u0633\u0647\u0648\u0644\u0629\u060c \u0648\u064a\u0641\u062a\u062d \u0627\u0644\u0645\u062c\u0627\u0644 \u0623\u0645\u0627\u0645 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646 \u0644\u0644\u062a\u0639\u0631\u0641 \u0625\u0644\u0649 \u0623\u062d\u062f\u062b \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641\u0627\u062a \u0648\u0627\u0644\u0628\u0639\u062b\u0627\u062a \u0648\u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0627\