a\u0644\u0627\u0641 \u0627\u0644\u0623\u0645\u0627\u0643\u0646. \u0648\u062a\u062a\u0645\u062b\u0644 \u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0641\u064a: \u0631\u064a\u0627\u062d \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u0633\u0631\u0639\u0629\u060c \u0648\u0627\u0646\u0639\u062f\u0627\u0645 \u0641\u064a \u0645\u062f\u0649 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0623\u0641\u0642\u064a\u0629\u060c \u0648\u062a\u0633\u0627\u0642\u0637 \u0627\u0644\u0628\u0631\u062f\u060c \u0648\u062c\u0631\u064a\u0627\u0646 \u0627\u0644\u0633\u064a\u0648\u0644\u060c \u0648\u0635\u0648\u0627\u0639\u0642 \u0631\u0639\u062f\u064a\u0629. \u0623\u0645\u0627\u0643\u0646 \u0647\u0637\u0648\u0644 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629: \u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u0623\u0636\u0645 \u0648\u0628\u0646\u064a \u064a\u0632\u064a\u062f \u0648\u062c\u0630\u0645 \u0648\u0645\u064a\u0633\u0627\u0646 \u0648\u064a\u0644\u0645\u0644\u0645 \u0639\u0633\u064a\u0631: \u0627\u0644\u062d\u0631\u062c\u0629 \u0648\u0627\u0644\u0631\u0628\u0648\u0639\u0629 \u0648\u0627\u0644\u0641\u0631\u0634\u0629 \u0648\u0633\u0631\u0627\u0629 \u0639\u0628\u064a\u062f\u0629 \u0648\u0638\u0647\u0631\u0627\u0646 \u0627\u0644\u062c\u0646\u0648\u0628 \u0648\u0627\u0644\u0645\u062c\u0627\u0631\u062f\u0629 \u0648\u0628\u0627\u0631\u0642 \u0648\u0631\u062c\u0627\u0644 \u0623\u0644\u0645\u0639 \u0648\u0645\u062d\u0627\u064a\u0644 \u0648\u0623\u0628\u0647\u0627 \u062c\u0627\u0632\u0627\u0646: \u0627\u0644\u062f\u0631\u0628 \u0648\u0628\u064a\u0634 \u0648\u0623\u062d\u062f \u0627\u0644\u0645\u0633\u0627\u0631\u062d\u0629 \u0648\u0627\u0644\u0637\u0648\u0627\u0644 \u0648\u0635\u0627\u0645\u0637\u0629 \u0648\u0623\u0628\u0648 \u0639\u0631\u064a\u0634 \u0648\u0627\u0644\u0641\u0637\u064a\u062d\u0629 \u0648\u0635\u0628\u064a\u0627 \u0648\u0636\u0645\u062f \u0648\u0627\u0644\u062d\u0631\u062b \u0648\u0627\u0644\u0639\u0627\u0631\u0636\u0629 \u0648\u0627\u0644\u0639\u064a\u062f\u0627\u0628\u064a \u0648\u0647\u0631\u0648\u0628 \u0648\u0627\u0644\u062f\u0627\u0626\u0631 \u0648\u0627\u0644\u0631\u064a\u062b \u0648\u0641\u064a\u0641\u0627. \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 - #\u0645\u0646\u0637\u0642\u0629_\u0645\u0643\u0629_\u0627\u0644\u0645\u0643\u0631\u0645\u0629 - #\u0623\u0636\u0645 #\u0628\u0646\u064a_\u064a\u0632\u064a\u062f #\u062c\u0630\u0645 ...+1 \u0644\u0644\u062a\u0641\u0627\u0635\u064a\u0644 https://t.co/yjzuyWVaB6 #\u0627\u0644\u0625\u0646\u0630\u0627\u0631_\u0627\u0644\u0645\u0628\u0643\u0631 #\u0637\u0642\u0633_\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 #\u0627\u0644\u0645\u0631\u0643\u0632_\u0627\u0644\u0648\u0637\u0646\u064a_\u0644\u0644\u0623\u0631\u0635\u0627\u062f pic.twitter.com/tjaMK5AM6V \u2014 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0622\u0644\u064a \u0644\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0628\u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f (@NCMAlert) September 22, 2026 \u0637\u0642\u0633 \u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u064a\u062a\u0648\u0642\u0639 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f \u0641\u064a \u062a\u0642\u0631\u064a\u0631\u0647 \u0639\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0647\u0637\u0648\u0644 \u0623\u0645\u0637\u0627", "published_at": "2026-09-23T03:55:00+03:00", "editorial": {"id": "36b883bb918d6674", "evidence_format": "source-fields-v1", "subject_evidence": [{"subject": "National Center of Meteorology (Saudi Arabia)", "mention": "\u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f", "quote": "\u0646\u0628\u0647 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f \u0641\u064a \u062a\u0642\u0631\u064a\u0631\u0647 \u0639\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0642\u0633 \u0628\u0640 \" \u0625\u0646\u0630\u0627\u0631 \u0623\u062d\u0645\u0631 \" \u0645\u0646 \u0623\u0645\u0637\u0627\u0631 \u063a\u0632\u064a\u0631\u0629 \u0639\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0645\u0646 3 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621. \u062a\u0628\u062f\u0623 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0627\u0644\u0633\u0627\u0639\u0629 12 \u0638\u0647\u0631\u064b\u0627\u060c \u0648\u062a\u0633\u062a\u0645\u0631 \u062d\u062a\u0649 \u0645\u0627 \u0628\u064a\u0646 8 \u064811 \u0645\u0633\u0627\u0621 \u0628\u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0623\u0645\u0627\u0643\u0646. \u0648\u062a\u062a\u0645\u062b\u0644 \u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0641\u064a: \u0631\u064a\u0627\u062d \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u0633\u0631\u0639\u0629\u060c \u0648\u0627\u0646\u0639\u062f\u0627\u0645 \u0641\u064a \u0645\u062f\u0649 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0623\u0641\u0642\u064a\u0629\u060c \u0648\u062a\u0633\u0627\u0642\u0637 \u0627\u0644\u0628\u0631\u062f\u060c \u0648\u062c\u0631\u064a\u0627\u0646 \u0627\u0644\u0633\u064a\u0648\u0644\u060c \u0648\u0635\u0648\u0627\u0639\u0642 \u0631\u0639\u062f\u064a\u0629. \u0623\u0645\u0627\u0643\u0646 \u0647\u0637\u0648\u0644 \u0627\u0644\u0623\u0645\u0637\u0627\u0631 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629: \u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u0623\u0636\u0645 \u0648\u0628\u0646\u064a \u064a\u0632\u064a\u062f \u0648\u062c\u0630\u0645 \u0648\u0645\u064a\u0633\u0627\u0646 \u0648\u064a\u0644\u0645\u0644\u0645 \u0639\u0633\u064a\u0631: \u0627\u0644\u062d\u0631\u062c\u0629 \u0648\u0627\u0644\u0631\u0628\u0648\u0639\u0629 \u0648\u0627\u0644\u0641\u0631\u0634\u0629 \u0648\u0633\u0631\u0627\u0629 \u0639\u0628\u064a\u062f\u0629 \u0648\u0638\u0647\u0631\u0627\u0646 \u0627\u0644\u062c\u0646\u0648\u0628 \u0648\u0627\u0644\u0645\u062c\u0627\u0631\u062f\u0629 \u0648\u0628\u0627\u0631\u0642 \u0648\u0631\u062c\u0627\u0644 \u0623\u0644\u0645\u0639 \u0648\u0645\u062d\u0627\u064a\u0644 \u0648\u0623\u0628\u0647\u0627 \u062c\u0627\u0632\u0627\u0646: \u0627\u0644\u062f\u0631\u0628 \u0648\u0628\u064a\u0634 \u0648\u0623\u062d\u062f \u0627\u0644\u0645\u0633\u0627\u0631\u062d\u0629 \u0648\u0627\u0644\u0637\u0648\u0627\u0644 \u0648\u0635\u0627\u0645\u0637\u0629 \u0648\u0623\u0628\u0648 \u0639\u0631\u064a\u0634 \u0648\u0627\u0644\u0641\u0637\u064a\u062d\u0629 \u0648\u0635\u0628\u064a\u0627 \u0648\u0636\u0645\u062f \u0648\u0627\u0644\u062d\u0631\u062b \u0648\u0627\u0644\u0639\u0627\u0631\u0636\u0629 \u0648\u0627\u0644\u0639\u064a\u062f\u0627\u0628\u064a \u0648\u0647\u0631\u0648\u0628 \u0648\u0627\u0644\u062f\u0627\u0626\u0631 \u0648\u0627\u0644\u0631\u064a\u062b \u0648\u0641\u064a\u0641\u0627. \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 - #\u0645\u0646\u0637\u0642\u0629_\u0645\u0643\u0629_\u0627\u0644\u0645\u0643\u0631\u0645\u0629 - #\u0623\u0636\u0645 #\u0628\u0646\u064a_\u064a\u0632\u064a\u062f #\u062c\u0630\u0645 ...+1 \u0644\u0644\u062a\u0641\u0627\u0635\u064a\u0644 https://t.co/yjzuyWVaB6 #\u0627\u0644\u0625\u0646\u0630\u0627\u0631_\u0627\u0644\u0645\u0628\u0643\u0631 #\u0637\u0642\u0633_\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 #\u0627\u0644\u0645\u0631\u0643\u0632_\u0627\u0644\u0648\u0637\u0646\u064a_\u0644\u0644\u0623\u0631\u0635\u0627\u062f pic.twitter.com/tjaMK5AM6V \u2014 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0622\u0644\u064a \u0644\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0628\u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f (@NCMAlert) September 22, 2026 \u0637\u0642\u0633 \u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u064a\u062a\u0648\u0642\u0639 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f \u0641\u064a \u062a\u0642\u0631\u064a\u0631\u0647 \u0639\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 \u0639\u0644\u0649 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0647\u0637\u0648\u0644 \u0623\u0645\u0637\u0627"}], "why_saudi": "\u0643\u0644 \u0623\u0647\u0644 \u0645\u0643\u0629 \u0648\u0639\u0633\u064a\u0631 \u0648\u062c\u0627\u0632\u0627\u0646 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u062a\u0646\u0628\u064a\u0647\u0627\u062a\u0647 \u0648\u0642\u062a \u0627\u0644\u0623\u0645\u0637\u0627\u0631\u060c \u0648\u0647\u0648 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0644\u064a \u062a\u062d\u062f\u062f \u0625\u0630\u0627 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0623\u0648 \u0627\u0644\u062f\u0627\u064a\u0631\u0629 \u062a\u0639\u0637\u0644 \u0628\u0633\u0628\u0628 \u0627\u0644\u0637\u0642\u0633.", "why_now": "\u0627\u0644\u0645\u0631\u0643\u0632 \u0631\u0641\u0639 \u0625\u0646\u0630\u0627\u0631 \u0623\u062d\u0645\u0631 \u064a\u0648\u0645 \u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621 23 \u0633\u0628\u062a\u0645\u0628\u0631 \u0644\u0623\u0645\u0637\u0627\u0631 \u063a\u0632\u064a\u0631\u0629 \u0648\u0633\u064a\u0648\u0644 \u0648\u0631\u064a\u0627\u062d \u0634\u062f\u064a\u062f\u0629 \u0641\u064a \u0627\u0644\u0637\u0627\u0626\u0641 \u0648\u0639\u0633\u064a\u0631 \u0648\u062c\u0627\u0632\u0627\u0646.", "angle": "\u0648\u064a\u0646 \u062a\u062c\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0644\u064a \u0646\u0634\u0648\u0641\u0647\u0627 \u0643\u0644 \u0645\u0627 \u062a\u062c\u064a \u0623\u0645\u0637\u0627\u0631 \u0623\u0648 \u0633\u064a\u0648\u0644\u060c \u0648\u0643\u064a\u0641 \u064a\u0642\u0631\u0631 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f \u064a\u0631\u0641\u0639 \u0625\u0646\u0630\u0627\u0631 \u0623\u062d\u0645\u0631 \u0628\u0627\u0644\u0636\u0628\u0637\u060c \u0648\u0634\u0644\u0648\u0646 \u064a\u0634\u062a\u063a\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u0627\u0644\u0644\u064a \u064a\u0648\u0635\u0644\u0646\u0627 \u0628\u0627\u0644\u062a\u0648\u064a\u062a\u0631 \u0648\u0627\u0644\u062c\u0648\u0627\u0644.", "share_reason": "\u0646\u0627\u0633 \u0643\u062b\u064a\u0631 \u064a\u0633\u0623\u0644\u0648\u0646 \u0644\u064a\u0634 \u064a\u0637\u0644\u0639\u0648\u0646 \u0625\u0646\u0630\u0627\u0631 \u0623\u062d\u0645\u0631 \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u062c\u0648 \u0639\u0627\u062f\u064a \u0639\u0646\u062f\u0647\u0645\u060c \u0648\u0647\u0630\u0627 \u064a\u0641\u0633\u0631 \u0634\u063a\u0644 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0644\u064a \u0648\u0631\u0627\u0621 \u0643\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a.", "research_query": "National Center of Meteorology Saudi Arabia", "source_title": "\u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0648\u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f.. \u0623\u0645\u0637\u0627\u0631 \u063a\u0632\u064a\u0631\u0629 \u0648\u0631\u064a\u0627\u062d \u0634\u062f\u064a\u062f\u0629 \u0639\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0645\u0646 3 \u0645\u0646\u0627\u0637\u0642", "subjects": ["National Center of Meteorology (Saudi Arabia)"]}, "subject_resolution": [{"query": "National Center of Meteorology (Saud