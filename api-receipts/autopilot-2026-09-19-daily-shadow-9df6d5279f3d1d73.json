062e\u0634\u0628 \u0648\u062d\u062f\u064a\u062f \u0642\u062f\u064a\u0645\u0629 \u0648\u062c\u062f\u0631\u0627\u0646 \u0645\u062a\u0642\u0634\u0631\u0629 \u0648\u0645\u0631\u0648\u062d\u0629 \u0633\u0642\u0641 \u2014 \u064a\u0628\u062f\u0648 \u0645\u062f\u0631\u0633\u0629 \u0642\u062f\u064a\u0645\u0629 \u062e\u0627\u0631\u062c \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0644\u0627 \u064a\u0645\u062a \u0628\u0635\u0644\u0629 \u0644\u062d\u0631\u0645 \u062c\u0627\u0645\u0639\u064a\u060c \u0648\u064a\u0648\u0647\u0645 \u0627\u0644\u0642\u0627\u0631\u0626 \u0628\u0623\u0646 \u0647\u0630\u0647 \u0645\u0631\u0627\u0641\u0642 \u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u0645\u0644\u0643 \u062e\u0627\u0644\u062f\u061b \u0627\u0644\u0623\u0646\u0633\u0628 \u0635\u0648\u0631\u0629 \u0645\u0628\u0646\u0649 \u062c\u0627\u0645\u0639\u064a \u0623\u0648 \u0642\u0627\u0639\u0629 \u062d\u062f\u064a\u062b\u0629. \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0662 \u063a\u064a\u0648\u0645 \u062f\u0627\u0643\u0646\u0629 \u0648\u0633\u062a\u0627\u0626\u0631 \u0645\u0637\u0631 \u0641\u0648\u0642 \u062c\u0628\u0627\u0644 \u0645\u0643\u0633\u0648\u0629 \u0628\u0627\u0644\u0623\u0634\u062c\u0627\u0631 \u2014 \u0625\u064a\u062d\u0627\u0621 \u0637\u0642\u0633 \u0645\u062d\u0627\u064a\u062f \u0648\u0645\u0642\u0628\u0648\u0644 \u0644\u0623\u0646\u0647 \u0644\u0627 \u064a\u062f\u0651\u0639\u064a \u0645\u0648\u0642\u0639\u064b\u0627 \u0633\u0639\u0648\u062f\u064a\u064b\u0627. \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0663 \u0643\u0648\u0645\u0629 \u0644\u0627\u0628\u062a\u0648\u0628\u0627\u062a \u0628\u0623\u0633\u0644\u0627\u0643 \u0641\u0648\u0642 \u0639\u0631\u0628\u0629 \u0641\u064a \u063a\u0631\u0641\u0629 \u0645\u062f\u0631\u0633\u064a\u0629 \u2014 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0644\u062a\u0639\u0644\u064a\u0645 \u0639\u0646 \u0628\u064f\u0639\u062f. \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0648\u0627\u0636\u062d\u0629 \u0648\u062a\u0646\u0633\u0628 \u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0637\u0631 (CC BY) \u0648\u0645\u0635\u062f\u0631 \u0627\u0644\u064a\u0648\u0645.\n\n\u0627\u0644\u0631\u0641\u0636:\n\u0661) distinct_value + feedback_respected: \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u0644\u0645 \u062a\u062a\u063a\u064a\u0631 \u062c\u0648\u0647\u0631\u064a\u064b\u0627 \u0639\u0646 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u0631\u0641\u0648\u0636\u0629 \u0633\u0627\u0628\u0642\u064b\u0627\u061b \u0645\u0627 \u0632\u0627\u0644\u062a \u062a\u0643\u0631\u0631 \u0645\u0627 \u0641\u064a \u0627\u0644\u062e\u0628\u0631 \u0646\u0641\u0633\u0647 (\u0645\u0642\u0631 \u0641\u064a \u0623\u0628\u0647\u0627 \u0648\u0643\u0644\u064a\u0627\u062a \u0641\u064a \u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637) \u0628\u062f\u0648\u0646 \u0623\u064a \u062d\u0642\u064a\u0642\u0629 \u0645\u0645\u064a\u0632\u0629 \u0645\u0648\u062b\u0642\u0629 \u0639\u0646 \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (\u0633\u0646\u0629 \u0627\u0644\u062a\u0623\u0633\u064a\u0633\u060c \u0639\u062f\u062f \u0627\u0644\u0643\u0644\u064a\u0627\u062a \u0623\u0648 \u0627\u0644\u0637\u0644\u0627\u0628\u060c \u0633\u0628\u0628 \u0627\u0644\u062a\u0633\u0645\u064a\u0629) \u0643\u0645\u0627 \u0637\u0644\u0628\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.\n\u0662) factual: \u0639\u0628\u0627\u0631\u0629 \"\u062c\u0627\u0645\u0639\u0629 \u062d\u0643\u0648\u0645\u064a\u0629 \u0645\u0642\u0631\u0647\u0627 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u064a \u0623\u0628\u0647\u0627\" \u0648\"\u062a\u0639\u062a\u0628\u0631 \u0645\u0646 \u0623\u0643\u0628\u0631 \u0627\u0644\u062c\u0627\u0645\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629\" \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0648\u062d\u064a\u062f (\u062e\u0628\u0631 \u0627\u0644\u064a\u0648\u0645) \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u0630\u0643\u0631 \u0633\u0648\u0649 \u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u062d\u0636\u0648\u0631 \u0641\u064a \u0643\u0644\u064a\u0627\u062a \u0623\u0628\u0647\u0627 \u0648\u062e\u0645\u064a\u0633 \u0645\u0634\u064a\u0637 \u0648\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0639\u0628\u0631 \u0627\u0644\u0628\u0644\u0627\u0643 \u0628\u0648\u0631\u062f. \u0623\u064a \u0645\u0639\u0644\u0648\u0645\u0629 \u062e\u0644\u0641\u064a\u0629 \u064a\u062c\u0628 \u0623\u0646 \u062a\u064f\u0633\u0646\u062f \u0644\u0645\u0635\u062f\u0631 \u0645\u0630\u0643\u0648\u0631.\n\u0663) story_numbering: \u0627\u0644\u0639\u062f\u0651\u0627\u062f \u0638\u0627\u0647\u0631 \u0628\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0644\u0627\u062a\u064a\u0646\u064a\u0629 \"1 \u0645\u0646 2\" \u0648\"2 \u0645\u0646 2\"\u060c \u0648\u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0623\u0631\u0642\u0627\u0645 \u0639\u0631\u0628\u064a\u0629 \"\u0661 \u0645\u0646 \u0662\" \u0648\"\u0662 \u0645\u0646 \u0662\".\n\n\u0627\u0644\u062a\u0648\u0642\u064a\u062a \u0633\u0644\u064a\u0645: \u0627\u0644\u062e\u0628\u0631 \u0628\u062a\u0627\u0631\u064a\u062e \u0662\u0660\u0662\u0666/\u0660\u0669/\u0661\u0669 \u0627\u0644\u0633\u0627\u0639\u0629 \u0662\u0662:\u0665\u0666 \u0648\u064a\u0646\u0635 \u0639\u0644\u0649 \u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u062d\u0636\u0648\u0631 \u063a\u062f\u064b\u0627 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0623\u0631\u0635\u0627\u062f\u060c \u0641\u0627\u0644\u062a\u0637\u0648\u0631 \u062d\u0627\u0644\u064a \u0648\u064a\u0647\u0645 \u0637\u0644\u0627\u0628 \u0648\u0623\u0648\u0644\u064a\u0627\u0621 \u0623\u0645\u0648\u0631 \u0627\u0644\u062c\u0646\u0648\u0628\u060c \u0648\u0644\u0627 \u062a\u0643\u0631\u0627\u0631 \u0644\u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u0646\u0639\u0627\u0645 \u0623\u0648 \u0627\u0644\u062a\u0645\u0631 \u0627\u0644\u0645\u0631\u0641\u0648\u0636\u0629.", "reason": "insufficient_subject_visuals_before_drafting"}