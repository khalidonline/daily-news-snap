    },
    "5": {
      "asset_hash": "d45cf443bddbbc45e8a583decfcf8283954891ba14a59b355b7da77b1f1bc491",
      "frame_payload": {
        "heading": "أطول مترو بلا سائق بالعالم",
        "image_keywords": [
          "Riyadh Metro",
          "Riyadh skyline",
          "مترو الرياض",
          "أفق الرياض",
          "Riyadh",
          "الرياض"
        ],
        "image_keywords_ar": [
          "مترو الرياض",
          "أفق الرياض"
        ],
        "punch": "",
        "subject_kind": "place_city",
        "text": "واليوم يسكن الرياض أكثر من 7 ملايين نسمة، وفق تعداد 2022. وفي ديسمبر 2024 افتتح مترو الرياض بطول 176 كيلومتراً عبر ست خطوط، ليصبح أطول شبكة قطارات ذاتية القيادة في العالم."
      },
      "image_source": "state/story_visuals/75502f37e3511459/77ffc1746e6afc9601d8cb3bbb9a4f77607bccbee1f17e03da38b02a206bfffb/assets/frame-05.jpg",
      "qa_reasons": [],
